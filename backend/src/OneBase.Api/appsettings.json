{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "onebase",
    "Audience": "onebase",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "onebase-files",
    "UseSsl": false
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334
  },
  "Llm": {
    "Provider": "",
    "ApiKey": "",
    "Model": "",
    "EmbeddingModel": ""
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Linko": {
    "PageSize": 1000,
    "Parallelism": 4,
    "TimeoutSeconds": 60,
    "MaxRetries": 4
  },
  "Sales": {
    "SoldStatuses": [ "delivered" ],
    "ReturnStatuses": [ "delivered" ],
    "DateField": "Created",
    "StaffPlanExcludeJobs": [ "Супервайзер", "Supervisor" ],
    "Sync": {
      "Enabled": true,
      "IntervalMinutes": 20,
      "BackfillMonths": 12
    },
    "Flags": {
      "MinVisits": 20,
      "ConversionCritical": 0.15,
      "ConversionCriticalOfMedian": 0.50,
      "ConversionRisk": 0.25,
      "ConversionRiskOfMedian": 0.70,
      "SumPerVisitRiskOfMedian": 0.40,
      "SmallCheckOfMedian": 0.60,
      "SmallCheckMinConversion": 0.25,
      "SmallCheckMinOrders": 20,
      "NarrowAssortmentCritical": 2,
      "TempoCritical": 0.75,
      "TempoRisk": 0.90
    }
  }
}
