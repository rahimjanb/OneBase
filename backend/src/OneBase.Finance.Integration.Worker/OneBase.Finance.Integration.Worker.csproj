<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Служба интеграции 1С:Бухгалтерия → OneBase. Отдельный процесс и отдельный Docker-сервис (onec-worker): читает 1С (только GET),
      проверяет и нормализует данные и отправляет пакеты во внутренний API OneBase. В PostgreSQL не пишет.
      AspNetCore.App — для хоста, HttpClientFactory, журнала и /health без внешних пакетов.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>OneBase.Finance.Integration.Worker</RootNamespace>
        <AssemblyName>OneBase.Finance.Integration.Worker</AssemblyName>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OneBase.Finance.Integration.Contracts\OneBase.Finance.Integration.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="OneBase.Finance.Tests" />
        <InternalsVisibleTo Include="OneBase.AI.Tests" />
        <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
