{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "OneC": {
    "Enabled": false,
    "Provider": "http",
    "TimeoutSeconds": 60
  },
  "Integration": {
    "IntervalMinutes": 30,
    "BatchSize": 500
  }
}
