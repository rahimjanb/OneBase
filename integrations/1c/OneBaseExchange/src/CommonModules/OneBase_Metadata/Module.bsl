// =====================================================================================================================
// OneBase_Metadata — поиск объектов и реквизитов конфигурации по спискам кандидатов из OneBase_Settings
// и метод GET /v1/metadata (что реально есть в конфигурации + как настройки сопоставились с ней).
//
// Свойства общего модуля: Сервер = Истина; Глобальный, Клиент, Внешнее соединение, Вызов сервера,
// Привилегированный = Ложь.
//
// Модуль читает только метаданные (объект Метаданные). Данные базы он не читает и не пишет.
// Описания объектов кэшируются на время одного HTTP-запроса в Контекст.Кэш.
// =====================================================================================================================

#Область ПоискМетаданных

// Строка кандидатов "Имя1, Имя2" → массив имён без пробелов, пустых и повторов.
Функция Кандидаты(СтрокаКандидатов) Экспорт

	Результат = Новый Массив;
	Если ТипЗнч(СтрокаКандидатов) <> Тип("Строка") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Часть Из СтрРазделить(СтрокаКандидатов, ",;", Ложь) Цикл
		Имя = СокрЛП(Часть);
		Если Имя <> "" И Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Первый объект коллекции метаданных (Метаданные.Справочники, Мета.Измерения и т.п.) из кандидатов; нет — Неопределено.
Функция НайтиОбъект(Коллекция, СтрокаКандидатов) Экспорт

	Для Каждого Имя Из Кандидаты(СтрокаКандидатов) Цикл
		Найденный = Коллекция.Найти(Имя);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Реквизит шапки объекта (обычный или стандартный) из кандидатов.
// Возвращает Структура(Имя, ЕстьСсылки, Стандартный) или Неопределено.
Функция НайтиРеквизит(Мета, СтрокаКандидатов) Экспорт

	Для Каждого Имя Из Кандидаты(СтрокаКандидатов) Цикл
		Реквизит = Неопределено;
		Попытка
			Реквизит = Мета.Реквизиты.Найти(Имя);
		Исключение
			Реквизит = Неопределено;
		КонецПопытки;
		Если Реквизит <> Неопределено Тогда
			Возврат Новый Структура("Имя, ЕстьСсылки, Стандартный", Реквизит.Имя, ЕстьСсылочныеТипы(Реквизит.Тип), Ложь);
		КонецЕсли;
		Если ЕстьСтандартныйРеквизит(Мета, Имя) Тогда
			ИмяН = НРег(Имя);
			ЕстьСсылки = (ИмяН = "родитель" ИЛИ ИмяН = "владелец");
			Возврат Новый Структура("Имя, ЕстьСсылки, Стандартный", Имя, ЕстьСсылки, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Колонка табличной части из кандидатов: Структура(Имя, ЕстьСсылки, Стандартный) или Неопределено.
Функция НайтиРеквизитТЧ(МетаТЧ, СтрокаКандидатов) Экспорт

	Для Каждого Имя Из Кандидаты(СтрокаКандидатов) Цикл
		Реквизит = МетаТЧ.Реквизиты.Найти(Имя);
		Если Реквизит <> Неопределено Тогда
			Возврат Новый Структура("Имя, ЕстьСсылки, Стандартный", Реквизит.Имя, ЕстьСсылочныеТипы(Реквизит.Тип), Ложь);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Есть ли у объекта стандартный реквизит (с учётом свойств: длина кода, иерархия, владельцы, проведение).
Функция ЕстьСтандартныйРеквизит(Мета, Имя) Экспорт

	ИмяН = НРег(Имя);
	Если ИмяН = "ссылка" ИЛИ ИмяН = "пометкаудаления" ИЛИ ИмяН = "версияданных" Тогда
		Возврат Истина;
	КонецЕсли;

	ВидОбъекта = Класс(Мета);
	Если ВидОбъекта = "Справочник" Тогда
		Если ИмяН = "код" Тогда
			Возврат Мета.ДлинаКода > 0;
		ИначеЕсли ИмяН = "наименование" Тогда
			Возврат Мета.ДлинаНаименования > 0;
		ИначеЕсли ИмяН = "родитель" Тогда
			Возврат Мета.Иерархический;
		ИначеЕсли ИмяН = "этогруппа" Тогда
			Возврат ЕстьГруппы(Мета);
		ИначеЕсли ИмяН = "владелец" Тогда
			Возврат Мета.Владельцы.Количество() > 0;
		ИначеЕсли ИмяН = "предопределенный" Тогда
			Возврат Истина;
		КонецЕсли;
	ИначеЕсли ВидОбъекта = "Документ" Тогда
		Если ИмяН = "дата" Тогда
			Возврат Истина;
		ИначеЕсли ИмяН = "номер" Тогда
			Возврат Мета.ДлинаНомера > 0;
		ИначеЕсли ИмяН = "проведен" Тогда
			Возврат ЕстьПроведение(Мета);
		КонецЕсли;
	ИначеЕсли ВидОбъекта = "ПланСчетов" Тогда
		Если ИмяН = "код" Тогда
			Возврат Мета.ДлинаКода > 0;
		ИначеЕсли ИмяН = "наименование" Тогда
			Возврат Мета.ДлинаНаименования > 0;
		ИначеЕсли ИмяН = "родитель" ИЛИ ИмяН = "вид" ИЛИ ИмяН = "забалансовый" ИЛИ ИмяН = "порядок"
			ИЛИ ИмяН = "предопределенный" Тогда
			Возврат Истина;
		КонецЕсли;
	ИначеЕсли ВидОбъекта = "ПланВидовХарактеристик" Тогда
		Если ИмяН = "код" Тогда
			Возврат Мета.ДлинаКода > 0;
		ИначеЕсли ИмяН = "наименование" Тогда
			Возврат Мета.ДлинаНаименования > 0;
		ИначеЕсли ИмяН = "родитель" ИЛИ ИмяН = "этогруппа" Тогда
			Возврат Мета.Иерархический;
		ИначеЕсли ИмяН = "предопределенный" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Вид объекта метаданных так, как он пишется в тексте запроса: "Справочник", "Документ", "ПланСчетов"…
// Определяется по коллекциям метаданных, не по строке имени. Не объект конфигурации — "".
Функция Класс(Мета) Экспорт

	Если Мета = Неопределено Тогда
		Возврат "";
	ИначеЕсли Метаданные.Справочники.Содержит(Мета) Тогда
		Возврат "Справочник";
	ИначеЕсли Метаданные.Документы.Содержит(Мета) Тогда
		Возврат "Документ";
	ИначеЕсли Метаданные.Перечисления.Содержит(Мета) Тогда
		Возврат "Перечисление";
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(Мета) Тогда
		Возврат "ПланСчетов";
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(Мета) Тогда
		Возврат "ПланВидовХарактеристик";
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(Мета) Тогда
		Возврат "ПланВидовРасчета";
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(Мета) Тогда
		Возврат "БизнесПроцесс";
	ИначеЕсли Метаданные.Задачи.Содержит(Мета) Тогда
		Возврат "Задача";
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(Мета) Тогда
		Возврат "РегистрБухгалтерии";
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(Мета) Тогда
		Возврат "РегистрСведений";
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(Мета) Тогда
		Возврат "РегистрНакопления";
	ИначеЕсли Метаданные.Константы.Содержит(Мета) Тогда
		Возврат "Константа";
	КонецЕсли;
	Возврат "";

КонецФункции

// Имя таблицы для текста запроса: "Справочник.Контрагенты".
Функция ИмяТаблицы(Мета) Экспорт
	Возврат Класс(Мета) + "." + Мета.Имя;
КонецФункции

// Менеджер объекта (для ПолучитьСсылку по UUID — ссылка строится в памяти, база не читается).
Функция Менеджер(Мета) Экспорт

	ВидОбъекта = Класс(Мета);
	Если ВидОбъекта = "Справочник" Тогда
		Возврат Справочники[Мета.Имя];
	ИначеЕсли ВидОбъекта = "Документ" Тогда
		Возврат Документы[Мета.Имя];
	ИначеЕсли ВидОбъекта = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Мета.Имя];
	ИначеЕсли ВидОбъекта = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Мета.Имя];
	ИначеЕсли ВидОбъекта = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Мета.Имя];
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Справочник с группами (иерархия групп и элементов).
Функция ЕстьГруппы(Мета) Экспорт
	Возврат Мета.Иерархический
		И Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
КонецФункции

// Документ, который можно проводить.
Функция ЕстьПроведение(Мета) Экспорт
	Возврат Мета.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить;
КонецФункции

// В описании типов есть ссылочные (не примитивные) типы — тогда в запросе нужно ПРЕДСТАВЛЕНИЕ().
Функция ЕстьСсылочныеТипы(ОписаниеТипов) Экспорт

	Для Каждого ТипРеквизита Из ОписаниеТипов.Типы() Цикл
		Если НЕ ЭтоПримитивныйТип(ТипРеквизита) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоПримитивныйТип(ТипЗначения) Экспорт
	Возврат ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("УникальныйИдентификатор")
		ИЛИ ТипЗначения = Тип("ХранилищеЗначения") ИЛИ ТипЗначения = Тип("ДвоичныеДанные");
КонецФункции

// Имя из списка персональных (OneBase_Settings.ПерсональныеВидыСубконто): без учёта регистра и пробелов.
Функция ЭтоПерсональноеИмя(Имя) Экспорт

	Если ТипЗнч(Имя) <> Тип("Строка") ИЛИ Имя = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Искомое = НРег(СтрЗаменить(Имя, " ", ""));
	Для Каждого Персональное Из Кандидаты(OneBase_Settings.ПерсональныеВидыСубконто()) Цикл
		Если НРег(СтрЗаменить(Персональное, " ", "")) = Искомое Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область ОписанияОбъектов

// Справочник метода (/organizations, /counterparties…): Код — имя метода.
// Структура: Код, Вид ("catalog"), Кандидаты, Найден, Мета, Имя, ПолноеИмя, ВыводитьИерархию, ЕстьРодитель, ЕстьГруппы,
// Персональный, Поля (разрешённые), Реквизиты (для attributes; у методов — пусто).
Функция Сущность(Контекст, Код) Экспорт

	Ключ = "Сущность." + Код;
	Результат = Контекст.Кэш.Получить(Ключ);
	Если Результат = Неопределено Тогда
		Настройка = OneBase_Settings.СправочникиМетодов().Получить(Код);
		Если Настройка = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат = ОписаниеСправочника(Код, "catalog", Настройка);
		Контекст.Кэш.Вставить(Ключ, Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Прочий справочник /references?kind=… Вид пишется через «_» или «-». Неизвестный вид — Неопределено.
Функция ПрочийСправочник(Контекст, Вид) Экспорт

	Код = СтрЗаменить(НРег(СокрЛП(Вид)), "-", "_");
	Ключ = "Прочий." + Код;
	Результат = Контекст.Кэш.Получить(Ключ);
	Если Результат = Неопределено Тогда
		Настройка = OneBase_Settings.ПрочиеСправочники().Получить(Код);
		Если Настройка = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат = ОписаниеСправочника(Код, "reference", Настройка);
		Контекст.Кэш.Вставить(Ключ, Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Регистр бухгалтерии: Найден, Поддерживается (есть корреспонденция и ресурс суммы), Мета, Имя, ПолноеИмя,
// ПланСчетов, ПолноеИмяПланаСчетов, МаксСубконто, ВидыСубконто (метаданные ПВХ или Неопределено), ПолноеИмяВидовСубконто,
// Организация, Валюта, Подразделение, Сумма, ВалютнаяСумма, Количество — Структура(Имя, Балансовый) или Неопределено,
// Содержание — имя реквизита или "", ПризнакВалютный, ПризнакКоличественный — имена признаков учёта или "".
Функция Регистр(Контекст) Экспорт

	Результат = Контекст.Кэш.Получить("Регистр");
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Настройки = OneBase_Settings.РегистрБухгалтерии();
	Мета = НайтиОбъект(Метаданные.РегистрыБухгалтерии, Настройки.Регистр);

	Результат = Новый Структура;
	Результат.Вставить("Кандидаты", Настройки.Регистр);
	Результат.Вставить("Найден", Мета <> Неопределено);
	Результат.Вставить("Поддерживается", Ложь);
	Результат.Вставить("Мета", Мета);
	Результат.Вставить("Имя", "");
	Результат.Вставить("ПолноеИмя", "");
	Результат.Вставить("Корреспонденция", Ложь);
	Результат.Вставить("ПланСчетов", Неопределено);
	Результат.Вставить("ПолноеИмяПланаСчетов", "");
	Результат.Вставить("МаксСубконто", 0);
	Результат.Вставить("ВидыСубконто", Неопределено);
	Результат.Вставить("ПолноеИмяВидовСубконто", "");
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("Валюта", Неопределено);
	Результат.Вставить("Подразделение", Неопределено);
	Результат.Вставить("Сумма", Неопределено);
	Результат.Вставить("ВалютнаяСумма", Неопределено);
	Результат.Вставить("Количество", Неопределено);
	Результат.Вставить("Содержание", "");
	Результат.Вставить("ПризнакВалютный", "");
	Результат.Вставить("ПризнакКоличественный", "");

	Если Мета <> Неопределено Тогда
		Результат.Имя = Мета.Имя;
		Результат.ПолноеИмя = "РегистрБухгалтерии." + Мета.Имя;
		Результат.Корреспонденция = Мета.Корреспонденция;
		Результат.ПланСчетов = Мета.ПланСчетов;
		Результат.ПолноеИмяПланаСчетов = "ПланСчетов." + Мета.ПланСчетов.Имя;
		Результат.МаксСубконто = Мета.ПланСчетов.МаксКоличествоСубконто;
		Результат.ВидыСубконто = Мета.ПланСчетов.ВидыСубконто;
		Если Результат.ВидыСубконто <> Неопределено Тогда
			Результат.ПолноеИмяВидовСубконто = "ПланВидовХарактеристик." + Результат.ВидыСубконто.Имя;
		КонецЕсли;
		Результат.Организация = ПолеРегистра(Мета.Измерения, Настройки.Организация);
		Результат.Валюта = ПолеРегистра(Мета.Измерения, Настройки.Валюта);
		Результат.Подразделение = ПолеРегистра(Мета.Измерения, Настройки.Подразделение);
		Результат.Сумма = ПолеРегистра(Мета.Ресурсы, Настройки.Сумма);
		Результат.ВалютнаяСумма = ПолеРегистра(Мета.Ресурсы, Настройки.ВалютнаяСумма);
		Результат.Количество = ПолеРегистра(Мета.Ресурсы, Настройки.Количество);
		Реквизит = НайтиОбъект(Мета.Реквизиты, Настройки.Содержание);
		Результат.Содержание = ?(Реквизит = Неопределено, "", Реквизит.Имя);
		Признак = НайтиОбъект(Мета.ПланСчетов.ПризнакиУчета, Настройки.ПризнакВалютный);
		Результат.ПризнакВалютный = ?(Признак = Неопределено, "", Признак.Имя);
		Признак = НайтиОбъект(Мета.ПланСчетов.ПризнакиУчета, Настройки.ПризнакКоличественный);
		Результат.ПризнакКоличественный = ?(Признак = Неопределено, "", Признак.Имя);
		Результат.Поддерживается = Результат.Корреспонденция И Результат.Сумма <> Неопределено;
	КонецЕсли;

	Контекст.Кэш.Вставить("Регистр", Результат);
	Возврат Результат;

КонецФункции

// Регистр сведений курсов валют: Найден, Мета, ПолноеИмя, Периодический, Валюта (имя измерения или ""),
// Курс, Кратность (имена ресурсов или ""), Источник (Структура(Имя, ЕстьСсылки) или Неопределено),
// ПрочиеИзмерения (массив имён — для устойчивого порядка строк).
Функция КурсыВалют(Контекст) Экспорт

	Результат = Контекст.Кэш.Получить("КурсыВалют");
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Настройки = OneBase_Settings.КурсыВалют();
	Мета = НайтиОбъект(Метаданные.РегистрыСведений, Настройки.Регистр);
	Результат = Новый Структура("Кандидаты, Найден, Мета, ПолноеИмя, Периодический, Валюта, Курс, Кратность, Источник, ПрочиеИзмерения",
		Настройки.Регистр, Мета <> Неопределено, Мета, "", Ложь, "", "", "", Неопределено, Новый Массив);

	Если Мета <> Неопределено Тогда
		Результат.ПолноеИмя = "РегистрСведений." + Мета.Имя;
		Результат.Периодический = Мета.ПериодичностьРегистраСведений
			<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
		Измерение = НайтиОбъект(Мета.Измерения, Настройки.Валюта);
		Результат.Валюта = ?(Измерение = Неопределено, "", Измерение.Имя);
		Ресурс = НайтиОбъект(Мета.Ресурсы, Настройки.Курс);
		Результат.Курс = ?(Ресурс = Неопределено, "", Ресурс.Имя);
		Ресурс = НайтиОбъект(Мета.Ресурсы, Настройки.Кратность);
		Результат.Кратность = ?(Ресурс = Неопределено, "", Ресурс.Имя);
		Источник = НайтиОбъект(Мета.Ресурсы, Настройки.Источник);
		Если Источник = Неопределено Тогда
			Источник = НайтиОбъект(Мета.Реквизиты, Настройки.Источник);
		КонецЕсли;
		Если Источник <> Неопределено Тогда
			Результат.Источник = Новый Структура("Имя, ЕстьСсылки", Источник.Имя, ЕстьСсылочныеТипы(Источник.Тип));
		КонецЕсли;
		Для Каждого Измерение Из Мета.Измерения Цикл
			Если Измерение.Имя <> Результат.Валюта Тогда
				Результат.ПрочиеИзмерения.Добавить(Измерение.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Контекст.Кэш.Вставить("КурсыВалют", Результат);
	Возврат Результат;

КонецФункции

// Все выгружаемые документы: сначала сопоставленные типам из настроек (в порядке настроек), затем прочие документы,
// которые пишут проводки в регистр бухгалтерии (тип "other", Прочий = Истина). Исключённые документы не входят.
// Описание: Имя, ПолноеИмя, Мета, Тип, Прочий, ЕстьПроведение, ЕстьНомер, Регистратор (пишет в регистр бухгалтерии),
// Поля, ПоляПоИмени (найденные), РеквизитОрганизации, РеквизитВалюты, ИсточникСуммыРегл, ТабличныеЧасти.
Функция ОписанияДокументов(Контекст) Экспорт

	Результат = Контекст.Кэш.Получить("Документы");
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	РегистрБух = Регистр(Контекст);
	Исключенные = Кандидаты(OneBase_Settings.ИсключенныеДокументы());
	Параметры = Новый Структура;
	Параметры.Вставить("Регистр", РегистрБух);
	Параметры.Вставить("ПоляШапки", OneBase_Settings.ПоляДокументов());
	Параметры.Вставить("Переопределения", OneBase_Settings.ПоляДокументовПоИмени());
	Параметры.Вставить("ТабличныеЧасти", OneBase_Settings.ТабличныеЧастиСтрок());
	Параметры.Вставить("ПоляСтрок", OneBase_Settings.ПоляСтрок());

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;

	Для Каждого ТипДокумента Из OneBase_Settings.ТипыДокументов() Цикл
		Для Каждого Имя Из Кандидаты(ТипДокумента.Документы) Цикл
			Если Добавленные.Получить(Имя) <> Неопределено ИЛИ Исключенные.Найти(Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			МетаДокумента = Метаданные.Документы.Найти(Имя);
			Если МетаДокумента = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(ОписаниеДокумента(МетаДокумента, ТипДокумента.Код, Ложь, Параметры));
			Добавленные.Вставить(МетаДокумента.Имя, Истина);
		КонецЦикла;
	КонецЦикла;

	Если РегистрБух.Найден Тогда
		Для Каждого МетаДокумента Из Метаданные.Документы Цикл
			Если Добавленные.Получить(МетаДокумента.Имя) <> Неопределено
				ИЛИ Исключенные.Найти(МетаДокумента.Имя) <> Неопределено
				ИЛИ НЕ МетаДокумента.Движения.Содержит(РегистрБух.Мета) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(ОписаниеДокумента(МетаДокумента, "other", Истина, Параметры));
			Добавленные.Вставить(МетаДокумента.Имя, Истина);
		КонецЦикла;
	КонецЕсли;

	Контекст.Кэш.Вставить("Документы", Результат);
	Возврат Результат;

КонецФункции

// Исключённые документы, которые пишут проводки в регистр, — полные имена (для итогов /entries).
Функция ИсключенныеРегистраторы(Контекст) Экспорт

	Результат = Новый Массив;
	РегистрБух = Регистр(Контекст);
	Если НЕ РегистрБух.Найден Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Имя Из Кандидаты(OneBase_Settings.ИсключенныеДокументы()) Цикл
		МетаДокумента = Метаданные.Документы.Найти(Имя);
		Если МетаДокумента <> Неопределено И МетаДокумента.Движения.Содержит(РегистрБух.Мета) Тогда
			Результат.Добавить("Документ." + МетаДокумента.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Коды типов документов (из настроек и "other") — для проверки параметра type.
Функция КодыТиповДокументов() Экспорт

	Результат = Новый Массив;
	Для Каждого ТипДокумента Из OneBase_Settings.ТипыДокументов() Цикл
		Если Результат.Найти(ТипДокумента.Код) = Неопределено Тогда
			Результат.Добавить(ТипДокумента.Код);
		КонецЕсли;
	КонецЦикла;
	Результат.Добавить("other");
	Возврат Результат;

КонецФункции

// Найденное поле по имени OneBase или Неопределено.
Функция НайденноеПоле(Поля, Имя) Экспорт

	Для Каждого Поле Из Поля Цикл
		Если Поле.Имя = Имя И Поле.Найден Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область МетодMetadata

// GET /v1/metadata — что есть в конфигурации и как с ней сопоставились настройки.
//   без параметров            — конфигурация, раздел mapping, списки объектов по коллекциям (имя, синоним);
//   ?section=documents         — только этот раздел (catalogs, documents, accountingRegisters, chartsOfAccounts,
//                                informationRegisters, chartsOfCharacteristicTypes, constants, enums, mapping, all);
//   ?section=…&details=true   — с реквизитами, табличными частями, измерениями и ресурсами (большой ответ);
//   ?object=Документ.Имя      — подробное описание одного объекта.
Процедура ВыгрузитьМетаданные(Контекст, Запись) Экспорт

	ИмяОбъекта = ЗначениеПараметра(Контекст, "object");
	Раздел = НРег(ЗначениеПараметра(Контекст, "section"));
	Подробно = НРег(ЗначениеПараметра(Контекст, "details")) = "true" ИЛИ ЗначениеПараметра(Контекст, "details") = "1";
	
	Запись.ЗаписатьНачалоОбъекта();
	OneBase_Json.Свойство(Запись, "apiVersion", OneBase_Settings.ВерсияAPI());
	
	Если ИмяОбъекта <> "" Тогда
		Мета = Неопределено;
		Попытка
			Мета = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
		Исключение
			Мета = Неопределено;
		КонецПопытки;
		Если Мета = Неопределено Тогда
			OneBase_Json.ВызватьОшибкуAPI(404, "not_found",
				"Объект метаданных не найден. Пример: object=Документ.РеализацияТоваровУслуг", "object");
		КонецЕсли;
		OneBase_Json.НачатьОбъект(Запись, "object");
		ЗаписатьОписаниеОбъекта(Запись, Мета, Истина);
		Запись.ЗаписатьКонецОбъекта();
		Запись.ЗаписатьКонецОбъекта();
		Возврат;
	КонецЕсли;

	Разделы = СтрРазделить("mapping,catalogs,documents,accountingregisters,chartsofaccounts,informationregisters,"
		+ "chartsofcharacteristictypes,constants,enums,all", ",", Ложь);
	Если Раздел <> "" И Разделы.Найти(Раздел) = Неопределено Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter",
			"Параметр section: допустимо " + СтрСоединить(Разделы, ", "), "section");
	КонецЕсли;

	OneBase_Json.НачатьОбъект(Запись, "configuration");
	OneBase_Json.Свойство(Запись, "name", Метаданные.Имя);
	OneBase_Json.Свойство(Запись, "synonym", Строка(Метаданные.Синоним));
	OneBase_Json.Свойство(Запись, "version", Метаданные.Версия);
	OneBase_Json.Свойство(Запись, "compatibilityMode", Строка(Метаданные.РежимСовместимости));
	ВерсияПлатформы = Неопределено;
	Попытка
		Информация = Новый СистемнаяИнформация;
		ВерсияПлатформы = Информация.ВерсияПриложения;
	Исключение
		ВерсияПлатформы = Неопределено;
	КонецПопытки;
	OneBase_Json.Свойство(Запись, "platform", ВерсияПлатформы);
	Запись.ЗаписатьКонецОбъекта();

	Все = (Раздел = "" ИЛИ Раздел = "all");
	ПодробноРаздела = Подробно И Раздел <> "";

	Если Все ИЛИ Раздел = "mapping" Тогда
		ЗаписатьСопоставление(Контекст, Запись);
	КонецЕсли;
	Если Все ИЛИ Раздел = "catalogs" Тогда
		ЗаписатьКоллекцию(Контекст, Запись, "catalogs", Метаданные.Справочники, ПодробноРаздела);
	КонецЕсли;
	Если Все ИЛИ Раздел = "documents" Тогда
		ЗаписатьКоллекцию(Контекст, Запись, "documents", Метаданные.Документы, ПодробноРаздела);
	КонецЕсли;
	Если Все ИЛИ Раздел = "accountingregisters" Тогда
		ЗаписатьКоллекцию(Контекст, Запись, "accountingRegisters", Метаданные.РегистрыБухгалтерии, ПодробноРаздела);
	КонецЕсли;
	Если Все ИЛИ Раздел = "chartsofaccounts" Тогда
		ЗаписатьКоллекцию(Контекст, Запись, "chartsOfAccounts", Метаданные.ПланыСчетов, ПодробноРаздела);
	КонецЕсли;
	Если Все ИЛИ Раздел = "informationregisters" Тогда
		ЗаписатьКоллекцию(Контекст, Запись, "informationRegisters", Метаданные.РегистрыСведений, ПодробноРаздела);
	КонецЕсли;
	Если Все ИЛИ Раздел = "chartsofcharacteristictypes" Тогда
		ЗаписатьКоллекцию(Контекст, Запись, "chartsOfCharacteristicTypes", Метаданные.ПланыВидовХарактеристик, ПодробноРаздела);
	КонецЕсли;
	Если Все ИЛИ Раздел = "constants" Тогда
		ЗаписатьКоллекцию(Контекст, Запись, "constants", Метаданные.Константы, ПодробноРаздела);
	КонецЕсли;
	Если Все ИЛИ Раздел = "enums" Тогда
		ЗаписатьКоллекцию(Контекст, Запись, "enums", Метаданные.Перечисления, ПодробноРаздела);
	КонецЕсли;

	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметр запроса строкой без пробелов по краям; нет параметра — "".
Функция ЗначениеПараметра(Контекст, Имя)

	Значение = Контекст.Параметры.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), СокрЛП(Значение), "");

КонецФункции

Функция ОписаниеСправочника(Код, Вид, Настройка)

	Мета = НайтиОбъект(Метаданные.Справочники, Настройка.Справочник);

	Результат = Новый Структура;
	Результат.Вставить("Код", Код);
	Результат.Вставить("Вид", Вид);
	Результат.Вставить("Кандидаты", Настройка.Справочник);
	Результат.Вставить("Найден", Мета <> Неопределено);
	Результат.Вставить("Мета", Мета);
	Результат.Вставить("Имя", ?(Мета = Неопределено, "", Мета.Имя));
	Результат.Вставить("ПолноеИмя", ?(Мета = Неопределено, "", "Справочник." + Мета.Имя));
	Результат.Вставить("ВыводитьИерархию", Настройка.Иерархия);
	Результат.Вставить("ЕстьРодитель", Мета <> Неопределено И Мета.Иерархический);
	Результат.Вставить("ЕстьГруппы", Мета <> Неопределено И ЕстьГруппы(Мета));
	Результат.Вставить("Персональный", Мета <> Неопределено И ЭтоПерсональноеИмя(Мета.Имя));
	Результат.Вставить("Поля", РазрешитьПоля(Мета, Настройка.Поля, Ложь));
	Результат.Вставить("Реквизиты", РеквизитыДляAttributes(Мета, Настройка.Реквизиты));
	Возврат Результат;

КонецФункции

// Поля OneBase → реквизиты объекта. Каждое поле: Имя, Вид, Параметр, Всегда, Кандидаты, Найден, Реквизит (имя или ""),
// ЕстьСсылки, Псевдоним (П1, П2… — имя колонки в запросе).
Функция РазрешитьПоля(Мета, ОписанияПолей, ЭтоТабличнаяЧасть)

	Результат = Новый Массив;
	Номер = 0;
	Для Каждого Описание Из ОписанияПолей Цикл
		Номер = Номер + 1;
		Поле = Новый Структура("Имя, Вид, Параметр, Всегда, Кандидаты, Найден, Реквизит, ЕстьСсылки, Псевдоним");
		ЗаполнитьЗначенияСвойств(Поле, Описание);
		Поле.Псевдоним = "П" + OneBase_Json.ЧислоСтрокой(Номер);
		Реквизит = Неопределено;
		Если Мета <> Неопределено Тогда
			Если ЭтоТабличнаяЧасть Тогда
				Реквизит = НайтиРеквизитТЧ(Мета, Описание.Кандидаты);
			Иначе
				Реквизит = НайтиРеквизит(Мета, Описание.Кандидаты);
			КонецЕсли;
		КонецЕсли;
		Поле.Найден = (Реквизит <> Неопределено);
		Поле.Реквизит = ?(Поле.Найден, Реквизит.Имя, "");
		Поле.ЕстьСсылки = Поле.Найден И Реквизит.ЕстьСсылки;
		Результат.Добавить(Поле);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Реквизиты для attributes в /references: "*" — все, кроме хранилищ значений; список — только они; "" — ничего.
Функция РеквизитыДляAttributes(Мета, Состав)

	Результат = Новый Массив;
	Если Мета = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состав) Тогда
		Возврат Результат;
	КонецЕсли;
	Номер = 0;
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		Если Состав <> "*" И Кандидаты(Состав).Найти(Реквизит.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Реквизит.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;
		Результат.Добавить(Новый Структура("Имя, ЕстьСсылки, Псевдоним",
			Реквизит.Имя, ЕстьСсылочныеТипы(Реквизит.Тип), "Р" + OneBase_Json.ЧислоСтрокой(Номер)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписаниеДокумента(Мета, КодТипа, Прочий, Параметры)

	РегистрБух = Параметры.Регистр;

	Результат = Новый Структура;
	Результат.Вставить("Имя", Мета.Имя);
	Результат.Вставить("ПолноеИмя", "Документ." + Мета.Имя);
	Результат.Вставить("Мета", Мета);
	Результат.Вставить("Тип", КодТипа);
	Результат.Вставить("Прочий", Прочий);
	Результат.Вставить("ЕстьПроведение", ЕстьПроведение(Мета));
	Результат.Вставить("ЕстьНомер", Мета.ДлинаНомера > 0);
	Результат.Вставить("Регистратор", РегистрБух.Найден И Мета.Движения.Содержит(РегистрБух.Мета));

	ОписанияПолей = ПоляСПереопределениями(Параметры.ПоляШапки, Параметры.Переопределения.Получить(Мета.Имя));
	Поля = РазрешитьПоля(Мета, ОписанияПолей, Ложь);
	ПоИмени = Новый Соответствие;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Найден Тогда
			ПоИмени.Вставить(Поле.Имя, Поле);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("Поля", Поля);
	Результат.Вставить("ПоляПоИмени", ПоИмени);

	Поле = ПоИмени.Получить("organizationId");
	Результат.Вставить("РеквизитОрганизации", ?(Поле = Неопределено, "", Поле.Реквизит));
	Поле = ПоИмени.Получить("currency");
	Результат.Вставить("РеквизитВалюты", ?(Поле = Неопределено, "", Поле.Реквизит));

	// Откуда взять сумму в валюте учёта (amountAccounting), по правилу нормализатора OneBase (OneCNormalizer):
	//   Реквизит — у документа есть реквизит суммы в валюте учёта: его значение;
	//   Сумма    — по сумме документа: в валюте учёта (или без валюты) — amount; в другой валюте — по курсу самого
	//              документа amount × rate.value / max(1, rate.multiplier), округление до 2 знаков «к чётному»;
	//              курса нет — поле не выгружается (текущим курсом ничего не пересчитывается);
	//   ""       — нет ни реквизита, ни суммы документа: поле не выгружается.
	Источник = "";
	Если ПоИмени.Получить("amountAccounting") <> Неопределено Тогда
		Источник = "Реквизит";
	ИначеЕсли ПоИмени.Получить("amount") <> Неопределено Тогда
		Источник = "Сумма";
	КонецЕсли;
	Результат.Вставить("ИсточникСуммыРегл", Источник);
	Результат.Вставить("ВалютаПоУмолчанию",
		ПоИмени.Получить("currency") = Неопределено И OneBase_Settings.ДокументыБезВалютыВВалютеУчета());

	Части = Новый Массив;
	Для Каждого ИмяЧасти Из Кандидаты(Параметры.ТабличныеЧасти) Цикл
		МетаЧасти = Мета.ТабличныеЧасти.Найти(ИмяЧасти);
		Если МетаЧасти = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПоляЧасти = РазрешитьПоля(МетаЧасти, Параметры.ПоляСтрок, Истина);
		Если НайденноеПоле(ПоляЧасти, "itemId") = Неопределено Тогда
			Продолжить; // без колонки номенклатуры строки OneBase не нужны
		КонецЕсли;
		Части.Добавить(Новый Структура("Имя, ПолноеИмя, Поля",
			МетаЧасти.Имя, "Документ." + Мета.Имя + "." + МетаЧасти.Имя, ПоляЧасти));
	КонецЦикла;
	Результат.Вставить("ТабличныеЧасти", Части);

	Возврат Результат;

КонецФункции

// Копия описаний полей, где кандидаты заменены переопределениями для конкретного документа.
Функция ПоляСПереопределениями(ОписанияПолей, Переопределения)

	Если Переопределения = Неопределено Тогда
		Возврат ОписанияПолей;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Описание Из ОписанияПолей Цикл
		Копия = Новый Структура("Имя, Кандидаты, Вид, Параметр, Всегда");
		ЗаполнитьЗначенияСвойств(Копия, Описание);
		Замена = Переопределения.Получить(Описание.Имя);
		Если Замена <> Неопределено Тогда
			Копия.Кандидаты = Замена;
		КонецЕсли;
		Результат.Добавить(Копия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Измерение или ресурс регистра бухгалтерии: Структура(Имя, Балансовый) или Неопределено.
// Небалансовые поля в таблицах регистра с корреспонденцией разделены на <Имя>Дт и <Имя>Кт.
Функция ПолеРегистра(Коллекция, СтрокаКандидатов)

	Найденное = НайтиОбъект(Коллекция, СтрокаКандидатов);
	Если Найденное = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Балансовый = Истина;
	Попытка
		Балансовый = Найденное.Балансовый;
	Исключение
		Балансовый = Истина;
	КонецПопытки;
	Возврат Новый Структура("Имя, Балансовый", Найденное.Имя, Балансовый);

КонецФункции

// --- /metadata: сопоставление настроек ---

Процедура ЗаписатьСопоставление(Контекст, Запись)

	Предупреждения = Новый Массив;
	OneBase_Json.НачатьОбъект(Запись, "mapping");

	// Регистр бухгалтерии.
	РегистрБух = Регистр(Контекст);
	OneBase_Json.НачатьОбъект(Запись, "accountingRegister");
	OneBase_Json.Свойство(Запись, "candidates", РегистрБух.Кандидаты);
	OneBase_Json.Свойство(Запись, "name", ?(РегистрБух.Найден, РегистрБух.Имя, Неопределено));
	Если РегистрБух.Найден Тогда
		OneBase_Json.Свойство(Запись, "correspondence", РегистрБух.Корреспонденция);
		OneBase_Json.Свойство(Запись, "chartOfAccounts", РегистрБух.ПланСчетов.Имя);
		OneBase_Json.Свойство(Запись, "maxSubconto", РегистрБух.МаксСубконто);
		OneBase_Json.Свойство(Запись, "subcontoTypes",
			?(РегистрБух.ВидыСубконто = Неопределено, Неопределено, РегистрБух.ВидыСубконто.Имя));
		OneBase_Json.НачатьОбъект(Запись, "dimensions");
		ЗаписатьПолеРегистра(Запись, "organization", РегистрБух.Организация);
		ЗаписатьПолеРегистра(Запись, "currency", РегистрБух.Валюта);
		ЗаписатьПолеРегистра(Запись, "department", РегистрБух.Подразделение);
		Запись.ЗаписатьКонецОбъекта();
		OneBase_Json.НачатьОбъект(Запись, "resources");
		ЗаписатьПолеРегистра(Запись, "amount", РегистрБух.Сумма);
		ЗаписатьПолеРегистра(Запись, "currencyAmount", РегистрБух.ВалютнаяСумма);
		ЗаписатьПолеРегистра(Запись, "quantity", РегистрБух.Количество);
		Запись.ЗаписатьКонецОбъекта();
		OneBase_Json.Свойство(Запись, "content", ?(РегистрБух.Содержание = "", Неопределено, РегистрБух.Содержание));
		OneBase_Json.Свойство(Запись, "currencyFlag", ?(РегистрБух.ПризнакВалютный = "", Неопределено, РегистрБух.ПризнакВалютный));
		OneBase_Json.Свойство(Запись, "quantityFlag",
			?(РегистрБух.ПризнакКоличественный = "", Неопределено, РегистрБух.ПризнакКоличественный));
		Если НЕ РегистрБух.Корреспонденция Тогда
			Предупреждения.Добавить("Регистр бухгалтерии без корреспонденции не поддерживается: /entries и /balances недоступны.");
		КонецЕсли;
		Если РегистрБух.Сумма = Неопределено Тогда
			Предупреждения.Добавить("В регистре бухгалтерии не найден ресурс суммы (OneBase_Settings.РегистрБухгалтерии, Сумма).");
		КонецЕсли;
		Если РегистрБух.Организация = Неопределено Тогда
			Предупреждения.Добавить("В регистре бухгалтерии нет измерения организации: отбор organizationId в /entries и /balances не применяется.");
		КонецЕсли;
	Иначе
		Предупреждения.Добавить("Регистр бухгалтерии не найден (кандидаты: " + РегистрБух.Кандидаты + "): /accounts, /entries, /balances недоступны.");
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

	// Валюта учёта и идентификатор базы.
	ВалютаУчета = OneBase_Export.ВалютаУчета(Контекст);
	OneBase_Json.НачатьОбъект(Запись, "accountingCurrency");
	OneBase_Json.Свойство(Запись, "code", ВалютаУчета.Код);
	OneBase_Json.Свойство(Запись, "found", ВалютаУчета.Ссылка <> Неопределено);
	OneBase_Json.Свойство(Запись, "source", ВалютаУчета.Источник);
	Запись.ЗаписатьКонецОбъекта();
	Если ВалютаУчета.Ссылка = Неопределено Тогда
		Предупреждения.Добавить("Валюта учёта не найдена ни в константах, ни в справочнике валют по коду "
			+ OneBase_Settings.КодВалютыУчета() + ": amountAccounting у документов в валюте будет пустым.");
	КонецЕсли;
	Идентификатор = OneBase_Export.ИдентификаторБазы();
	OneBase_Json.НачатьОбъект(Запись, "infobaseId");
	OneBase_Json.Свойство(Запись, "value", Идентификатор.Значение);
	OneBase_Json.Свойство(Запись, "source", Идентификатор.Источник);
	Запись.ЗаписатьКонецОбъекта();

	// Курсы валют.
	Курсы = КурсыВалют(Контекст);
	OneBase_Json.НачатьОбъект(Запись, "exchangeRates");
	OneBase_Json.Свойство(Запись, "candidates", Курсы.Кандидаты);
	OneBase_Json.Свойство(Запись, "register", ?(Курсы.Найден, Курсы.Мета.Имя, Неопределено));
	Если Курсы.Найден Тогда
		OneBase_Json.Свойство(Запись, "periodic", Курсы.Периодический);
		OneBase_Json.Свойство(Запись, "currency", ?(Курсы.Валюта = "", Неопределено, Курсы.Валюта));
		OneBase_Json.Свойство(Запись, "rate", ?(Курсы.Курс = "", Неопределено, Курсы.Курс));
		OneBase_Json.Свойство(Запись, "multiplier", ?(Курсы.Кратность = "", Неопределено, Курсы.Кратность));
		OneBase_Json.Свойство(Запись, "source", ?(Курсы.Источник = Неопределено, Неопределено, Курсы.Источник.Имя));
		OneBase_Json.НачатьМассив(Запись, "otherDimensions");
		Для Каждого Имя Из Курсы.ПрочиеИзмерения Цикл
			Запись.ЗаписатьЗначение(Имя);
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
		Если Курсы.Валюта = "" ИЛИ Курсы.Курс = "" ИЛИ НЕ Курсы.Периодический Тогда
			Предупреждения.Добавить("Регистр курсов найден, но нет измерения валюты, ресурса курса или он непериодический: /exchange-rates пуст.");
		КонецЕсли;
		Если Курсы.ПрочиеИзмерения.Количество() > 0 Тогда
			Предупреждения.Добавить("У регистра курсов есть другие измерения — на одну валюту и дату может прийти несколько курсов.");
		КонецЕсли;
	Иначе
		Предупреждения.Добавить("Регистр курсов валют не найден (кандидаты: " + Курсы.Кандидаты + "): /exchange-rates пуст.");
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

	// Справочники методов.
	OneBase_Json.НачатьОбъект(Запись, "catalogs");
	Для Каждого Элемент Из OneBase_Settings.СправочникиМетодов() Цикл
		Описание = Сущность(Контекст, Элемент.Ключ);
		ЗаписатьСопоставлениеСправочника(Запись, Описание, Предупреждения);
	КонецЦикла;
	Запись.ЗаписатьКонецОбъекта();

	// Прочие справочники.
	OneBase_Json.НачатьОбъект(Запись, "references");
	Для Каждого Элемент Из OneBase_Settings.ПрочиеСправочники() Цикл
		Описание = ПрочийСправочник(Контекст, Элемент.Ключ);
		ЗаписатьСопоставлениеСправочника(Запись, Описание, Предупреждения);
	КонецЦикла;
	Запись.ЗаписатьКонецОбъекта();

	// Типы документов.
	ВсеДокументы = ОписанияДокументов(Контекст);
	OneBase_Json.НачатьОбъект(Запись, "documentTypes");
	Для Каждого ТипДокумента Из OneBase_Settings.ТипыДокументов() Цикл
		OneBase_Json.НачатьОбъект(Запись, ТипДокумента.Код);
		OneBase_Json.Свойство(Запись, "candidates", ТипДокумента.Документы);
		OneBase_Json.НачатьМассив(Запись, "documents");
		Найдено = 0;
		Для Каждого Описание Из ВсеДокументы Цикл
			Если Описание.Тип = ТипДокумента.Код И НЕ Описание.Прочий Тогда
				ЗаписатьСопоставлениеДокумента(Запись, Описание);
				Найдено = Найдено + 1;
			КонецЕсли;
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
		OneBase_Json.НачатьМассив(Запись, "notFound");
		Для Каждого Имя Из Кандидаты(ТипДокумента.Документы) Цикл
			Если Метаданные.Документы.Найти(Имя) = Неопределено Тогда
				Запись.ЗаписатьЗначение(Имя);
			КонецЕсли;
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
		Запись.ЗаписатьКонецОбъекта();
		Если Найдено = 0 Тогда
			Предупреждения.Добавить("Тип документа " + ТипДокумента.Код + ": ни один документ не найден (кандидаты: "
				+ ТипДокумента.Документы + ").");
		КонецЕсли;
	КонецЦикла;
	Запись.ЗаписатьКонецОбъекта();

	// Прочие документы с проводками и исключённые.
	OneBase_Json.НачатьОбъект(Запись, "otherDocuments");
	OneBase_Json.Свойство(Запись, "exportedToDocuments", OneBase_Settings.ВыгружатьПрочиеДокументы());
	OneBase_Json.НачатьМассив(Запись, "documents");
	Для Каждого Описание Из ВсеДокументы Цикл
		Если Описание.Прочий Тогда
			Запись.ЗаписатьЗначение(Описание.Имя);
		КонецЕсли;
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();

	OneBase_Json.НачатьМассив(Запись, "excludedDocuments");
	Для Каждого Имя Из Кандидаты(OneBase_Settings.ИсключенныеДокументы()) Цикл
		Запись.ЗаписатьЗначение(Имя);
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

	OneBase_Json.НачатьМассив(Запись, "personalSubcontoTypes");
	Для Каждого Имя Из Кандидаты(OneBase_Settings.ПерсональныеВидыСубконто()) Цикл
		Запись.ЗаписатьЗначение(Имя);
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

	OneBase_Json.НачатьМассив(Запись, "warnings");
	Для Каждого Текст Из Предупреждения Цикл
		Запись.ЗаписатьЗначение(Текст);
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Процедура ЗаписатьПолеРегистра(Запись, Имя, Поле)

	Если Поле = Неопределено Тогда
		OneBase_Json.Свойство(Запись, Имя, Неопределено);
		Возврат;
	КонецЕсли;
	OneBase_Json.НачатьОбъект(Запись, Имя);
	OneBase_Json.Свойство(Запись, "name", Поле.Имя);
	OneBase_Json.Свойство(Запись, "balance", Поле.Балансовый);
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Процедура ЗаписатьСопоставлениеСправочника(Запись, Описание, Предупреждения)

	OneBase_Json.НачатьОбъект(Запись, Описание.Код);
	OneBase_Json.Свойство(Запись, "candidates", Описание.Кандидаты);
	OneBase_Json.Свойство(Запись, "catalog", ?(Описание.Найден, Описание.Имя, Неопределено));
	Если Описание.Найден Тогда
		OneBase_Json.Свойство(Запись, "hierarchical", Описание.ЕстьРодитель);
		OneBase_Json.Свойство(Запись, "groups", Описание.ЕстьГруппы);
		OneBase_Json.Свойство(Запись, "personal", Описание.Персональный);
		ЗаписатьСопоставлениеПолей(Запись, "fields", Описание.Поля);
		Если Описание.Реквизиты.Количество() > 0 Тогда
			OneBase_Json.НачатьМассив(Запись, "attributes");
			Для Каждого Реквизит Из Описание.Реквизиты Цикл
				Запись.ЗаписатьЗначение(Реквизит.Имя);
			КонецЦикла;
			Запись.ЗаписатьКонецМассива();
		КонецЕсли;
		Для Каждого Поле Из Описание.Поля Цикл
			Если Поле.Всегда И НЕ Поле.Найден Тогда
				Предупреждения.Добавить("Справочник " + Описание.Имя + " (" + Описание.Код + "): не найден реквизит для поля "
					+ Поле.Имя + " (кандидаты: " + Поле.Кандидаты + ").");
			КонецЕсли;
		КонецЦикла;
	Иначе
		Предупреждения.Добавить("Справочник для " + Описание.Код + " не найден (кандидаты: " + Описание.Кандидаты + ").");
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Процедура ЗаписатьСопоставлениеДокумента(Запись, Описание)

	Запись.ЗаписатьНачалоОбъекта();
	OneBase_Json.Свойство(Запись, "name", Описание.Имя);
	OneBase_Json.Свойство(Запись, "posting", Описание.ЕстьПроведение);
	OneBase_Json.Свойство(Запись, "postsEntries", Описание.Регистратор);
	OneBase_Json.Свойство(Запись, "amountAccountingSource",
		?(Описание.ИсточникСуммыРегл = "", Неопределено, Описание.ИсточникСуммыРегл));
	ЗаписатьСопоставлениеПолей(Запись, "fields", Описание.Поля);
	OneBase_Json.НачатьМассив(Запись, "lineSections");
	Для Каждого Часть Из Описание.ТабличныеЧасти Цикл
		Запись.ЗаписатьНачалоОбъекта();
		OneBase_Json.Свойство(Запись, "name", Часть.Имя);
		ЗаписатьСопоставлениеПолей(Запись, "columns", Часть.Поля);
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

// { "поле OneBase": "реквизит 1С" или null }.
Процедура ЗаписатьСопоставлениеПолей(Запись, Имя, Поля)

	OneBase_Json.НачатьОбъект(Запись, Имя);
	Для Каждого Поле Из Поля Цикл
		OneBase_Json.Свойство(Запись, Поле.Имя, ?(Поле.Найден, Поле.Реквизит, Неопределено));
	КонецЦикла;
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

// --- /metadata: коллекции и объекты ---

Процедура ЗаписатьКоллекцию(Контекст, Запись, Имя, Коллекция, Подробно)

	РегистрБух = Регистр(Контекст);
	ЭтоДокументы = (Имя = "documents");
	OneBase_Json.НачатьМассив(Запись, Имя);
	Для Каждого Мета Из Коллекция Цикл
		Запись.ЗаписатьНачалоОбъекта();
		ЗаписатьОписаниеОбъекта(Запись, Мета, Подробно);
		Если ЭтоДокументы И НЕ Подробно И РегистрБух.Найден Тогда
			OneBase_Json.Свойство(Запись, "postsEntries", Мета.Движения.Содержит(РегистрБух.Мета));
		КонецЕсли;
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

КонецПроцедуры

// Свойства объекта (без обрамляющих скобок объекта JSON).
Процедура ЗаписатьОписаниеОбъекта(Запись, Мета, Подробно)

	OneBase_Json.Свойство(Запись, "name", Мета.Имя);
	OneBase_Json.Свойство(Запись, "fullName", Мета.ПолноеИмя());
	OneBase_Json.Свойство(Запись, "synonym", Строка(Мета.Синоним));
	Если НЕ Подробно Тогда
		Возврат;
	КонецЕсли;

	ВидОбъекта = Класс(Мета);
	Если ВидОбъекта = "Справочник" Тогда
		OneBase_Json.Свойство(Запись, "codeLength", Мета.ДлинаКода);
		OneBase_Json.Свойство(Запись, "nameLength", Мета.ДлинаНаименования);
		OneBase_Json.Свойство(Запись, "hierarchical", Мета.Иерархический);
		OneBase_Json.Свойство(Запись, "groups", ЕстьГруппы(Мета));
		OneBase_Json.НачатьМассив(Запись, "owners");
		Для Каждого Владелец Из Мета.Владельцы Цикл
			Запись.ЗаписатьЗначение(Владелец.ПолноеИмя());
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	ИначеЕсли ВидОбъекта = "Документ" Тогда
		OneBase_Json.Свойство(Запись, "numberLength", Мета.ДлинаНомера);
		OneBase_Json.Свойство(Запись, "posting", ЕстьПроведение(Мета));
		OneBase_Json.НачатьМассив(Запись, "registerRecords");
		Для Каждого Движение Из Мета.Движения Цикл
			Запись.ЗаписатьЗначение(Движение.ПолноеИмя());
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	ИначеЕсли ВидОбъекта = "ПланСчетов" Тогда
		OneBase_Json.Свойство(Запись, "codeLength", Мета.ДлинаКода);
		OneBase_Json.Свойство(Запись, "maxSubconto", Мета.МаксКоличествоСубконто);
		OneBase_Json.Свойство(Запись, "subcontoTypes", ?(Мета.ВидыСубконто = Неопределено, Неопределено, Мета.ВидыСубконто.ПолноеИмя()));
		ЗаписатьИменаКоллекции(Запись, "accountingFlags", Мета.ПризнакиУчета);
		ЗаписатьИменаКоллекции(Запись, "subcontoAccountingFlags", Мета.ПризнакиУчетаСубконто);
	ИначеЕсли ВидОбъекта = "РегистрБухгалтерии" Тогда
		OneBase_Json.Свойство(Запись, "chartOfAccounts", Мета.ПланСчетов.ПолноеИмя());
		OneBase_Json.Свойство(Запись, "correspondence", Мета.Корреспонденция);
		ЗаписатьПоляКоллекции(Запись, "dimensions", Мета.Измерения, Истина);
		ЗаписатьПоляКоллекции(Запись, "resources", Мета.Ресурсы, Истина);
	ИначеЕсли ВидОбъекта = "РегистрСведений" Тогда
		OneBase_Json.Свойство(Запись, "periodicity", Строка(Мета.ПериодичностьРегистраСведений));
		ЗаписатьПоляКоллекции(Запись, "dimensions", Мета.Измерения, Ложь);
		ЗаписатьПоляКоллекции(Запись, "resources", Мета.Ресурсы, Ложь);
	ИначеЕсли ВидОбъекта = "Константа" Тогда
		ЗаписатьТипы(Запись, "types", Мета.Тип);
	ИначеЕсли ВидОбъекта = "Перечисление" Тогда
		ЗаписатьИменаКоллекции(Запись, "values", Мета.ЗначенияПеречисления);
	КонецЕсли;

	Если ВидОбъекта = "Справочник" ИЛИ ВидОбъекта = "Документ" ИЛИ ВидОбъекта = "ПланСчетов"
		ИЛИ ВидОбъекта = "ПланВидовХарактеристик" ИЛИ ВидОбъекта = "РегистрБухгалтерии"
		ИЛИ ВидОбъекта = "РегистрСведений" ИЛИ ВидОбъекта = "РегистрНакопления" Тогда
		ЗаписатьПоляКоллекции(Запись, "attributes", Мета.Реквизиты, Ложь);
	КонецЕсли;

	Если ВидОбъекта = "Справочник" ИЛИ ВидОбъекта = "Документ" ИЛИ ВидОбъекта = "ПланСчетов"
		ИЛИ ВидОбъекта = "ПланВидовХарактеристик" Тогда
		OneBase_Json.НачатьМассив(Запись, "tabularSections");
		Для Каждого Часть Из Мета.ТабличныеЧасти Цикл
			Запись.ЗаписатьНачалоОбъекта();
			OneBase_Json.Свойство(Запись, "name", Часть.Имя);
			OneBase_Json.Свойство(Запись, "synonym", Строка(Часть.Синоним));
			ЗаписатьПоляКоллекции(Запись, "attributes", Часть.Реквизиты, Ложь);
			Запись.ЗаписатьКонецОбъекта();
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	КонецЕсли;

КонецПроцедуры

// [{ name, synonym, types, balance? }].
Процедура ЗаписатьПоляКоллекции(Запись, Имя, Коллекция, СБалансом)

	OneBase_Json.НачатьМассив(Запись, Имя);
	Для Каждого Элемент Из Коллекция Цикл
		Запись.ЗаписатьНачалоОбъекта();
		OneBase_Json.Свойство(Запись, "name", Элемент.Имя);
		OneBase_Json.Свойство(Запись, "synonym", Строка(Элемент.Синоним));
		ЗаписатьТипы(Запись, "types", Элемент.Тип);
		Если СБалансом Тогда
			Попытка
				OneBase_Json.Свойство(Запись, "balance", Элемент.Балансовый);
			Исключение
				// у этого вида поля нет свойства «Балансовый»
			КонецПопытки;
		КонецЕсли;
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

КонецПроцедуры

Процедура ЗаписатьИменаКоллекции(Запись, Имя, Коллекция)

	OneBase_Json.НачатьМассив(Запись, Имя);
	Для Каждого Элемент Из Коллекция Цикл
		Запись.ЗаписатьЗначение(Элемент.Имя);
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

КонецПроцедуры

// Типы реквизита: полные имена объектов ("Справочник.Контрагенты") или имена примитивных типов ("Строка").
Процедура ЗаписатьТипы(Запись, Имя, ОписаниеТипов)

	OneBase_Json.НачатьМассив(Запись, Имя);
	Для Каждого ТипРеквизита Из ОписаниеТипов.Типы() Цикл
		МетаТипа = Метаданные.НайтиПоТипу(ТипРеквизита);
		Если МетаТипа = Неопределено Тогда
			Запись.ЗаписатьЗначение(Строка(ТипРеквизита));
		Иначе
			Запись.ЗаписатьЗначение(МетаТипа.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

КонецПроцедуры

#КонецОбласти
