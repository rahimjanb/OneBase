// =====================================================================================================================
// OneBase_Export — выгрузка данных для OneBase: запросы по методам, страницы с курсором, итоги, версии, проводки, остатки.
//
// Свойства общего модуля: Сервер = Истина; Глобальный, Клиент, Внешнее соединение, Вызов сервера,
// Привилегированный = Ложь (данные читаются с правами пользователя HTTP-сервиса).
//
// Модуль ТОЛЬКО ЧИТАЕТ. Используются лишь: Запрос (ВЫБРАТЬ, без ПОМЕСТИТЬ и без ДЛЯ ИЗМЕНЕНИЯ), чтение констант,
// ПолучитьСсылку(УИД) (ссылка строится в памяти), чтение метаданных и запись JSON в строку. Нет Записать(), Удалить(),
// ПолучитьОбъект(), транзакций, управляемых блокировок, планов обмена и подписок на события.
//
// Порядок строк на страницах:
//   справочники, план счетов — по ссылке (Ссылка > &последняя: ключевой курсор, без смещения);
//   документы, наборы проводок, версии документов — по виду документа (порядок из OneBase_Settings), внутри вида —
//     по дате и ссылке (ключевой курсор: последняя дата и ссылка);
//   курсы валют — по периоду, валюте и прочим измерениям (курсор — смещение: таблица небольшая);
//   остатки — по коду счёта, внутри счёта — по организации, валюте и субконто (курсор: счёт + смещение внутри счёта);
//     строки счетов с персональными субконто сначала сворачиваются в 1С, порядок — по ключу из UUID оставшихся полей.
// =====================================================================================================================

#Область ПрограммныйИнтерфейс

// Выполняет метод API. Метод — имя из адреса /v1/<метод> в нижнем регистре. Возвращает HTTPСервисОтвет.
// Ошибки параметров и настройки — исключение OneBase_Json.ВызватьОшибкуAPI (обработчик HTTP-сервиса превращает его в ответ).
Функция ВыполнитьМетод(Метод, ПараметрыЗапроса) Экспорт

	ИмяМетода = Метод;
	ТипыПсевдонима = "";
	Псевдоним = OneBase_Settings.ПсевдонимыМетодов().Получить(Метод);
	Если Псевдоним <> Неопределено Тогда
		ИмяМетода = Псевдоним.Метод;
		ТипыПсевдонима = Псевдоним.Типы;
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("Метод", ИмяМетода);
	Контекст.Вставить("Параметры", ПараметрыЗапроса);
	Контекст.Вставить("ТипыПсевдонима", ТипыПсевдонима);
	Контекст.Вставить("Смещение", OneBase_Settings.СмещениеЧасовогоПояса());
	Контекст.Вставить("Кэш", Новый Соответствие);
	Контекст.Вставить("ЕстьПраваЗаписи", Ложь);

	ПроверитьПраваПользователя(Контекст);

	Если Параметр(Контекст, "modifiedSince") <> "" Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter",
			"Параметр modifiedSince не поддерживается: 1С не хранит момент изменения объектов. Используйте GET /versions.",
			"modifiedSince");
	КонецЕсли;

	Запись = OneBase_Json.НоваяЗапись();

	Если ИмяМетода = "ping" Тогда
		ВыгрузитьPing(Контекст, Запись);
	ИначеЕсли ИмяМетода = "metadata" Тогда
		OneBase_Metadata.ВыгрузитьМетаданные(Контекст, Запись);
	ИначеЕсли ИмяМетода = "directories" Тогда
		ВыгрузитьСписокСправочников(Контекст, Запись);
	ИначеЕсли ИмяМетода = "accounts" Тогда
		ВыгрузитьСчета(Контекст, Запись, Ложь);
	ИначеЕсли ИмяМетода = "references" Тогда
		ВыгрузитьСправочник(Контекст, Запись, ПрочийСправочникИзПараметра(Контекст), Ложь);
	ИначеЕсли OneBase_Settings.СправочникиМетодов().Получить(ИмяМетода) <> Неопределено Тогда
		ВыгрузитьСправочник(Контекст, Запись, OneBase_Metadata.Сущность(Контекст, ИмяМетода), Ложь);
	ИначеЕсли ИмяМетода = "exchange-rates" Тогда
		ВыгрузитьКурсы(Контекст, Запись);
	ИначеЕсли ИмяМетода = "documents" Тогда
		ВыгрузитьДокументы(Контекст, Запись);
	ИначеЕсли ИмяМетода = "entries" Тогда
		ВыгрузитьПроводки(Контекст, Запись);
	ИначеЕсли ИмяМетода = "balances" Тогда
		ВыгрузитьОстатки(Контекст, Запись);
	ИначеЕсли ИмяМетода = "versions" Тогда
		ВыгрузитьВерсии(Контекст, Запись);
	ИначеЕсли ИмяМетода = "changes" Тогда
		OneBase_Json.ВызватьОшибкуAPI(404, "not_found",
			"Метод /changes не реализован: он требует плана обмена, то есть записи в базу 1С, а этот сервис только читает. "
			+ "Изменения и удаления находите через GET /versions и выборку по ids=.");
	Иначе
		OneBase_Json.ВызватьОшибкуAPI(404, "not_found", "Метод не найден: /v1/" + Лев(Метод, 60)
			+ ". Методы: ping, organizations, accounts, counterparties, contracts, currencies, exchange-rates, warehouses, "
			+ "departments, items, references, documents, entries, balances, versions, metadata, directories.");
	КонецЕсли;

	Возврат OneBase_Json.HTTPОтвет(200, OneBase_Json.ЗакрытьЗапись(Запись));

КонецФункции

// Валюта регламентированного учёта: Структура(Ссылка, Код, Источник). Ссылка — Неопределено, если валюта не найдена.
Функция ВалютаУчета(Контекст) Экспорт

	Результат = Контекст.Кэш.Получить("ВалютаУчета");
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Ссылка = Неопределено;
	Источник = "";
	Для Каждого Имя Из OneBase_Metadata.Кандидаты(OneBase_Settings.КонстантыВалютыУчета()) Цикл
		Если Метаданные.Константы.Найти(Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеКонстанты = Неопределено;
		Попытка
			ЗначениеКонстанты = Константы[Имя].Получить();
		Исключение
			ЗначениеКонстанты = Неопределено;
		КонецПопытки;
		Если ЗначениеЗаполнено(ЗначениеКонстанты) Тогда
			Ссылка = ЗначениеКонстанты;
			Источник = "константа " + Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	СправочникВалют = Валюты(Контекст);
	Если Ссылка = Неопределено Тогда
		Ссылка = СправочникВалют.ПоКоду.Получить(ВРег(OneBase_Settings.КодВалютыУчета()));
		Источник = "справочник валют по коду " + OneBase_Settings.КодВалютыУчета();
	КонецЕсли;

	Код = ?(Ссылка = Неопределено, Неопределено, СправочникВалют.ПоСсылке.Получить(Ссылка));
	Если Код = Неопределено Тогда
		Код = OneBase_Settings.КодВалютыУчета();
		Если Ссылка = Неопределено Тогда
			Источник = "настройка КодВалютыУчета (валюта в базе не найдена)";
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура("Ссылка, Код, Источник", Ссылка, Код, Источник);
	Контекст.Кэш.Вставить("ВалютаУчета", Результат);
	Возврат Результат;

КонецФункции

// Постоянный идентификатор базы для /ping: Структура(Значение, Источник).
Функция ИдентификаторБазы() Экспорт

	Значение = СокрЛП(OneBase_Settings.ИдентификаторИнформационнойБазы());
	Если Значение <> "" Тогда
		Возврат Новый Структура("Значение, Источник", Значение, "настройка ИдентификаторИнформационнойБазы");
	КонецЕсли;

	Для Каждого Имя Из OneBase_Metadata.Кандидаты(OneBase_Settings.КонстантыИдентификатораБазы()) Цикл
		Если Метаданные.Константы.Найти(Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеКонстанты = Неопределено;
		Попытка
			ЗначениеКонстанты = Константы[Имя].Получить();
		Исключение
			ЗначениеКонстанты = Неопределено;
		КонецПопытки;
		Если ЗначениеЗаполнено(ЗначениеКонстанты) Тогда
			Возврат Новый Структура("Значение, Источник", НРег(СокрЛП(Строка(ЗначениеКонстанты))), "константа " + Имя);
		КонецЕсли;
	КонецЦикла;

	Попытка
		Хеш = OneBase_Json.ХешSHA256(НРег(СтрокаСоединенияИнформационнойБазы()));
		Значение = Сред(Хеш, 1, 8) + "-" + Сред(Хеш, 9, 4) + "-" + Сред(Хеш, 13, 4) + "-" + Сред(Хеш, 17, 4) + "-" + Сред(Хеш, 21, 12);
		Возврат Новый Структура("Значение, Источник", Значение, "SHA-256 строки соединения");
	Исключение
		Возврат Новый Структура("Значение, Источник", Неопределено, "не определён: задайте OneBase_Settings.ИдентификаторИнформационнойБазы");
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Ping

// GET /v1/ping — спецификация 4.1.
Процедура ВыгрузитьPing(Контекст, Запись)

	ИмяБазы = СокрЛП(OneBase_Settings.ИмяИнформационнойБазы());
	Если ИмяБазы = "" Тогда
		ИмяБазы = Строка(Метаданные.Синоним);
	КонецЕсли;

	НачатьОтвет(Запись);
	OneBase_Json.Свойство(Запись, "infobaseId", ИдентификаторБазы().Значение);
	OneBase_Json.Свойство(Запись, "infobaseName", ИмяБазы);
	OneBase_Json.НачатьОбъект(Запись, "configuration");
	OneBase_Json.Свойство(Запись, "name", Метаданные.Имя);
	OneBase_Json.Свойство(Запись, "version", Метаданные.Версия);
	Запись.ЗаписатьКонецОбъекта();
	OneBase_Json.Свойство(Запись, "serverTime", OneBase_Json.ДатаВремя(ТекущаяДатаСеанса(), Контекст.Смещение));
	OneBase_Json.Свойство(Запись, "accountingCurrency", ВалютаУчета(Контекст).Код);
	OneBase_Json.Свойство(Запись, "user", ИмяПользователя());
	OneBase_Json.Свойство(Запись, "readOnly", Истина);
	OneBase_Json.Свойство(Запись, "userWriteAccess", Контекст.ЕстьПраваЗаписи);
	OneBase_Json.Свойство(Запись, "changeTracking", "versions");
	OneBase_Json.НачатьМассив(Запись, "capabilities");
	Запись.ЗаписатьЗначение("versions");
	Запись.ЗаписатьЗначение("ids");
	Запись.ЗаписатьКонецМассива();
	OneBase_Json.Свойство(Запись, "extensionVersion", OneBase_Settings.ВерсияРасширения());
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

#КонецОбласти

#Область Справочники

// Справочник метода или прочий справочник: страница, ids=, итоги. Облегченно — только id, version, deletionMark (/versions).
Процедура ВыгрузитьСправочник(Контекст, Запись, Сущность, Облегченно)

	Если Сущность.Персональный Тогда
		OneBase_Json.ВызватьОшибкуAPI(403, "forbidden", "Справочник " + Сущность.Имя
			+ " отнесён к персональным данным (OneBase_Settings.ПерсональныеВидыСубконто) и не выгружается.");
	КонецЕсли;

	НачатьОтвет(Запись);
	Если НЕ Сущность.Найден Тогда
		ЗаписатьПустойСписок(Контекст, Запись, "Справочник для " + Сущность.Код + " не найден в конфигурации (кандидаты: "
			+ Сущность.Кандидаты + "). Настройте OneBase_Settings по GET /v1/metadata.");
		Запись.ЗаписатьКонецОбъекта();
		Возврат;
	КонецЕсли;

	ТекстПолей = "Т.Ссылка КАК Ссылка, Т.ВерсияДанных КАК Версия, Т.ПометкаУдаления КАК ПометкаУдаления";
	Если НЕ Облегченно Тогда
		Если Сущность.ЕстьРодитель Тогда
			ТекстПолей = ТекстПолей + ", Т.Родитель КАК Родитель";
		КонецЕсли;
		Если Сущность.ЕстьГруппы Тогда
			ТекстПолей = ТекстПолей + ", Т.ЭтоГруппа КАК ЭтоГруппа";
		КонецЕсли;
		ТекстПолей = ТекстПолей + ТекстПолейЗапроса(Контекст, Сущность.Поля, "Т");
		Для Каждого Реквизит Из Сущность.Реквизиты Цикл
			ТекстПолей = ТекстПолей + ", Т." + Реквизит.Имя + " КАК " + Реквизит.Псевдоним;
		КонецЦикла;
	КонецЕсли;

	Страница = СтраницаПоСсылке(Контекст, Сущность.Мета, Сущность.ПолноеИмя, ТекстПолей);

	БанковскиеСчета = Неопределено;
	Если НЕ Облегченно И Сущность.Вид = "catalog" И Сущность.Код = "counterparties" Тогда
		БанковскиеСчета = БанковскиеСчетаКонтрагентов(Контекст, Сущность, Страница.Строки);
	КонецЕсли;

	OneBase_Json.НачатьМассив(Запись, "items");
	Для Каждого Данные Из Страница.Строки Цикл
		Если Облегченно Тогда
			ЗаписатьВерсию(Контекст, Запись, Данные, Неопределено);
		Иначе
			ЗаписатьЭлементСправочника(Контекст, Запись, Сущность, Данные, БанковскиеСчета);
		КонецЕсли;
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	ЗаписатьСтраницу(Запись, Страница);

	Если ИтогиЗапрошены(Контекст) И НЕ Страница.ПоИдентификаторам Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(Т.Ссылка) КАК ЧислоЗаписей ИЗ " + Сущность.ПолноеИмя + " КАК Т";
		ЗаписатьИтоги(Запись, ВыполнитьПодсчет(Запрос), Неопределено);
	КонецЕсли;

	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Процедура ЗаписатьЭлементСправочника(Контекст, Запись, Сущность, Данные, БанковскиеСчета)

	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьОбщиеПоля(Запись, Данные);
	Если Сущность.ВыводитьИерархию Тогда
		Если Сущность.ЕстьРодитель Тогда
			OneBase_Json.СвойствоЕслиЕсть(Запись, "parentId", ИдСсылки(Данные.Родитель));
		КонецЕсли;
		OneBase_Json.Свойство(Запись, "isGroup", Сущность.ЕстьГруппы И Данные.ЭтоГруппа = Истина);
	КонецЕсли;

	ЭтоКонтрагенты = (Сущность.Вид = "catalog" И Сущность.Код = "counterparties");
	ЭтоНоменклатура = (Сущность.Вид = "catalog" И Сущность.Код = "items");
	Пропустить = "";
	Если ЭтоКонтрагенты Тогда
		Пропустить = "kind,pinfl";
	ИначеЕсли ЭтоНоменклатура Тогда
		Пропустить = "kind";
	КонецЕсли;
	ЗаписатьПоля(Контекст, Запись, Данные, Сущность.Поля, Пропустить);

	Если Сущность.Вид = "catalog" И Сущность.Код = "organizations" Тогда
		OneBase_Json.СвойствоЕслиЕсть(Запись, "accountingCurrency", ВалютаУчета(Контекст).Код);
	ИначеЕсли ЭтоКонтрагенты Тогда
		ЗаписатьОсобенностиКонтрагента(Контекст, Запись, Сущность, Данные, БанковскиеСчета);
	ИначеЕсли ЭтоНоменклатура Тогда
		Услуга = OneBase_Metadata.НайденноеПоле(Сущность.Поля, "_service");
		Если Услуга <> Неопределено И ЗначениеПоля(Контекст, Данные, Услуга) = Истина Тогда
			OneBase_Json.Свойство(Запись, "kind", "service");
		Иначе
			OneBase_Json.СвойствоЕслиЕсть(Запись, "kind", ЗначениеНайденногоПоля(Контекст, Данные, Сущность.Поля, "kind"));
		КонецЕсли;
	КонецЕсли;

	Если Сущность.Реквизиты.Количество() > 0 Тогда
		OneBase_Json.НачатьОбъект(Запись, "attributes");
		Для Каждого Реквизит Из Сущность.Реквизиты Цикл
			OneBase_Json.Свойство(Запись, Реквизит.Имя, ЗначениеСтрокой(Контекст, Данные[Реквизит.Псевдоним]));
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
	КонецЕсли;

	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

// kind (реквизит вида или признаки «покупатель»/«поставщик»), pinfl (если разрешено), bankAccounts.
Процедура ЗаписатьОсобенностиКонтрагента(Контекст, Запись, Сущность, Данные, БанковскиеСчета)

	ВидКонтрагента = ЗначениеНайденногоПоля(Контекст, Данные, Сущность.Поля, "kind");
	Если ВидКонтрагента = Неопределено Тогда
		ПолеПокупателя = OneBase_Metadata.НайденноеПоле(Сущность.Поля, "_customer");
		ПолеПоставщика = OneBase_Metadata.НайденноеПоле(Сущность.Поля, "_supplier");
		Если ПолеПокупателя <> Неопределено ИЛИ ПолеПоставщика <> Неопределено Тогда
			ЭтоПокупатель = ПолеПокупателя <> Неопределено И ЗначениеПоля(Контекст, Данные, ПолеПокупателя) = Истина;
			ЭтоПоставщик = ПолеПоставщика <> Неопределено И ЗначениеПоля(Контекст, Данные, ПолеПоставщика) = Истина;
			Если ЭтоПокупатель И ЭтоПоставщик Тогда
				ВидКонтрагента = "both";
			ИначеЕсли ЭтоПокупатель Тогда
				ВидКонтрагента = "customer";
			ИначеЕсли ЭтоПоставщик Тогда
				ВидКонтрагента = "supplier";
			Иначе
				ВидКонтрагента = "other";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	OneBase_Json.СвойствоЕслиЕсть(Запись, "kind", ВидКонтрагента);

	Если OneBase_Settings.ВыгружатьПИНФЛ() Тогда
		OneBase_Json.СвойствоЕслиЕсть(Запись, "pinfl", ЗначениеНайденногоПоля(Контекст, Данные, Сущность.Поля, "pinfl"));
	КонецЕсли;

	Если БанковскиеСчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Список = БанковскиеСчета.Получить(Данные.Ссылка);
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	OneBase_Json.НачатьМассив(Запись, "bankAccounts");
	Для Каждого Счет Из Список Цикл
		Запись.ЗаписатьНачалоОбъекта();
		OneBase_Json.СвойствоЕслиЕсть(Запись, "account", Счет.НомерСчета);
		OneBase_Json.СвойствоЕслиЕсть(Запись, "mfo", Счет.МФО);
		OneBase_Json.СвойствоЕслиЕсть(Запись, "bank", Счет.Банк);
		OneBase_Json.СвойствоЕслиЕсть(Запись, "currency", Счет.Валюта);
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

КонецПроцедуры

// Банковские счета контрагентов страницы: Соответствие (контрагент → массив Структура(НомерСчета, МФО, Банк, Валюта)).
Функция БанковскиеСчетаКонтрагентов(Контекст, Сущность, Строки)

	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Настройки = OneBase_Settings.БанковскиеСчетаКонтрагентов();
	МетаСчетов = OneBase_Metadata.НайтиОбъект(Метаданные.Справочники, Настройки.Справочник);
	Если МетаСчетов = Неопределено ИЛИ НЕ МетаСчетов.Владельцы.Содержит(Сущность.Мета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	РеквизитНомера = OneBase_Metadata.НайтиРеквизит(МетаСчетов, Настройки.НомерСчета);
	Если РеквизитНомера = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	РеквизитБанка = OneBase_Metadata.НайтиРеквизит(МетаСчетов, Настройки.Банк);
	РеквизитВалюты = OneBase_Metadata.НайтиРеквизит(МетаСчетов, Настройки.Валюта);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Т.Владелец КАК Владелец, Т." + РеквизитНомера.Имя + " КАК НомерСчета, "
		+ ?(РеквизитБанка = Неопределено, "НЕОПРЕДЕЛЕНО", "Т." + РеквизитБанка.Имя) + " КАК Банк, "
		+ ?(РеквизитВалюты = Неопределено, "НЕОПРЕДЕЛЕНО", "Т." + РеквизитВалюты.Имя) + " КАК Валюта"
		+ " ИЗ Справочник." + МетаСчетов.Имя + " КАК Т"
		+ " ГДЕ Т.Владелец В (&Владельцы) И НЕ Т.ПометкаУдаления"
		+ " УПОРЯДОЧИТЬ ПО Т.Ссылка";
	Владельцы = Новый Массив;
	Для Каждого Данные Из Строки Цикл
		Владельцы.Добавить(Данные.Ссылка);
	КонецЦикла;
	Запрос.УстановитьПараметр("Владельцы", Владельцы);
	Таблица = Запрос.Выполнить().Выгрузить();
	ЗаполнитьПредставления(Контекст, Таблица.ВыгрузитьКолонку("Банк"));

	Результат = Новый Соответствие;
	Для Каждого Данные Из Таблица Цикл
		Список = Результат.Получить(Данные.Владелец);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Данные.Владелец, Список);
		КонецЕсли;
		Банк = ПредставлениеСсылки(Контекст, Данные.Банк);
		Список.Добавить(Новый Структура("НомерСчета, МФО, Банк, Валюта",
			ЗначениеСтрокой(Контекст, Данные.НомерСчета),
			?(Банк = Неопределено, Неопределено, Банк.Код),
			?(Банк = Неопределено, Неопределено, Банк.Наименование),
			КодВалюты(Контекст, Данные.Валюта)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// GET /v1/accounts (Облегченно = Ложь) и /versions?entityType=account (Истина) — спецификация 4.3.
Процедура ВыгрузитьСчета(Контекст, Запись, Облегченно)

	Регистр = OneBase_Metadata.Регистр(Контекст);
	НачатьОтвет(Запись);
	Если НЕ Регистр.Найден Тогда
		ЗаписатьПустойСписок(Контекст, Запись, "Регистр бухгалтерии не найден (кандидаты: " + Регистр.Кандидаты
			+ "), поэтому неизвестен план счетов. Настройте OneBase_Settings.РегистрБухгалтерии.");
		Запись.ЗаписатьКонецОбъекта();
		Возврат;
	КонецЕсли;

	ТекстПолей = "Т.Ссылка КАК Ссылка, Т.ВерсияДанных КАК Версия, Т.ПометкаУдаления КАК ПометкаУдаления";
	Если НЕ Облегченно Тогда
		ТекстПолей = ТекстПолей + ", Т.Код КАК Код, Т.Наименование КАК Наименование, Т.Родитель.Код КАК КодРодителя,"
			+ " Т.Вид КАК Вид, Т.Забалансовый КАК Забалансовый, "
			+ ?(Регистр.ПризнакВалютный = "", "ЛОЖЬ", "Т." + Регистр.ПризнакВалютный) + " КАК Валютный, "
			+ ?(Регистр.ПризнакКоличественный = "", "ЛОЖЬ", "Т." + Регистр.ПризнакКоличественный) + " КАК Количественный";
	КонецЕсли;
	Страница = СтраницаПоСсылке(Контекст, Регистр.ПланСчетов, Регистр.ПолноеИмяПланаСчетов, ТекстПолей);

	OneBase_Json.НачатьМассив(Запись, "items");
	Для Каждого Данные Из Страница.Строки Цикл
		Если Облегченно Тогда
			ЗаписатьВерсию(Контекст, Запись, Данные, Неопределено);
			Продолжить;
		КонецЕсли;
		Запись.ЗаписатьНачалоОбъекта();
		ЗаписатьОбщиеПоля(Запись, Данные);
		OneBase_Json.Свойство(Запись, "code", ЗначениеСтрокой(Контекст, Данные.Код));
		OneBase_Json.Свойство(Запись, "name", ЗначениеСтрокой(Контекст, Данные.Наименование));
		OneBase_Json.СвойствоЕслиЕсть(Запись, "parentCode", ЗначениеСтрокой(Контекст, Данные.КодРодителя));
		OneBase_Json.Свойство(Запись, "type", КодВидаСчета(Данные.Вид));
		OneBase_Json.Свойство(Запись, "offBalance", Данные.Забалансовый = Истина);
		OneBase_Json.Свойство(Запись, "currency", Данные.Валютный = Истина);
		OneBase_Json.Свойство(Запись, "quantity", Данные.Количественный = Истина);
		OneBase_Json.НачатьМассив(Запись, "subconto");
		ВидыСчета = ВидыСубконтоСчетов(Контекст).Получить(Данные.Ссылка);
		Если ВидыСчета <> Неопределено Тогда
			Для Номер = 1 По ВидыСчета.Количество() Цикл
				ВидСубконтоСчета = ВидыСчета[Номер - 1];
				Запись.ЗаписатьНачалоОбъекта();
				OneBase_Json.Свойство(Запись, "index", Номер);
				OneBase_Json.Свойство(Запись, "type", ИмяВидаСубконто(Контекст, ВидСубконтоСчета.Вид).Имя);
				OneBase_Json.Свойство(Запись, "turnoverOnly", ВидСубконтоСчета.ТолькоОбороты = Истина);
				Запись.ЗаписатьКонецОбъекта();
			КонецЦикла;
		КонецЕсли;
		Запись.ЗаписатьКонецМассива();
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	ЗаписатьСтраницу(Запись, Страница);

	Если ИтогиЗапрошены(Контекст) И НЕ Страница.ПоИдентификаторам Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(Т.Ссылка) КАК ЧислоЗаписей ИЗ " + Регистр.ПолноеИмяПланаСчетов + " КАК Т";
		ЗаписатьИтоги(Запись, ВыполнитьПодсчет(Запрос), Неопределено);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Функция КодВидаСчета(Вид)

	Если Вид = ВидСчета.Активный Тогда
		Возврат "active";
	ИначеЕсли Вид = ВидСчета.Пассивный Тогда
		Возврат "passive";
	КонецЕсли;
	Возврат "active_passive";

КонецФункции

// GET /v1/directories — какие справочники доступны и сколько в них элементов.
Процедура ВыгрузитьСписокСправочников(Контекст, Запись)

	Элементы = Новый Массив;
	Для Каждого Код Из СтрРазделить("organizations,counterparties,contracts,currencies,warehouses,departments,items", ",", Ложь) Цикл
		Описание = OneBase_Metadata.Сущность(Контекст, Код);
		Элементы.Добавить(Новый Структура("Вид, Метод, Найден, Имя, ПолноеИмя, Персональный",
			Код, "/v1/" + Код, Описание.Найден, Описание.Имя, Описание.ПолноеИмя, Описание.Персональный));
	КонецЦикла;

	Регистр = OneBase_Metadata.Регистр(Контекст);
	Элементы.Добавить(Новый Структура("Вид, Метод, Найден, Имя, ПолноеИмя, Персональный",
		"accounts", "/v1/accounts", Регистр.Найден, ?(Регистр.Найден, Регистр.ПланСчетов.Имя, ""),
		Регистр.ПолноеИмяПланаСчетов, Ложь));

	Для Каждого Настройка Из OneBase_Settings.ПрочиеСправочники() Цикл
		Описание = OneBase_Metadata.ПрочийСправочник(Контекст, Настройка.Ключ);
		Элементы.Добавить(Новый Структура("Вид, Метод, Найден, Имя, ПолноеИмя, Персональный",
			Настройка.Ключ, "/v1/references?kind=" + Настройка.Ключ, Описание.Найден, Описание.Имя, Описание.ПолноеИмя,
			Описание.Персональный));
	КонецЦикла;

	// Количество элементов — одним запросом по всем найденным справочникам.
	Части = Новый Массив;
	Для Индекс = 0 По Элементы.ВГраница() Цикл
		Элемент = Элементы[Индекс];
		Если Элемент.Найден И НЕ Элемент.Персональный Тогда
			Части.Добавить("ВЫБРАТЬ " + OneBase_Json.ЧислоСтрокой(Индекс) + " КАК Индекс, КОЛИЧЕСТВО(Т.Ссылка) КАК ЧислоЗаписей ИЗ "
				+ Элемент.ПолноеИмя + " КАК Т");
		КонецЕсли;
	КонецЦикла;
	Количества = Новый Соответствие;
	Если Части.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = СтрСоединить(Части, " ОБЪЕДИНИТЬ ВСЕ ");
		Для Каждого Данные Из Запрос.Выполнить().Выгрузить() Цикл
			Количества.Вставить(Данные.Индекс, Данные.ЧислоЗаписей);
		КонецЦикла;
	КонецЕсли;

	НачатьОтвет(Запись);
	OneBase_Json.НачатьМассив(Запись, "items");
	Для Индекс = 0 По Элементы.ВГраница() Цикл
		Элемент = Элементы[Индекс];
		Запись.ЗаписатьНачалоОбъекта();
		OneBase_Json.Свойство(Запись, "kind", Элемент.Вид);
		OneBase_Json.Свойство(Запись, "method", Элемент.Метод);
		OneBase_Json.Свойство(Запись, "catalog", ?(Элемент.Найден, Элемент.Имя, Неопределено));
		OneBase_Json.Свойство(Запись, "available", Элемент.Найден И НЕ Элемент.Персональный);
		Если Элемент.Персональный Тогда
			OneBase_Json.Свойство(Запись, "personal", Истина);
		КонецЕсли;
		OneBase_Json.СвойствоЕслиЕсть(Запись, "count", Количества.Получить(Индекс));
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Функция ПрочийСправочникИзПараметра(Контекст)

	Вид = ОбязательныйПараметр(Контекст, "kind");
	Описание = OneBase_Metadata.ПрочийСправочник(Контекст, Вид);
	Если Описание = Неопределено Тогда
		Виды = Новый Массив;
		Для Каждого Настройка Из OneBase_Settings.ПрочиеСправочники() Цикл
			Виды.Добавить(Настройка.Ключ);
		КонецЦикла;
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter",
			"Параметр kind: неизвестный вид справочника. Допустимо: " + СтрСоединить(Виды, ", "), "kind");
	КонецЕсли;
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область КурсыВалют

// GET /v1/exchange-rates?from=&to=&currency= — спецификация 4.6. Курсор — смещение (таблица курсов небольшая).
Процедура ВыгрузитьКурсы(Контекст, Запись)

	Если Параметр(Контекст, "ids") <> "" Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter",
			"Параметр ids не применяется к /exchange-rates: ключ курса — валюта и дата (используйте from, to, currency).", "ids");
	КонецЕсли;

	Курсы = OneBase_Metadata.КурсыВалют(Контекст);
	Период = ПараметрПериод(Контекст, Ложь);
	ОтборВалют = ПараметрВалюты(Контекст);
	Лимит = ЛимитСтраницы(Контекст);

	НачатьОтвет(Запись);
	Если НЕ Курсы.Найден ИЛИ Курсы.Валюта = "" ИЛИ Курсы.Курс = "" ИЛИ НЕ Курсы.Периодический Тогда
		ЗаписатьПустойСписок(Контекст, Запись, "Регистр курсов валют не найден или не подходит (кандидаты: " + Курсы.Кандидаты
			+ "). Настройте OneBase_Settings.КурсыВалют по GET /v1/metadata.");
		Запись.ЗаписатьКонецОбъекта();
		Возврат;
	КонецЕсли;

	Смещение = 0;
	Курсор = ПрочитатьКурсор(Контекст);
	Если Курсор <> Неопределено Тогда
		Смещение = ЧислоИзКурсора(Курсор, "o");
	КонецЕсли;

	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Если Период.Начало <> Неопределено Тогда
		Условия.Добавить("Р.Период >= &НачалоПериода");
		Запрос.УстановитьПараметр("НачалоПериода", Период.Начало);
	КонецЕсли;
	Если Период.Конец <> Неопределено Тогда
		Условия.Добавить("Р.Период <= &КонецПериода");
		Запрос.УстановитьПараметр("КонецПериода", Период.Конец);
	КонецЕсли;
	Если ОтборВалют <> Неопределено Тогда
		Условия.Добавить("Р." + Курсы.Валюта + " В (&Валюты)");
		Запрос.УстановитьПараметр("Валюты", ОтборВалют);
	КонецЕсли;

	Поля = "Р.Период КАК Период, Р." + Курсы.Валюта + " КАК Валюта, Р." + Курсы.Курс + " КАК Курс, "
		+ ?(Курсы.Кратность = "", "1", "Р." + Курсы.Кратность) + " КАК Кратность";
	Если Курсы.Источник <> Неопределено Тогда
		Поля = Поля + ", Р." + Курсы.Источник.Имя + " КАК Источник";
		Если Курсы.Источник.ЕстьСсылки Тогда
			Поля = Поля + ", ПРЕДСТАВЛЕНИЕ(Р." + Курсы.Источник.Имя + ") КАК ИсточникП";
		КонецЕсли;
	КонецЕсли;
	Порядок = "Р.Период, Р." + Курсы.Валюта;
	Для Каждого Измерение Из Курсы.ПрочиеИзмерения Цикл
		Порядок = Порядок + ", Р." + Измерение;
	КонецЦикла;

	Где = ТекстГде(Условия);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + OneBase_Json.ЧислоСтрокой(Смещение + Лимит + 1) + " " + Поля
		+ " ИЗ " + Курсы.ПолноеИмя + " КАК Р" + Где + " УПОРЯДОЧИТЬ ПО " + Порядок;
	Таблица = Запрос.Выполнить().Выгрузить();

	Последний = Мин(Смещение + Лимит, Таблица.Количество()) - 1;
	OneBase_Json.НачатьМассив(Запись, "items");
	Для Номер = Смещение По Последний Цикл
		Данные = Таблица[Номер];
		Запись.ЗаписатьНачалоОбъекта();
		OneBase_Json.Свойство(Запись, "currency", КодВалюты(Контекст, Данные.Валюта));
		OneBase_Json.Свойство(Запись, "date", OneBase_Json.ДатаБезВремени(Данные.Период));
		OneBase_Json.Свойство(Запись, "rate", OneBase_Json.Округлить(Данные.Курс, 4));
		OneBase_Json.Свойство(Запись, "multiplier", ?(ТипЗнч(Данные.Кратность) = Тип("Число"), Цел(Данные.Кратность), Неопределено));
		Если Курсы.Источник <> Неопределено Тогда
			Представление = ?(Курсы.Источник.ЕстьСсылки, Данные.ИсточникП, Неопределено);
			OneBase_Json.СвойствоЕслиЕсть(Запись, "source", ПривестиЗначение(Контекст, Данные.Источник, Представление, "Строка", Неопределено));
		КонецЕсли;
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

	Страница = ПустаяСтраница(Контекст);
	Если Таблица.Количество() > Смещение + Лимит Тогда
		Страница.ЕстьЕще = Истина;
		Страница.Курсор = OneBase_Json.КурсорВСтроку(Контекст.Метод, Новый Структура("o", Смещение + Лимит));
	КонецЕсли;
	ЗаписатьСтраницу(Запись, Страница);

	Если ИтогиЗапрошены(Контекст) Тогда
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК ЧислоЗаписей ИЗ " + Курсы.ПолноеИмя + " КАК Р" + Где;
		ЗаписатьИтоги(Запись, ВыполнитьПодсчет(Запрос), Неопределено);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

// Параметр currency=USD,EUR → массив ссылок на валюты; неизвестный код — 400.
Функция ПараметрВалюты(Контекст)

	Значение = Параметр(Контекст, "currency");
	Если Значение = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	СправочникВалют = Валюты(Контекст);
	Результат = Новый Массив;
	Для Каждого Код Из OneBase_Metadata.Кандидаты(Значение) Цикл
		Ссылка = СправочникВалют.ПоКоду.Получить(ВРег(Код));
		Если Ссылка = Неопределено Тогда
			OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter",
				"Параметр currency: валюта «" + Лев(Код, 10) + "» не найдена в справочнике валют.", "currency");
		КонецЕсли;
		Результат.Добавить(Ссылка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Документы

// GET /v1/documents — спецификация 4.9 (а также /sales, /purchases, /warehouse, /finance, /production).
Процедура ВыгрузитьДокументы(Контекст, Запись)

	Типы = ЗапрошенныеТипы(Контекст);
	Организация = ПараметрОрганизация(Контекст, Ложь);
	Период = ПараметрПериод(Контекст, Ложь);
	СПроводками = ПараметрБулево(Контекст, "withEntries", Ложь);
	Идентификаторы = ПараметрИдентификаторы(Контекст);

	Описания = ОтобратьДокументы(Контекст, Типы, Организация, Ложь);
	Отбор = Новый Структура("Начало, Конец, Организация", Период.Начало, Период.Конец, Организация);

	Если Идентификаторы <> Неопределено Тогда
		Страница = ДокументыПоИдентификаторам(Контекст, Описания, Идентификаторы, "Документы");
	Иначе
		Страница = СтраницаДокументов(Контекст, Описания, Отбор, "Документы");
	КонецЕсли;

	СтрокиДокументов = ПрочитатьСтрокиДокументов(Контекст, Страница.Строки);
	Проводки = Неопределено;
	Если СПроводками Тогда
		Проводки = ПроводкиРегистраторов(Контекст, Регистраторы(Страница.Строки), Неопределено);
		ЗаполнитьПредставленияСубконто(Контекст, Проводки, Страница.Строки);
	КонецЕсли;

	НачатьОтвет(Запись);
	OneBase_Json.НачатьМассив(Запись, "items");
	Для Каждого Элемент Из Страница.Строки Цикл
		ЗаписатьДокумент(Контекст, Запись, Элемент, СтрокиДокументов, Проводки);
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	ЗаписатьСтраницу(Запись, Страница);

	Если ИтогиЗапрошены(Контекст) И Идентификаторы = Неопределено Тогда
		Итоги = ИтогиДокументов(Контекст, Описания, Отбор);
		ЗаписатьИтоги(Запись, Итоги.ЧислоЗаписей, Итоги.Сумма);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Процедура ЗаписатьДокумент(Контекст, Запись, Элемент, СтрокиДокументов, Проводки)

	Описание = Элемент.Описание;
	Данные = Элемент.Данные;

	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьОбщиеПоля(Запись, Данные);
	OneBase_Json.Свойство(Запись, "type", Описание.Тип);
	OneBase_Json.Свойство(Запись, "sourceType", Описание.Имя);
	OneBase_Json.Свойство(Запись, "number", ЗначениеСтрокой(Контекст, Данные.Номер));
	OneBase_Json.Свойство(Запись, "date", OneBase_Json.ДатаВремя(Данные.Дата, Контекст.Смещение));
	OneBase_Json.Свойство(Запись, "posted", Данные.Проведен = Истина);
	ЗаписатьПоля(Контекст, Запись, Данные, Описание.Поля, "currency,amountAccounting");

	Валюта = ВалютаДокумента(Контекст, Описание, Данные);
	OneBase_Json.СвойствоЕслиЕсть(Запись, "currency", Валюта.Код);
	OneBase_Json.СвойствоЕслиЕсть(Запись, "amountAccounting", СуммаВВалютеУчета(Контекст, Описание, Данные, Валюта));
	Если Валюта.Код <> Неопределено И НЕ Валюта.ЭтоВалютаУчета Тогда
		ЗначениеКурса = ЗначениеНайденногоПоля(Контекст, Данные, Описание.Поля, "_rateValue");
		Если ЗначениеКурса <> Неопределено И ЗначениеКурса > 0 Тогда
			Кратность = ЗначениеНайденногоПоля(Контекст, Данные, Описание.Поля, "_rateMultiplier");
			OneBase_Json.НачатьОбъект(Запись, "rate");
			OneBase_Json.Свойство(Запись, "value", ЗначениеКурса);
			Если Кратность <> Неопределено И Кратность > 0 Тогда
				OneBase_Json.Свойство(Запись, "multiplier", Кратность);
			КонецЕсли;
			Запись.ЗаписатьКонецОбъекта();
		КонецЕсли;
	КонецЕсли;

	Если Описание.ТабличныеЧасти.Количество() > 0 Тогда
		OneBase_Json.НачатьМассив(Запись, "lines");
		Список = СтрокиДокументов.Получить(Данные.Ссылка);
		Если Список <> Неопределено Тогда
			Номер = 0;
			Для Каждого Строчка Из Список Цикл
				Номер = Номер + 1;
				Запись.ЗаписатьНачалоОбъекта();
				OneBase_Json.Свойство(Запись, "lineNumber", Номер);
				ЗаписатьПоля(Контекст, Запись, Строчка.Данные, Строчка.Часть.Поля, "");
				OneBase_Json.Свойство(Запись, "section", Строчка.Часть.Имя);
				OneBase_Json.Свойство(Запись, "sectionLineNumber", Строчка.Данные.НомерСтроки);
				Запись.ЗаписатьКонецОбъекта();
			КонецЦикла;
		КонецЕсли;
		Запись.ЗаписатьКонецМассива();
	КонецЕсли;

	Если Проводки <> Неопределено Тогда
		OneBase_Json.НачатьМассив(Запись, "entries");
		Список = Проводки.Получить(Данные.Ссылка);
		Если Список <> Неопределено И Данные.Проведен = Истина Тогда
			Для Каждого Проводка Из Список Цикл
				ЗаписатьПроводку(Контекст, Запись, Проводка);
			КонецЦикла;
		КонецЕсли;
		Запись.ЗаписатьКонецМассива();
	КонецЕсли;

	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

// Валюта документа: Структура(Код, ЭтоВалютаУчета).
Функция ВалютаДокумента(Контекст, Описание, Данные)

	ВалютаБазы = ВалютаУчета(Контекст);
	Результат = Новый Структура("Код, ЭтоВалютаУчета", Неопределено, Ложь);
	Поле = Описание.ПоляПоИмени.Получить("currency");
	Если Поле <> Неопределено Тогда
		Ссылка = Данные[Поле.Псевдоним];
		Результат.Код = КодВалюты(Контекст, Ссылка);
		Результат.ЭтоВалютаУчета = ВалютаБазы.Ссылка <> Неопределено И Ссылка = ВалютаБазы.Ссылка;
	ИначеЕсли Описание.ВалютаПоУмолчанию Тогда
		Результат.Код = ВалютаБазы.Код;
		Результат.ЭтоВалютаУчета = Истина;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// amountAccounting по правилу нормализатора OneBase (OneCNormalizer), без пересчёта текущим курсом:
//   1) реквизит суммы в валюте учёта, если он найден;
//   2) иначе документ в валюте учёта или без валюты (OneBase считает такой документ документом в UZS) — amount;
//   3) иначе, если у документа есть курс (rate) — amount × rate.value / max(1, rate.multiplier), округлено до 2 знаков
//      «к чётному» (как Math.Round в OneBase); amount, курс и кратность — те же значения, что уходят в JSON;
//   4) иначе — не выгружается.
// Итоги /documents (ИтогиДокументов) складывают ровно это значение по каждому документу.
Функция СуммаВВалютеУчета(Контекст, Описание, Данные, Валюта)

	Если Описание.ИсточникСуммыРегл = "Реквизит" Тогда
		Возврат ЗначениеПоля(Контекст, Данные, Описание.ПоляПоИмени.Получить("amountAccounting"));
	ИначеЕсли Описание.ИсточникСуммыРегл <> "Сумма" Тогда
		Возврат Неопределено;
	КонецЕсли;

	СуммаДокумента = ЗначениеПоля(Контекст, Данные, Описание.ПоляПоИмени.Получить("amount"));
	Если СуммаДокумента = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли Валюта.ЭтоВалютаУчета ИЛИ Валюта.Код = Неопределено Тогда
		Возврат СуммаДокумента;
	КонецЕсли;

	ЗначениеКурса = ЗначениеНайденногоПоля(Контекст, Данные, Описание.Поля, "_rateValue");
	Если ЗначениеКурса = Неопределено ИЛИ ЗначениеКурса <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Кратность = ЗначениеНайденногоПоля(Контекст, Данные, Описание.Поля, "_rateMultiplier");
	Делитель = ?(Кратность = Неопределено ИЛИ Кратность < 1, 1, Кратность);
	Возврат ОкруглитьКЧетному(СуммаДокумента * ЗначениеКурса / Делитель);

КонецФункции

// Округление до 2 знаков, середина — к чётной копейке (как Math.Round(decimal, 2) в .NET, которым считает OneBase).
Функция ОкруглитьКЧетному(Значение)

	Сдвинутое = Значение * 100;
	ЦелаяЧасть = Цел(Сдвинутое);
	Дробная = Сдвинутое - ЦелаяЧасть;
	Если Дробная = 0.5 ИЛИ Дробная = -0.5 Тогда
		Если ЦелаяЧасть % 2 = 0 Тогда
			Возврат ЦелаяЧасть / 100;
		КонецЕсли;
		Возврат (ЦелаяЧасть + ?(Дробная > 0, 1, -1)) / 100;
	КонецЕсли;
	Возврат Окр(Сдвинутое, 0) / 100;

КонецФункции

// Итоги /documents: число документов и сумма amountAccounting (так сверяет OneBase). Сумма считается в 1С по каждому
// документу той же функцией СуммаВВалютеУчета, что и в ответе, поэтому совпадает с суммой загруженных документов.
// Сумма не выгружается, если ни у одного вида документов нет ни реквизита суммы в валюте учёта, ни суммы документа.
Функция ИтогиДокументов(Контекст, Описания, Отбор)

	Результат = Новый Структура("ЧислоЗаписей, Сумма", 0, Неопределено);
	Сумма = 0;
	ЕстьСумма = Ложь;
	Для Каждого Описание Из Описания Цикл
		Запрос = Новый Запрос;
		УстановитьПараметрыОтбора(Запрос, Отбор);
		Где = ТекстГде(УсловияДокументов(Описание, Отбор));
		Если Описание.ИсточникСуммыРегл = "" Тогда
			Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(Т.Ссылка) КАК ЧислоЗаписей ИЗ " + Описание.ПолноеИмя + " КАК Т" + Где;
			Результат.ЧислоЗаписей = Результат.ЧислоЗаписей + ВыполнитьПодсчет(Запрос);
			Продолжить;
		КонецЕсли;
		ЕстьСумма = Истина;
		ПоляСуммы = Новый Массив;
		Для Каждого Имя Из СтрРазделить("amountAccounting,amount,currency,_rateValue,_rateMultiplier", ",", Ложь) Цикл
			Поле = Описание.ПоляПоИмени.Получить(Имя);
			Если Поле <> Неопределено Тогда
				ПоляСуммы.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
		Запрос.Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка" + ТекстПолейЗапроса(Контекст, ПоляСуммы, "Т")
			+ " ИЗ " + Описание.ПолноеИмя + " КАК Т" + Где;
		Для Каждого Данные Из Запрос.Выполнить().Выгрузить() Цикл
			Результат.ЧислоЗаписей = Результат.ЧислоЗаписей + 1;
			Значение = СуммаВВалютеУчета(Контекст, Описание, Данные, ВалютаДокумента(Контекст, Описание, Данные));
			Если Значение <> Неопределено Тогда
				Сумма = Сумма + Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ЕстьСумма Тогда
		Результат.Сумма = Окр(Сумма, 2);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Строки документов страницы: Соответствие (документ → массив Структура(Часть, Данные)) в порядке частей и номеров строк.
Функция ПрочитатьСтрокиДокументов(Контекст, Элементы)

	Результат = Новый Соответствие;
	Группы = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.Описание.ТабличныеЧасти.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Группа = Группы.Получить(Элемент.Описание.Имя);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Описание, Ссылки", Элемент.Описание, Новый Массив);
			Группы.Вставить(Элемент.Описание.Имя, Группа);
		КонецЕсли;
		Группа.Ссылки.Добавить(Элемент.Данные.Ссылка);
	КонецЦикла;

	Для Каждого ЭлементГруппы Из Группы Цикл
		Группа = ЭлементГруппы.Значение;
		Тексты = Новый Массив;
		Для Каждого Часть Из Группа.Описание.ТабличныеЧасти Цикл
			Тексты.Добавить("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.НомерСтроки КАК НомерСтроки"
				+ ТекстПолейЗапроса(Контекст, Часть.Поля, "Т")
				+ " ИЗ " + Часть.ПолноеИмя + " КАК Т ГДЕ Т.Ссылка В (&Ссылки) УПОРЯДОЧИТЬ ПО Т.Ссылка, Т.НомерСтроки");
		КонецЦикла;
		Запрос = Новый Запрос;
		Запрос.Текст = СтрСоединить(Тексты, ";" + Символы.ПС);
		Запрос.УстановитьПараметр("Ссылки", Группа.Ссылки);
		Результаты = Запрос.ВыполнитьПакет();
		Для Индекс = 0 По Результаты.ВГраница() Цикл
			Часть = Группа.Описание.ТабличныеЧасти[Индекс];
			Для Каждого Данные Из Результаты[Индекс].Выгрузить() Цикл
				Список = Результат.Получить(Данные.Ссылка);
				Если Список = Неопределено Тогда
					Список = Новый Массив;
					Результат.Вставить(Данные.Ссылка, Список);
				КонецЕсли;
				Список.Добавить(Новый Структура("Часть, Данные", Часть, Данные));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Описания документов для метода. ДляПроводок — все документы, пишущие в регистр бухгалтерии (кроме исключённых).
// Иначе — по типам (Неопределено — все), без «прочих», если они выключены, и только с реквизитом организации,
// если задан отбор по организации.
Функция ОтобратьДокументы(Контекст, Типы, Организация, ДляПроводок)

	Результат = Новый Массив;
	ВыгружатьПрочие = OneBase_Settings.ВыгружатьПрочиеДокументы();
	Для Каждого Описание Из OneBase_Metadata.ОписанияДокументов(Контекст) Цикл
		Если ДляПроводок Тогда
			Если НЕ Описание.Регистратор Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			Если Описание.Прочий И НЕ ВыгружатьПрочие Тогда
				Продолжить;
			КонецЕсли;
			Если Типы <> Неопределено И Типы.Найти(Описание.Тип) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Организация <> Неопределено И Описание.РеквизитОрганизации = "" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Типы документов из параметра type (через запятую) с учётом псевдонима (/sales и т.п.). Неопределено — все типы.
Функция ЗапрошенныеТипы(Контекст)

	Допустимые = OneBase_Metadata.КодыТиповДокументов();
	ТипыПсевдонима = OneBase_Metadata.Кандидаты(Контекст.ТипыПсевдонима);
	Значение = НРег(Параметр(Контекст, "type"));
	Если Значение = "" Тогда
		Возврат ?(ТипыПсевдонима.Количество() = 0, Неопределено, ТипыПсевдонима);
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Код Из OneBase_Metadata.Кандидаты(Значение) Цикл
		Если Допустимые.Найти(Код) = Неопределено Тогда
			OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр type: неизвестный тип «" + Лев(Код, 30)
				+ "». Допустимо: " + СтрСоединить(Допустимые, ", "), "type");
		КонецЕсли;
		Если ТипыПсевдонима.Количество() > 0 И ТипыПсевдонима.Найти(Код) = Неопределено Тогда
			OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр type: тип «" + Код
				+ "» не относится к этому адресу. Допустимо: " + СтрСоединить(ТипыПсевдонима, ", "), "type");
		КонецЕсли;
		Результат.Добавить(Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Страница документов по видам документов (в порядке описаний), внутри вида — по дате и ссылке.
// Режим: "Документы" (все поля), "Версии" (лёгкие поля), "Наборы" (поля регистратора, отбор — по проводкам).
// Курсор: {m: имя документа, d: дата, r: ссылка последнего документа} или {m: имя документа} — начать с этого вида.
Функция СтраницаДокументов(Контекст, Описания, Отбор, Режим)

	Лимит = ЛимитСтраницы(Контекст);
	Результат = ПустаяСтраница(Контекст);
	Результат.Строки = Новый Массив;

	Начало = 0;
	Ключ = Неопределено;
	Курсор = ПрочитатьКурсор(Контекст);
	Если Курсор <> Неопределено Тогда
		ИмяДокумента = СтрокаИзКурсора(Курсор, "m");
		Начало = -1;
		Для Индекс = 0 По Описания.ВГраница() Цикл
			Если Описания[Индекс].Имя = ИмяДокумента Тогда
				Начало = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Начало < 0 Тогда
			ОшибкаКурсора();
		КонецЕсли;
		Если Курсор.Свойство("r") Тогда
			Ключ = Новый Структура("Дата, Ссылка", ДатаИзКурсора(Курсор, "d"),
				Документы[ИмяДокумента].ПолучитьСсылку(УИДИзКурсора(Курсор, "r")));
		КонецЕсли;
	КонецЕсли;

	Осталось = Лимит;
	Для Индекс = Начало По Описания.ВГраница() Цикл
		Описание = Описания[Индекс];
		Если Осталось = 0 Тогда
			Результат.ЕстьЕще = Истина;
			Результат.Курсор = OneBase_Json.КурсорВСтроку(Контекст.Метод, Новый Структура("m", Описание.Имя));
			Прервать;
		КонецЕсли;
		КлючВида = ?(Индекс = Начало, Ключ, Неопределено);
		Таблица = ВыбратьДокументы(Контекст, Описание, Отбор, Режим, КлючВида, Осталось + 1, Неопределено);
		Для Каждого Данные Из Таблица Цикл
			Если Осталось = 0 Тогда
				Результат.ЕстьЕще = Истина;
				Результат.Курсор = КурсорДокумента(Контекст, Результат.Строки[Результат.Строки.ВГраница()]);
				Прервать;
			КонецЕсли;
			Результат.Строки.Добавить(Новый Структура("Описание, Данные", Описание, Данные));
			Осталось = Осталось - 1;
		КонецЦикла;
		Если Результат.ЕстьЕще Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Документы по ids= (не больше 100): ищутся по видам по очереди, пока не найдены все. Удалённых в ответе нет.
Функция ДокументыПоИдентификаторам(Контекст, Описания, Идентификаторы, Режим)

	Результат = ПустаяСтраница(Контекст);
	Результат.Строки = Новый Массив;
	Результат.ПоИдентификаторам = Истина;

	БезОтбора = Новый Структура("Начало, Конец, Организация");
	Осталось = Идентификаторы.Количество();
	Для Каждого Описание Из Описания Цикл
		Если Осталось = 0 Тогда
			Прервать;
		КонецЕсли;
		Ссылки = СсылкиПоИдентификаторам(OneBase_Metadata.Менеджер(Описание.Мета), Идентификаторы);
		Таблица = ВыбратьДокументы(Контекст, Описание, БезОтбора, Режим, Неопределено, Неопределено, Ссылки);
		Для Каждого Данные Из Таблица Цикл
			Результат.Строки.Добавить(Новый Структура("Описание, Данные", Описание, Данные));
			Осталось = Осталось - 1;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Запрос к таблице одного вида документов.
Функция ВыбратьДокументы(Контекст, Описание, Отбор, Режим, Ключ, Количество, Ссылки)

	Запрос = Новый Запрос;
	УстановитьПараметрыОтбора(Запрос, Отбор);

	Условия = Новый Массив;
	Если Ссылки <> Неопределено Тогда
		Условия.Добавить("Т.Ссылка В (&Ссылки)");
		Запрос.УстановитьПараметр("Ссылки", Ссылки);
	ИначеЕсли Режим = "Наборы" Тогда
		Условия.Добавить(УсловиеНаборов(Контекст, Описание, Отбор));
	Иначе
		Для Каждого Условие Из УсловияДокументов(Описание, Отбор) Цикл
			Условия.Добавить(Условие);
		КонецЦикла;
	КонецЕсли;

	Если Ключ <> Неопределено Тогда
		Условия.Добавить("(Т.Дата > &КлючДата ИЛИ Т.Дата = &КлючДата И Т.Ссылка > &КлючСсылка)");
		Запрос.УстановитьПараметр("КлючДата", Ключ.Дата);
		Запрос.УстановитьПараметр("КлючСсылка", Ключ.Ссылка);
	КонецЕсли;

	Первые = ?(Количество = Неопределено, "", "ПЕРВЫЕ " + OneBase_Json.ЧислоСтрокой(Количество) + " ");
	Запрос.Текст = "ВЫБРАТЬ " + Первые + ТекстПолейДокумента(Контекст, Описание, Режим)
		+ " ИЗ " + Описание.ПолноеИмя + " КАК Т" + ТекстГде(Условия)
		+ " УПОРЯДОЧИТЬ ПО Т.Дата, Т.Ссылка";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ТекстПолейДокумента(Контекст, Описание, Режим)

	Текст = "Т.Ссылка КАК Ссылка, Т.ВерсияДанных КАК Версия, Т.ПометкаУдаления КАК ПометкаУдаления, Т.Дата КАК Дата, "
		+ ?(Описание.ЕстьПроведение, "Т.Проведен", "ЛОЖЬ") + " КАК Проведен";
	Если Режим = "Версии" Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = Текст + ", " + ?(Описание.ЕстьНомер, "Т.Номер", """""") + " КАК Номер, "
		+ ?(Описание.РеквизитОрганизации = "", "НЕОПРЕДЕЛЕНО", "Т." + Описание.РеквизитОрганизации) + " КАК Организация";
	Если Режим = "Наборы" Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Текст + ТекстПолейЗапроса(Контекст, Описание.Поля, "Т");

КонецФункции

// Отбор документов по дате и организации (реквизит организации документа).
Функция УсловияДокументов(Описание, Отбор)

	Условия = Новый Массив;
	Если Отбор.Начало <> Неопределено Тогда
		Условия.Добавить("Т.Дата >= &НачалоПериода");
	КонецЕсли;
	Если Отбор.Конец <> Неопределено Тогда
		Условия.Добавить("Т.Дата <= &КонецПериода");
	КонецЕсли;
	Если Отбор.Организация <> Неопределено И Описание.РеквизитОрганизации <> "" Тогда
		Условия.Добавить("Т." + Описание.РеквизитОрганизации + " = &Организация");
	КонецЕсли;
	Возврат Условия;

КонецФункции

// Отбор документов для /entries: есть проводки в периоде (по периоду проводки, а не дате документа) и по организации
// (измерение регистра); плюс непроведённые документы периода — для пустых наборов (OneBase_Settings.ПустыеНаборыНепроведенных).
Функция УсловиеНаборов(Контекст, Описание, Отбор)

	Регистр = OneBase_Metadata.Регистр(Контекст);
	Подусловия = Новый Массив;
	Подусловия.Добавить("Р.Регистратор ССЫЛКА " + Описание.ПолноеИмя);
	Если Отбор.Начало <> Неопределено Тогда
		Подусловия.Добавить("Р.Период >= &НачалоПериода");
	КонецЕсли;
	Если Отбор.Конец <> Неопределено Тогда
		Подусловия.Добавить("Р.Период <= &КонецПериода");
	КонецЕсли;
	Если Отбор.Организация <> Неопределено И Регистр.Организация <> Неопределено Тогда
		Подусловия.Добавить(УсловиеОрганизацииРегистра(Регистр, "Р."));
	КонецЕсли;
	Текст = "Т.Ссылка В (ВЫБРАТЬ Р.Регистратор ИЗ " + Регистр.ПолноеИмя + " КАК Р ГДЕ " + СтрСоединить(Подусловия, " И ") + ")";

	Если OneBase_Settings.ПустыеНаборыНепроведенных() И Описание.ЕстьПроведение
		И (Отбор.Организация = Неопределено ИЛИ Описание.РеквизитОрганизации <> "") Тогда
		Непроведенные = УсловияДокументов(Описание, Отбор);
		Непроведенные.Вставить(0, "НЕ Т.Проведен");
		Текст = "(" + Текст + " ИЛИ " + СтрСоединить(Непроведенные, " И ") + ")";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Процедура УстановитьПараметрыОтбора(Запрос, Отбор)

	Если Отбор.Начало <> Неопределено Тогда
		Запрос.УстановитьПараметр("НачалоПериода", Отбор.Начало);
	КонецЕсли;
	Если Отбор.Конец <> Неопределено Тогда
		Запрос.УстановитьПараметр("КонецПериода", Отбор.Конец);
	КонецЕсли;
	Если Отбор.Организация <> Неопределено Тогда
		Запрос.УстановитьПараметр("Организация", Отбор.Организация);
	КонецЕсли;

КонецПроцедуры

Функция КурсорДокумента(Контекст, Элемент)
	Возврат OneBase_Json.КурсорВСтроку(Контекст.Метод, Новый Структура("m, d, r",
		Элемент.Описание.Имя, XMLСтрока(Элемент.Данные.Дата), XMLСтрока(Элемент.Данные.Ссылка)));
КонецФункции

// Ссылки документов страницы, которые пишут проводки и проведены.
Функция Регистраторы(Элементы)

	Результат = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.Описание.Регистратор И Элемент.Данные.Проведен = Истина Тогда
			Результат.Добавить(Элемент.Данные.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Проводки

// GET /v1/entries — спецификация 4.10: наборы проводок по документу-регистратору; страница не разрывает набор.
Процедура ВыгрузитьПроводки(Контекст, Запись)

	Регистр = ПроверенныйРегистр(Контекст);
	Организация = ПараметрОрганизация(Контекст, Ложь);
	Период = ПараметрПериод(Контекст, Ложь);
	Идентификаторы = ПараметрИдентификаторы(Контекст);

	Описания = ОтобратьДокументы(Контекст, Неопределено, Неопределено, Истина);
	Отбор = Новый Структура("Начало, Конец, Организация", Период.Начало, Период.Конец, Организация);
	ОрганизацияРегистра = ?(Регистр.Организация = Неопределено, Неопределено, Организация);

	Если Идентификаторы <> Неопределено Тогда
		Страница = ДокументыПоИдентификаторам(Контекст, Описания, Идентификаторы, "Наборы");
	Иначе
		Страница = СтраницаДокументов(Контекст, Описания, Отбор, "Наборы");
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого Элемент Из Страница.Строки Цикл
		Ссылки.Добавить(Элемент.Данные.Ссылка);
	КонецЦикла;
	Проводки = ПроводкиРегистраторов(Контекст, Ссылки, ОрганизацияРегистра);
	ОграничитьОбъемСтраницы(Контекст, Страница, Проводки);
	ЗаполнитьПредставленияСубконто(Контекст, Проводки, Страница.Строки);

	НачатьОтвет(Запись);
	OneBase_Json.НачатьМассив(Запись, "items");
	Для Каждого Элемент Из Страница.Строки Цикл
		ЗаписатьНабор(Контекст, Запись, Элемент, Проводки.Получить(Элемент.Данные.Ссылка), Организация);
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	ЗаписатьСтраницу(Запись, Страница);

	Если ИтогиЗапрошены(Контекст) И Идентификаторы = Неопределено Тогда
		Итоги = ИтогиПроводок(Контекст, Регистр, Отбор, ОрганизацияРегистра);
		ЗаписатьИтоги(Запись, Итоги.ЧислоЗаписей, Итоги.Сумма);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Процедура ЗаписатьНабор(Контекст, Запись, Элемент, Список, Организация)

	Регистр = OneBase_Metadata.Регистр(Контекст);
	Описание = Элемент.Описание;
	Данные = Элемент.Данные;

	Запись.ЗаписатьНачалоОбъекта();
	OneBase_Json.НачатьОбъект(Запись, "registrar");
	OneBase_Json.Свойство(Запись, "id", XMLСтрока(Данные.Ссылка));
	OneBase_Json.Свойство(Запись, "type", Описание.Тип);
	OneBase_Json.Свойство(Запись, "sourceType", Описание.Имя);
	OneBase_Json.Свойство(Запись, "number", ЗначениеСтрокой(Контекст, Данные.Номер));
	OneBase_Json.Свойство(Запись, "date", OneBase_Json.ДатаВремя(Данные.Дата, Контекст.Смещение));
	Запись.ЗаписатьКонецОбъекта();

	ИдОрганизации = Неопределено;
	Если Организация <> Неопределено Тогда
		ИдОрганизации = XMLСтрока(Организация);
	ИначеЕсли Список <> Неопределено И Список.Количество() > 0 И Регистр.Организация <> Неопределено Тогда
		ИдОрганизации = ИдСсылки(ЗначениеСтороны(Список[0], Регистр.Организация, "Дт"));
	КонецЕсли;
	Если ИдОрганизации = Неопределено Тогда
		ИдОрганизации = ИдСсылки(Данные.Организация);
	КонецЕсли;
	OneBase_Json.СвойствоЕслиЕсть(Запись, "organizationId", ИдОрганизации);
	OneBase_Json.Свойство(Запись, "version", Данные.Версия);
	OneBase_Json.Свойство(Запись, "posted", Данные.Проведен = Истина);

	OneBase_Json.НачатьМассив(Запись, "entries");
	Если Список <> Неопределено Тогда
		Для Каждого Проводка Из Список Цикл
			ЗаписатьПроводку(Контекст, Запись, Проводка);
		КонецЦикла;
	КонецЕсли;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Процедура ЗаписатьПроводку(Контекст, Запись, Данные)

	Регистр = OneBase_Metadata.Регистр(Контекст);
	Запись.ЗаписатьНачалоОбъекта();
	OneBase_Json.Свойство(Запись, "lineNumber", Данные.НомерСтроки);
	OneBase_Json.Свойство(Запись, "period", OneBase_Json.ДатаВремя(Данные.Период, Контекст.Смещение));
	OneBase_Json.Свойство(Запись, "active", Данные.Активность <> Ложь);
	OneBase_Json.Свойство(Запись, "amount", Окр(ЧислоИлиНоль(ЗначениеСтороны(Данные, Регистр.Сумма, "Дт")), 2));
	Если Регистр.Содержание <> "" Тогда
		OneBase_Json.СвойствоЕслиЕсть(Запись, "content", ЗначениеСтрокой(Контекст, Данные.Содержание));
	КонецЕсли;
	Если Регистр.Подразделение <> Неопределено Тогда
		Подразделение = ИдСсылки(ЗначениеСтороны(Данные, Регистр.Подразделение, "Дт"));
		Если Подразделение = Неопределено И НЕ Регистр.Подразделение.Балансовый Тогда
			Подразделение = ИдСсылки(ЗначениеСтороны(Данные, Регистр.Подразделение, "Кт"));
		КонецЕсли;
		OneBase_Json.СвойствоЕслиЕсть(Запись, "departmentId", Подразделение);
	КонецЕсли;
	ЗаписатьСторонуПроводки(Контекст, Запись, Данные, Регистр, "Дт", "debit");
	ЗаписатьСторонуПроводки(Контекст, Запись, Данные, Регистр, "Кт", "credit");
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Процедура ЗаписатьСторонуПроводки(Контекст, Запись, Данные, Регистр, Сторона, Имя)

	OneBase_Json.НачатьОбъект(Запись, Имя);
	OneBase_Json.Свойство(Запись, "account", КодСчета(Контекст, Данные["Счет" + Сторона]));

	КодВалютыСтороны = Неопределено;
	Если Регистр.Валюта <> Неопределено Тогда
		КодВалютыСтороны = КодВалюты(Контекст, ЗначениеСтороны(Данные, Регистр.Валюта, Сторона));
		OneBase_Json.СвойствоЕслиЕсть(Запись, "currency", КодВалютыСтороны);
	КонецЕсли;
	Если Регистр.ВалютнаяСумма <> Неопределено Тогда
		ВалютнаяСумма = ЗначениеСтороны(Данные, Регистр.ВалютнаяСумма, Сторона);
		Если ТипЗнч(ВалютнаяСумма) = Тип("Число") И (КодВалютыСтороны <> Неопределено ИЛИ ВалютнаяСумма <> 0) Тогда
			OneBase_Json.Свойство(Запись, "currencyAmount", Окр(ВалютнаяСумма, 2));
		КонецЕсли;
	КонецЕсли;
	Если Регистр.Количество <> Неопределено Тогда
		КоличествоСтороны = ЗначениеСтороны(Данные, Регистр.Количество, Сторона);
		Если ТипЗнч(КоличествоСтороны) = Тип("Число") И КоличествоСтороны <> 0 Тогда
			OneBase_Json.Свойство(Запись, "quantity", Окр(КоличествоСтороны, 3));
		КонецЕсли;
	КонецЕсли;
	Если Регистр.Подразделение <> Неопределено И НЕ Регистр.Подразделение.Балансовый Тогда
		OneBase_Json.СвойствоЕслиЕсть(Запись, "departmentId", ИдСсылки(ЗначениеСтороны(Данные, Регистр.Подразделение, Сторона)));
	КонецЕсли;

	Пары = Новый Массив;
	Для Номер = 1 По Регистр.МаксСубконто Цикл
		Суффикс = Сторона + OneBase_Json.ЧислоСтрокой(Номер);
		Пары.Добавить(Новый Структура("Индекс, Вид, Значение, Скрыто",
			Номер, Данные["ВидСубконто" + Суффикс], Данные["Субконто" + Суффикс], Ложь));
	КонецЦикла;
	ЗаписатьМассивСубконто(Контекст, Запись, Пары);

	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

// Проводки документов: Соответствие (регистратор → массив строк ДвиженияССубконто в порядке номеров строк).
// Набор — все проводки документа (без отбора по периоду), с отбором по организации, если он задан.
Функция ПроводкиРегистраторов(Контекст, Ссылки, Организация)

	Результат = Новый Соответствие;
	Регистр = OneBase_Metadata.Регистр(Контекст);
	Если Ссылки.Количество() = 0 ИЛИ НЕ Регистр.Поддерживается Тогда
		Возврат Результат;
	КонецЕсли;

	Условие = "Регистратор В (&Регистраторы)";
	Если Организация <> Неопределено И Регистр.Организация <> Неопределено Тогда
		Условие = Условие + " И " + УсловиеОрганизацииРегистра(Регистр, "");
	КонецЕсли;
	ПараметрыТаблицы = Новый Массив;
	ПараметрыТаблицы.Добавить("");
	ПараметрыТаблицы.Добавить("");
	ПараметрыТаблицы.Добавить(Условие);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ " + ТекстПолейПроводок(Регистр)
		+ " ИЗ " + ВиртуальнаяТаблица(Регистр.ПолноеИмя + ".ДвиженияССубконто", ПараметрыТаблицы) + " КАК Д"
		+ " ЛЕВОЕ СОЕДИНЕНИЕ " + Регистр.ПолноеИмя + " КАК Р"
		+ " ПО Р.Регистратор = Д.Регистратор И Р.НомерСтроки = Д.НомерСтроки"
		+ " УПОРЯДОЧИТЬ ПО Д.НомерСтроки";
	Запрос.УстановитьПараметр("Регистраторы", Ссылки);
	Запрос.УстановитьПараметр("Организация", Организация);

	Для Каждого Данные Из Запрос.Выполнить().Выгрузить() Цикл
		Список = Результат.Получить(Данные.Регистратор);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Данные.Регистратор, Список);
		КонецЕсли;
		Список.Добавить(Данные);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Поля ДвиженияССубконто: небалансовые измерения и ресурсы — парами <Имя>Дт/<Имя>Кт.
// Активность берётся из основной таблицы регистра (соединение по регистратору и номеру строки).
Функция ТекстПолейПроводок(Регистр)

	Поля = Новый Массив;
	Поля.Добавить("Д.Регистратор КАК Регистратор");
	Поля.Добавить("Д.НомерСтроки КАК НомерСтроки");
	Поля.Добавить("Д.Период КАК Период");
	Поля.Добавить("ЕСТЬNULL(Р.Активность, ИСТИНА) КАК Активность");
	Поля.Добавить("Д.СчетДт КАК СчетДт");
	Поля.Добавить("Д.СчетКт КАК СчетКт");
	ДобавитьПолеРегистра(Поля, Регистр.Сумма);
	ДобавитьПолеРегистра(Поля, Регистр.Организация);
	ДобавитьПолеРегистра(Поля, Регистр.Валюта);
	ДобавитьПолеРегистра(Поля, Регистр.Подразделение);
	ДобавитьПолеРегистра(Поля, Регистр.ВалютнаяСумма);
	ДобавитьПолеРегистра(Поля, Регистр.Количество);
	Если Регистр.Содержание <> "" Тогда
		Поля.Добавить("Д." + Регистр.Содержание + " КАК Содержание");
	КонецЕсли;
	Для Номер = 1 По Регистр.МаксСубконто Цикл
		Для Каждого Сторона Из СтрРазделить("Дт,Кт", ",", Ложь) Цикл
			Суффикс = Сторона + OneBase_Json.ЧислоСтрокой(Номер);
			Поля.Добавить("Д.ВидСубконто" + Суффикс + " КАК ВидСубконто" + Суффикс);
			Поля.Добавить("Д.Субконто" + Суффикс + " КАК Субконто" + Суффикс);
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Поля, ", ");

КонецФункции

Процедура ДобавитьПолеРегистра(Поля, Поле)

	Если Поле = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле.Балансовый Тогда
		Поля.Добавить("Д." + Поле.Имя + " КАК " + Поле.Имя);
	Иначе
		Поля.Добавить("Д." + Поле.Имя + "Дт КАК " + Поле.Имя + "Дт");
		Поля.Добавить("Д." + Поле.Имя + "Кт КАК " + Поле.Имя + "Кт");
	КонецЕсли;

КонецПроцедуры

// Значение поля регистра на стороне проводки ("Дт" или "Кт"): у балансового поля сторона не важна.
Функция ЗначениеСтороны(Данные, Поле, Сторона)

	Если Поле.Балансовый Тогда
		Возврат Данные[Поле.Имя];
	КонецЕсли;
	Возврат Данные[Поле.Имя + Сторона];

КонецФункции

// Условие по организации для таблицы регистра (Префикс "Р.") или параметра виртуальной таблицы (Префикс "").
Функция УсловиеОрганизацииРегистра(Регистр, Префикс)

	Имя = Регистр.Организация.Имя;
	Если Регистр.Организация.Балансовый Тогда
		Возврат Префикс + Имя + " = &Организация";
	КонецЕсли;
	Возврат "(" + Префикс + Имя + "Дт = &Организация ИЛИ " + Префикс + Имя + "Кт = &Организация)";

КонецФункции

// Страница заканчивается раньше, если проводок на ней больше OneBase_Settings.ПроводокНаСтраницеМаксимум().
// Набор не разрывается; хотя бы один набор на странице остаётся всегда.
Процедура ОграничитьОбъемСтраницы(Контекст, Страница, Проводки)

	Если Страница.ПоИдентификаторам Тогда
		Возврат;
	КонецЕсли;
	Максимум = OneBase_Settings.ПроводокНаСтраницеМаксимум();
	Всего = 0;
	Для Индекс = 0 По Страница.Строки.ВГраница() Цикл
		Список = Проводки.Получить(Страница.Строки[Индекс].Данные.Ссылка);
		Всего = Всего + ?(Список = Неопределено, 0, Список.Количество());
		Если Всего > Максимум И Индекс > 0 Тогда
			Оставить = Новый Массив;
			Для Номер = 0 По Индекс - 1 Цикл
				Оставить.Добавить(Страница.Строки[Номер]);
			КонецЦикла;
			Страница.Строки = Оставить;
			Страница.ЕстьЕще = Истина;
			Страница.Курсор = КурсорДокумента(Контекст, Страница.Строки[Страница.Строки.ВГраница()]);
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Итоги /entries: число проводок и сумма в валюте учёта по периоду проводки (так сверяет OneBase).
Функция ИтогиПроводок(Контекст, Регистр, Отбор, Организация)

	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Если Организация <> Неопределено Тогда
		Условия.Добавить(УсловиеОрганизацииРегистра(Регистр, ""));
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	Для Каждого ПолноеИмя Из OneBase_Metadata.ИсключенныеРегистраторы(Контекст) Цикл
		Условия.Добавить("НЕ Регистратор ССЫЛКА " + ПолноеИмя);
	КонецЦикла;

	ПараметрыТаблицы = Новый Массив;
	ПараметрыТаблицы.Добавить(?(Отбор.Начало = Неопределено, "", "&НачалоПериода"));
	ПараметрыТаблицы.Добавить(?(Отбор.Конец = Неопределено, "", "&КонецПериода"));
	ПараметрыТаблицы.Добавить(СтрСоединить(Условия, " И "));
	УстановитьПараметрыОтбора(Запрос, Новый Структура("Начало, Конец, Организация", Отбор.Начало, Отбор.Конец, Неопределено));

	ПолеСуммы = ?(Регистр.Сумма.Балансовый, "Д." + Регистр.Сумма.Имя, "Д." + Регистр.Сумма.Имя + "Дт");
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК ЧислоЗаписей, СУММА(" + ПолеСуммы + ") КАК СуммаИтог ИЗ "
		+ ВиртуальнаяТаблица(Регистр.ПолноеИмя + ".ДвиженияССубконто", ПараметрыТаблицы) + " КАК Д";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Новый Структура("ЧислоЗаписей, Сумма", ЧислоИлиНоль(Выборка.ЧислоЗаписей), Окр(ЧислоИлиНоль(Выборка.СуммаИтог), 2));

КонецФункции

// Коды и наименования значений субконто страницы — одним пакетом запросов (персональные не читаются).
Процедура ЗаполнитьПредставленияСубконто(Контекст, Проводки, Элементы)

	Регистр = OneBase_Metadata.Регистр(Контекст);
	Значения = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Список = Проводки.Получить(Элемент.Данные.Ссылка);
		Если Список = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Данные Из Список Цикл
			Для Номер = 1 По Регистр.МаксСубконто Цикл
				Для Каждого Сторона Из СтрРазделить("Дт,Кт", ",", Ложь) Цикл
					Суффикс = Сторона + OneBase_Json.ЧислоСтрокой(Номер);
					Вид = Данные["ВидСубконто" + Суффикс];
					Если ЗначениеЗаполнено(Вид) И НЕ ИмяВидаСубконто(Контекст, Вид).Персональный Тогда
						Значения.Добавить(Данные["Субконто" + Суффикс]);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ЗаполнитьПредставления(Контекст, Значения);

КонецПроцедуры

// Массив субконто: [{index, type, id, code, name}] или {index, type, hidden: true} для персональных данных.
Процедура ЗаписатьМассивСубконто(Контекст, Запись, Пары)

	OneBase_Json.НачатьМассив(Запись, "subconto");
	Для Каждого Пара Из Пары Цикл
		Если НЕ ЗначениеЗаполнено(Пара.Вид) Тогда
			Продолжить;
		КонецЕсли;
		ИмяВида = ИмяВидаСубконто(Контекст, Пара.Вид);
		Запись.ЗаписатьНачалоОбъекта();
		OneBase_Json.Свойство(Запись, "index", Пара.Индекс);
		OneBase_Json.Свойство(Запись, "type", ИмяВида.Имя);
		Если Пара.Скрыто ИЛИ ИмяВида.Персональный ИЛИ ЗначениеПерсональное(Контекст, Пара.Значение) Тогда
			OneBase_Json.Свойство(Запись, "hidden", Истина);
		Иначе
			ЗаписатьЗначениеСубконто(Контекст, Запись, Пара.Значение);
		КонецЕсли;
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();

КонецПроцедуры

Процедура ЗаписатьЗначениеСубконто(Контекст, Запись, Значение)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоПримитив(Значение) Тогда
		OneBase_Json.СвойствоЕслиЕсть(Запись, "name", ЗначениеСтрокой(Контекст, Значение));
		Возврат;
	КонецЕсли;
	Если ЭтоПустаяСсылка(Значение) Тогда
		Возврат;
	КонецЕсли;
	Инфо = ОписаниеТипа(Контекст, ТипЗнч(Значение));
	Представление = ПредставлениеСсылки(Контекст, Значение);
	Если Инфо.Класс <> "Перечисление" Тогда
		OneBase_Json.Свойство(Запись, "id", XMLСтрока(Значение));
	КонецЕсли;
	Если Представление <> Неопределено Тогда
		OneBase_Json.СвойствоЕслиЕсть(Запись, "code", Представление.Код);
		OneBase_Json.СвойствоЕслиЕсть(Запись, "name", Представление.Наименование);
	КонецЕсли;
	Если Инфо.ПолноеИмя <> "" Тогда
		OneBase_Json.Свойство(Запись, "valueType", Инфо.ПолноеИмя);
	КонецЕсли;

КонецПроцедуры

// Значение субконто — элемент справочника из списка персональных (например, ФизическиеЛица).
Функция ЗначениеПерсональное(Контекст, Значение)

	Если Значение = Неопределено ИЛИ Значение = Null ИЛИ ЭтоПримитив(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОписаниеТипа(Контекст, ТипЗнч(Значение)).Персональный;

КонецФункции

#КонецОбласти

#Область Остатки

// GET /v1/balances?organizationId=&period=ГГГГ-ММ&accounts=&subconto= — спецификация 4.11 (а также /turnovers).
// Строки — по ОстаткиИОбороты за месяц. Строки счетов с персональными субконто сворачиваются в 1С до разбиения
// на страницы (СвернутьПерсональныеСубконто): по людям строк нет, их значения из 1С не выходят.
Процедура ВыгрузитьОстатки(Контекст, Запись)

	Регистр = ПроверенныйРегистр(Контекст);
	Если Параметр(Контекст, "ids") <> "" Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter",
			"Параметр ids не применяется к /balances: строки остатков не являются объектами 1С.", "ids");
	КонецЕсли;
	НачалоМесяцаОстатков = ПараметрМесяц(Контекст);
	Организация = ПараметрОрганизация(Контекст, Ложь);
	ССубконто = ПараметрБулево(Контекст, "subconto", Истина);
	СписокСчетов = СчетаОстатков(Контекст, ССубконто);

	Отбор = Новый Структура("Начало, Конец, Организация", НачалоМесяцаОстатков, КонецМесяца(НачалоМесяцаОстатков),
		?(Регистр.Организация = Неопределено, Неопределено, Организация));
	Страница = СтраницаОстатков(Контекст, Регистр, СписокСчетов, Отбор);

	Значения = Новый Массив;
	Для Каждого Элемент Из Страница.Строки Цикл
		Для Каждого ВидСубконтоСчета Из Элемент.Счет.Виды Цикл
			Если НЕ ВидСубконтоСчета.Скрыто Тогда
				Значения.Добавить(Элемент.Данные["Субконто" + OneBase_Json.ЧислоСтрокой(ВидСубконтоСчета.Индекс)]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ЗаполнитьПредставления(Контекст, Значения);

	ПериодСтрокой = OneBase_Json.ГодМесяц(НачалоМесяцаОстатков);
	ИдОрганизации = ?(Организация = Неопределено, Неопределено, XMLСтрока(Организация));

	НачатьОтвет(Запись);
	OneBase_Json.НачатьМассив(Запись, "items");
	Для Каждого Элемент Из Страница.Строки Цикл
		Данные = Элемент.Данные;
		Запись.ЗаписатьНачалоОбъекта();
		OneBase_Json.Свойство(Запись, "period", ПериодСтрокой);
		Если Регистр.Организация <> Неопределено Тогда
			OneBase_Json.СвойствоЕслиЕсть(Запись, "organizationId", ИдСсылки(Данные.Организация));
		Иначе
			OneBase_Json.СвойствоЕслиЕсть(Запись, "organizationId", ИдОрганизации);
		КонецЕсли;
		OneBase_Json.Свойство(Запись, "account", Элемент.Счет.Код);
		Пары = Новый Массив;
		Для Каждого ВидСубконтоСчета Из Элемент.Счет.Виды Цикл
			Значение = ?(ВидСубконтоСчета.Скрыто, Неопределено, Данные["Субконто" + OneBase_Json.ЧислоСтрокой(ВидСубконтоСчета.Индекс)]);
			Пары.Добавить(Новый Структура("Индекс, Вид, Значение, Скрыто", ВидСубконтоСчета.Индекс, ВидСубконтоСчета.Вид, Значение, ВидСубконтоСчета.Скрыто));
		КонецЦикла;
		ЗаписатьМассивСубконто(Контекст, Запись, Пары);
		Если Регистр.Валюта <> Неопределено Тогда
			OneBase_Json.СвойствоЕслиЕсть(Запись, "currency", КодВалюты(Контекст, Данные.Валюта));
		КонецЕсли;
		ЗаписатьСуммыОстатка(Запись, "opening", Данные, Регистр, "НачальныйОстатокДт", "НачальныйОстатокКт");
		ЗаписатьСуммыОстатка(Запись, "turnover", Данные, Регистр, "ОборотДт", "ОборотКт");
		ЗаписатьСуммыОстатка(Запись, "closing", Данные, Регистр, "КонечныйОстатокДт", "КонечныйОстатокКт");
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	ЗаписатьСтраницу(Запись, Страница);

	Если ИтогиЗапрошены(Контекст) Тогда
		Итоги = ИтогиОстатков(Регистр, СписокСчетов, Отбор);
		ЗаписатьИтоги(Запись, Итоги.ЧислоЗаписей, Итоги.Сумма);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Процедура ЗаписатьСуммыОстатка(Запись, Имя, Данные, Регистр, СуффиксДт, СуффиксКт)

	OneBase_Json.НачатьОбъект(Запись, Имя);
	OneBase_Json.Свойство(Запись, "debit", Окр(ЧислоИлиНоль(Данные[Регистр.Сумма.Имя + СуффиксДт]), 2));
	OneBase_Json.Свойство(Запись, "credit", Окр(ЧислоИлиНоль(Данные[Регистр.Сумма.Имя + СуффиксКт]), 2));
	Если Регистр.ВалютнаяСумма <> Неопределено Тогда
		OneBase_Json.Свойство(Запись, "currencyDebit", Окр(ЧислоИлиНоль(Данные[Регистр.ВалютнаяСумма.Имя + СуффиксДт]), 2));
		OneBase_Json.Свойство(Запись, "currencyCredit", Окр(ЧислоИлиНоль(Данные[Регистр.ВалютнаяСумма.Имя + СуффиксКт]), 2));
	КонецЕсли;
	Если Регистр.Количество <> Неопределено Тогда
		OneBase_Json.Свойство(Запись, "quantityDebit", Окр(ЧислоИлиНоль(Данные[Регистр.Количество.Имя + СуффиксДт]), 3));
		OneBase_Json.Свойство(Запись, "quantityCredit", Окр(ЧислоИлиНоль(Данные[Регистр.Количество.Имя + СуффиксКт]), 3));
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

// Счета для остатков в порядке кодов (с учётом accounts= и подчинённых счетов): массив Структура(Ссылка, Код,
// Виды — массив Структура(Индекс, Вид, Скрыто), Индексы — номера всех субконто счёта для запроса (при subconto=true),
// ЕстьСкрытые — есть персональные субконто: строки счёта сворачиваются в 1С).
Функция СчетаОстатков(Контекст, ССубконто)

	ПланСчетов = Счета(Контекст);
	ВидыСчетов = ВидыСубконтоСчетов(Контекст);

	Отобранные = Неопределено;
	Значение = Параметр(Контекст, "accounts");
	Если Значение <> "" Тогда
		Отобранные = Новый Соответствие;
		Для Каждого Код Из OneBase_Metadata.Кандидаты(Значение) Цикл
			Ссылка = ПланСчетов.ПоКоду.Получить(Код);
			Если Ссылка = Неопределено Тогда
				OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter",
					"Параметр accounts: счёт «" + Лев(Код, 20) + "» не найден в плане счетов.", "accounts");
			КонецЕсли;
			ДобавитьСчетСПодчиненными(Отобранные, Ссылка, ПланСчетов.Подчиненные);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Счет Из ПланСчетов.Упорядоченные Цикл
		Если Отобранные <> Неопределено И Отобранные.Получить(Счет.Ссылка) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Виды = Новый Массив;
		Индексы = Новый Массив;
		ЕстьСкрытые = Ложь;
		ВидыСчета = ВидыСчетов.Получить(Счет.Ссылка);
		Если ССубконто И ВидыСчета <> Неопределено Тогда
			Для Номер = 1 По ВидыСчета.Количество() Цикл
				Вид = ВидыСчета[Номер - 1].Вид;
				Скрыто = ИмяВидаСубконто(Контекст, Вид).Персональный;
				Виды.Добавить(Новый Структура("Индекс, Вид, Скрыто", Номер, Вид, Скрыто));
				Индексы.Добавить(Номер);
				Если Скрыто Тогда
					ЕстьСкрытые = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Ссылка, Код, Виды, Индексы, ЕстьСкрытые",
			Счет.Ссылка, Счет.Код, Виды, Индексы, ЕстьСкрытые));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьСчетСПодчиненными(Отобранные, Ссылка, Подчиненные)

	Если Отобранные.Получить(Ссылка) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отобранные.Вставить(Ссылка, Истина);
	Список = Подчиненные.Получить(Ссылка);
	Если Список <> Неопределено Тогда
		Для Каждого Подчиненный Из Список Цикл
			ДобавитьСчетСПодчиненными(Отобранные, Подчиненный, Подчиненные);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Страница остатков: счета по очереди, внутри счёта — смещение. Курсор: {a: ссылка счёта, c: код, o: смещение}.
Функция СтраницаОстатков(Контекст, Регистр, СписокСчетов, Отбор)

	Лимит = ЛимитСтраницы(Контекст);
	Результат = ПустаяСтраница(Контекст);
	Результат.Строки = Новый Массив;

	Начало = 0;
	Смещение = 0;
	Курсор = ПрочитатьКурсор(Контекст);
	Если Курсор <> Неопределено Тогда
		УИДСчета = СтрокаИзКурсора(Курсор, "a");
		КодСчетаКурсора = СтрокаИзКурсора(Курсор, "c");
		Смещение = ЧислоИзКурсора(Курсор, "o");
		Начало = -1;
		Для Индекс = 0 По СписокСчетов.ВГраница() Цикл
			Если XMLСтрока(СписокСчетов[Индекс].Ссылка) = УИДСчета Тогда
				Начало = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Начало < 0 Тогда
			// Счёт исчез из списка — продолжаем со следующего по коду.
			Смещение = 0;
			Начало = СписокСчетов.Количество();
			Для Индекс = 0 По СписокСчетов.ВГраница() Цикл
				Если СписокСчетов[Индекс].Код > КодСчетаКурсора Тогда
					Начало = Индекс;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Осталось = Лимит;
	Для Индекс = Начало По СписокСчетов.ВГраница() Цикл
		Счет = СписокСчетов[Индекс];
		Пропустить = ?(Индекс = Начало, Смещение, 0);
		Если Осталось = 0 Тогда
			Результат.ЕстьЕще = Истина;
			Результат.Курсор = КурсорОстатков(Контекст, Счет, 0);
			Прервать;
		КонецЕсли;
		Таблица = ВыбратьОстаткиСчета(Регистр, Счет, Отбор, Пропустить + Осталось + 1);
		Взято = 0;
		Для Номер = Пропустить По Таблица.Количество() - 1 Цикл
			Если Осталось = 0 Тогда
				Результат.ЕстьЕще = Истина;
				Результат.Курсор = КурсорОстатков(Контекст, Счет, Пропустить + Взято);
				Прервать;
			КонецЕсли;
			Результат.Строки.Добавить(Новый Структура("Счет, Данные", Счет, Таблица[Номер]));
			Взято = Взято + 1;
			Осталось = Осталось - 1;
		КонецЦикла;
		Если Результат.ЕстьЕще Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КурсорОстатков(Контекст, Счет, Смещение)
	Возврат OneBase_Json.КурсорВСтроку(Контекст.Метод, Новый Структура("a, c, o", XMLСтрока(Счет.Ссылка), Счет.Код, Смещение));
КонецФункции

// Строки ОстаткиИОбороты одного счёта за месяц в устойчивом порядке. Количество — сколько строк нужно (ПЕРВЫЕ);
// у счёта с персональными субконто читаются все его строки и сворачиваются (СвернутьПерсональныеСубконто).
Функция ВыбратьОстаткиСчета(Регистр, Счет, Отбор, Количество)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", Отбор.Начало);
	Запрос.УстановитьПараметр("КонецПериода", Отбор.Конец);
	Запрос.УстановитьПараметр("Счет", Счет.Ссылка);
	Если Отбор.Организация <> Неопределено Тогда
		Запрос.УстановитьПараметр("Организация", Отбор.Организация);
	КонецЕсли;
	Если Счет.ЕстьСкрытые Тогда
		Запрос.Текст = "ВЫБРАТЬ " + ТекстПолейОстатков(Регистр, Счет.Индексы)
			+ " ИЗ " + ТаблицаОстатков(Регистр, Отбор, "Счет = &Счет") + " КАК О";
		Возврат СвернутьПерсональныеСубконто(Регистр, Счет, Запрос.Выполнить().Выгрузить());
	КонецЕсли;
	Порядок = ПорядокОстатков(Регистр, Счет.Индексы);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + OneBase_Json.ЧислоСтрокой(Количество) + " " + ТекстПолейОстатков(Регистр, Счет.Индексы)
		+ " ИЗ " + ТаблицаОстатков(Регистр, Отбор, "Счет = &Счет") + " КАК О"
		+ ?(Порядок = "", "", " УПОРЯДОЧИТЬ ПО " + Порядок);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Свёртка строк счёта по персональным субконто (сотрудники, физлица) — в 1С, до разбиения на страницы.
// Колонки персональных субконто убираются; строки с одинаковыми счётом, организацией, валютой и остальными субконто
// складываются: начальные и конечные остатки Дт и Кт, обороты Дт и Кт, валютные суммы и количество — каждый отдельно
// (развёрнутое сальдо по людям, как итог «ОСВ по счёту» с разворотом по работникам). Порядок строк — по ключу из
// значений оставшихся полей (UUID ссылок), поэтому он одинаков при каждом запросе и смещение в курсоре устойчиво.
Функция СвернутьПерсональныеСубконто(Регистр, Счет, Таблица)

	Группировки = Новый Массив;
	Группировки.Добавить("Счет");
	Если Регистр.Организация <> Неопределено Тогда
		Группировки.Добавить("Организация");
	КонецЕсли;
	Если Регистр.Валюта <> Неопределено Тогда
		Группировки.Добавить("Валюта");
	КонецЕсли;
	Для Каждого ВидСубконтоСчета Из Счет.Виды Цикл
		Если НЕ ВидСубконтоСчета.Скрыто Тогда
			Группировки.Добавить("Субконто" + OneBase_Json.ЧислоСтрокой(ВидСубконтоСчета.Индекс));
		КонецЕсли;
	КонецЦикла;
	Суммы = КолонкиСуммОстатков(Регистр);

	Свернутая = Таблица.Скопировать(, СтрСоединить(Группировки, ", ") + ", " + СтрСоединить(Суммы, ", "));
	Для Каждого Данные Из Свернутая Цикл
		Для Каждого Колонка Из Суммы Цикл
			Если ТипЗнч(Данные[Колонка]) <> Тип("Число") Тогда
				Данные[Колонка] = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Свернутая.Свернуть(СтрСоединить(Группировки, ", "), СтрСоединить(Суммы, ", "));

	Свернутая.Колонки.Добавить("КлючПорядка");
	Для Каждого Данные Из Свернутая Цикл
		Части = Новый Массив;
		Для Каждого Колонка Из Группировки Цикл
			Части.Добавить(КлючЗначения(Данные[Колонка]));
		КонецЦикла;
		Данные.КлючПорядка = СтрСоединить(Части, "|");
	КонецЦикла;
	Свернутая.Сортировать("КлючПорядка");
	Возврат Свернутая;

КонецФункции

// Строковый ключ значения для устойчивого порядка: UUID ссылки, имя значения перечисления, XML-представление примитива.
Функция КлючЗначения(Значение)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат XMLСтрока(Значение);
	Исключение
		Возврат Строка(Значение);
	КонецПопытки;

КонецФункции

// Итоги /balances: число строк и сумма оборота Дт (так сверяет OneBase) — по тем же строкам, что и на страницах.
// Счета с персональными субконто считаются по свёрнутой таблице (СвернутьПерсональныеСубконто); остальные счета
// с одинаковым набором субконто — одним запросом с теми же полями.
Функция ИтогиОстатков(Регистр, СписокСчетов, Отбор)

	ЧислоСтрок = 0;
	Сумма = 0;
	Группы = Новый Соответствие;
	Для Каждого Счет Из СписокСчетов Цикл
		Если Счет.ЕстьСкрытые Тогда
			Свернутая = ВыбратьОстаткиСчета(Регистр, Счет, Отбор, 0);
			ЧислоСтрок = ЧислоСтрок + Свернутая.Количество();
			Сумма = Сумма + Свернутая.Итог(Регистр.Сумма.Имя + "ОборотДт");
			Продолжить;
		КонецЕсли;
		Номера = Новый Массив;
		Для Каждого Номер Из Счет.Индексы Цикл
			Номера.Добавить(OneBase_Json.ЧислоСтрокой(Номер));
		КонецЦикла;
		КлючГруппы = "к" + СтрСоединить(Номера, "_");
		Группа = Группы.Получить(КлючГруппы);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Индексы, Счета", Счет.Индексы, Новый Массив);
			Группы.Вставить(КлючГруппы, Группа);
		КонецЕсли;
		Группа.Счета.Добавить(Счет.Ссылка);
	КонецЦикла;

	Для Каждого ЭлементГруппы Из Группы Цикл
		Группа = ЭлементГруппы.Значение;
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НачалоПериода", Отбор.Начало);
		Запрос.УстановитьПараметр("КонецПериода", Отбор.Конец);
		Запрос.УстановитьПараметр("Счета", Группа.Счета);
		Если Отбор.Организация <> Неопределено Тогда
			Запрос.УстановитьПараметр("Организация", Отбор.Организация);
		КонецЕсли;
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК ЧислоЗаписей, СУММА(Строки." + Регистр.Сумма.Имя + "ОборотДт) КАК СуммаИтог"
			+ " ИЗ (ВЫБРАТЬ " + ТекстПолейОстатков(Регистр, Группа.Индексы)
			+ " ИЗ " + ТаблицаОстатков(Регистр, Отбор, "Счет В (&Счета)") + " КАК О) КАК Строки";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЧислоСтрок = ЧислоСтрок + ЧислоИлиНоль(Выборка.ЧислоЗаписей);
			Сумма = Сумма + ЧислоИлиНоль(Выборка.СуммаИтог);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("ЧислоЗаписей, Сумма", ЧислоСтрок, Окр(Сумма, 2));

КонецФункции

// РегистрБухгалтерии.<Имя>.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , <условие счёта>, , <организация>).
// Периодичность не задана — обороты за весь месяц одной строкой.
Функция ТаблицаОстатков(Регистр, Отбор, УсловиеСчета)

	ПараметрыТаблицы = Новый Массив;
	ПараметрыТаблицы.Добавить("&НачалоПериода");
	ПараметрыТаблицы.Добавить("&КонецПериода");
	ПараметрыТаблицы.Добавить("");
	ПараметрыТаблицы.Добавить("");
	ПараметрыТаблицы.Добавить(УсловиеСчета);
	ПараметрыТаблицы.Добавить("");
	ПараметрыТаблицы.Добавить(?(Отбор.Организация = Неопределено, "", Регистр.Организация.Имя + " = &Организация"));
	Возврат ВиртуальнаяТаблица(Регистр.ПолноеИмя + ".ОстаткиИОбороты", ПараметрыТаблицы);

КонецФункции

// Поля ОстаткиИОбороты: счёт, организация, валюта, развёрнутые субконто и шесть сумм на каждый ресурс.
Функция ТекстПолейОстатков(Регистр, Индексы)

	Поля = Новый Массив;
	Поля.Добавить("О.Счет КАК Счет");
	Если Регистр.Организация <> Неопределено Тогда
		Поля.Добавить("О." + Регистр.Организация.Имя + " КАК Организация");
	КонецЕсли;
	Если Регистр.Валюта <> Неопределено Тогда
		Поля.Добавить("О." + Регистр.Валюта.Имя + " КАК Валюта");
	КонецЕсли;
	Для Каждого Номер Из Индексы Цикл
		Поля.Добавить("О.Субконто" + OneBase_Json.ЧислоСтрокой(Номер) + " КАК Субконто" + OneBase_Json.ЧислоСтрокой(Номер));
	КонецЦикла;
	Для Каждого Колонка Из КолонкиСуммОстатков(Регистр) Цикл
		Поля.Добавить("О." + Колонка + " КАК " + Колонка);
	КонецЦикла;
	Возврат СтрСоединить(Поля, ", ");

КонецФункции

// Имена колонок сумм ОстаткиИОбороты: по шесть на ресурс (начальный остаток, оборот, конечный остаток — Дт и Кт).
Функция КолонкиСуммОстатков(Регистр)

	Ресурсы = Новый Массив;
	Ресурсы.Добавить(Регистр.Сумма.Имя);
	Если Регистр.ВалютнаяСумма <> Неопределено Тогда
		Ресурсы.Добавить(Регистр.ВалютнаяСумма.Имя);
	КонецЕсли;
	Если Регистр.Количество <> Неопределено Тогда
		Ресурсы.Добавить(Регистр.Количество.Имя);
	КонецЕсли;
	Суффиксы = СтрРазделить("НачальныйОстатокДт,НачальныйОстатокКт,ОборотДт,ОборотКт,КонечныйОстатокДт,КонечныйОстатокКт", ",", Ложь);
	Результат = Новый Массив;
	Для Каждого Ресурс Из Ресурсы Цикл
		Для Каждого Суффикс Из Суффиксы Цикл
			Результат.Добавить(Ресурс + Суффикс);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПорядокОстатков(Регистр, Индексы)

	Поля = Новый Массив;
	Если Регистр.Организация <> Неопределено Тогда
		Поля.Добавить("О." + Регистр.Организация.Имя);
	КонецЕсли;
	Если Регистр.Валюта <> Неопределено Тогда
		Поля.Добавить("О." + Регистр.Валюта.Имя);
	КонецЕсли;
	Для Каждого Номер Из Индексы Цикл
		Поля.Добавить("О.Субконто" + OneBase_Json.ЧислоСтрокой(Номер));
	КонецЦикла;
	Возврат СтрСоединить(Поля, ", ");

КонецФункции

#КонецОбласти

#Область Версии

// GET /v1/versions?entityType=… — спецификация 4.13. Только ссылка, ВерсияДанных, пометка удаления (и проведение, дата,
// тип у документов). Документы — организации за период (organizationId, from, to обязательны), type — необязательно.
Процедура ВыгрузитьВерсии(Контекст, Запись)

	ТипЗаписи = НРег(ОбязательныйПараметр(Контекст, "entityType"));
	Если ТипЗаписи = "document" Тогда
		Организация = ПараметрОрганизация(Контекст, Истина);
		Период = ПараметрПериод(Контекст, Истина);
		Типы = ЗапрошенныеТипы(Контекст);
		Описания = ОтобратьДокументы(Контекст, Типы, Организация, Ложь);
		Отбор = Новый Структура("Начало, Конец, Организация", Период.Начало, Период.Конец, Организация);
		Страница = СтраницаДокументов(Контекст, Описания, Отбор, "Версии");
		НачатьОтвет(Запись);
		OneBase_Json.НачатьМассив(Запись, "items");
		Для Каждого Элемент Из Страница.Строки Цикл
			ЗаписатьВерсию(Контекст, Запись, Элемент.Данные, Элемент.Описание);
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
		ЗаписатьСтраницу(Запись, Страница);
		Запись.ЗаписатьКонецОбъекта();
	ИначеЕсли ТипЗаписи = "account" Тогда
		ВыгрузитьСчета(Контекст, Запись, Истина);
	ИначеЕсли ТипЗаписи = "reference" Тогда
		ВыгрузитьСправочник(Контекст, Запись, ПрочийСправочникИзПараметра(Контекст), Истина);
	Иначе
		Соответствия = Новый Соответствие;
		Соответствия.Вставить("organization", "organizations");
		Соответствия.Вставить("counterparty", "counterparties");
		Соответствия.Вставить("contract", "contracts");
		Соответствия.Вставить("currency", "currencies");
		Соответствия.Вставить("warehouse", "warehouses");
		Соответствия.Вставить("department", "departments");
		Соответствия.Вставить("item", "items");
		Код = Соответствия.Получить(ТипЗаписи);
		Если Код = Неопределено Тогда
			OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр entityType: допустимо organization, account, "
				+ "currency, counterparty, contract, warehouse, department, item, reference, document.", "entityType");
		КонецЕсли;
		ВыгрузитьСправочник(Контекст, Запись, OneBase_Metadata.Сущность(Контекст, Код), Истина);
	КонецЕсли;

КонецПроцедуры

// Элемент /versions. Описание — описание документа или Неопределено для справочника.
Процедура ЗаписатьВерсию(Контекст, Запись, Данные, Описание)

	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьОбщиеПоля(Запись, Данные);
	Если Описание <> Неопределено Тогда
		OneBase_Json.Свойство(Запись, "posted", Данные.Проведен = Истина);
		OneBase_Json.Свойство(Запись, "date", OneBase_Json.ДатаВремя(Данные.Дата, Контекст.Смещение));
		OneBase_Json.Свойство(Запись, "type", Описание.Тип);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

#КонецОбласти

#Область ПараметрыЗапроса

// Параметр запроса строкой без пробелов по краям; нет параметра — "".
Функция Параметр(Контекст, Имя)

	Значение = Контекст.Параметры.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), СокрЛП(Значение), "");

КонецФункции

Функция ОбязательныйПараметр(Контекст, Имя)

	Значение = Параметр(Контекст, Имя);
	Если Значение = "" Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Не задан обязательный параметр " + Имя + ".", Имя);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// limit: 1…ЛимитМаксимум (больше — урезается), по умолчанию ЛимитПоУмолчанию.
Функция ЛимитСтраницы(Контекст)

	Значение = Параметр(Контекст, "limit");
	Если Значение = "" Тогда
		Возврат OneBase_Settings.ЛимитПоУмолчанию();
	КонецЕсли;
	Если НЕ ТолькоЦифры(Значение) ИЛИ СтрДлина(Значение) > 7 Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр limit: целое число от 1 до "
			+ OneBase_Json.ЧислоСтрокой(OneBase_Settings.ЛимитМаксимум()) + ".", "limit");
	КонецЕсли;
	Лимит = Число(Значение);
	Если Лимит < 1 Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр limit: не меньше 1.", "limit");
	КонецЕсли;
	Возврат Мин(Лимит, OneBase_Settings.ЛимитМаксимум());

КонецФункции

Функция ПараметрБулево(Контекст, Имя, ПоУмолчанию)

	Значение = НРег(Параметр(Контекст, Имя));
	Если Значение = "" Тогда
		Возврат ПоУмолчанию;
	ИначеЕсли Значение = "true" ИЛИ Значение = "1" Тогда
		Возврат Истина;
	ИначеЕсли Значение = "false" ИЛИ Значение = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр " + Имя + ": true или false.", Имя);
	Возврат ПоУмолчанию;

КонецФункции

Функция ИтогиЗапрошены(Контекст)
	Возврат ПараметрБулево(Контекст, "includeTotals", Ложь);
КонецФункции

// from/to (ГГГГ-ММ-ДД, обе границы включительно): Структура(Начало — начало дня, Конец — конец дня).
Функция ПараметрПериод(Контекст, Обязательный)

	Начало = ПараметрДата(Контекст, "from", Обязательный);
	Конец = ПараметрДата(Контекст, "to", Обязательный);
	Если Начало <> Неопределено И Конец <> Неопределено И Начало > Конец Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр from: дата позже to.", "from");
	КонецЕсли;
	Возврат Новый Структура("Начало, Конец",
		?(Начало = Неопределено, Неопределено, НачалоДня(Начало)),
		?(Конец = Неопределено, Неопределено, КонецДня(Конец)));

КонецФункции

Функция ПараметрДата(Контекст, Имя, Обязательный)

	Значение = Параметр(Контекст, Имя);
	Если Значение = "" Тогда
		Если Обязательный Тогда
			OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Не задан обязательный параметр " + Имя + " (ГГГГ-ММ-ДД).", Имя);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Результат = Неопределено;
	Если СтрДлина(Значение) = 10 И Сред(Значение, 5, 1) = "-" И Сред(Значение, 8, 1) = "-"
		И ТолькоЦифры(Лев(Значение, 4) + Сред(Значение, 6, 2) + Сред(Значение, 9, 2)) Тогда
		Попытка
			Результат = Дата(Число(Лев(Значение, 4)), Число(Сред(Значение, 6, 2)), Число(Сред(Значение, 9, 2)));
		Исключение
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Результат = Неопределено Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр " + Имя + ": дата должна быть в формате ГГГГ-ММ-ДД", Имя);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// period=ГГГГ-ММ → начало месяца.
Функция ПараметрМесяц(Контекст)

	Значение = ОбязательныйПараметр(Контекст, "period");
	Результат = Неопределено;
	Если СтрДлина(Значение) = 7 И Сред(Значение, 5, 1) = "-" И ТолькоЦифры(Лев(Значение, 4) + Прав(Значение, 2)) Тогда
		Попытка
			Результат = Дата(Число(Лев(Значение, 4)), Число(Прав(Значение, 2)), 1);
		Исключение
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Результат = Неопределено Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр period: месяц в формате ГГГГ-ММ.", "period");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// organizationId → ссылка на организацию (строится в памяти; база не читается). Неверный UUID — 400.
Функция ПараметрОрганизация(Контекст, Обязательный)

	Значение = Параметр(Контекст, "organizationId");
	Если Значение = "" Тогда
		Если Обязательный Тогда
			OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Не задан обязательный параметр organizationId.", "organizationId");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	УИД = РазобратьУИД(Значение);
	Если УИД = Неопределено Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр organizationId: ожидается UUID.", "organizationId");
	КонецЕсли;
	Организации = OneBase_Metadata.Сущность(Контекст, "organizations");
	Если НЕ Организации.Найден Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter",
			"Отбор по организации невозможен: справочник организаций не найден (OneBase_Settings, organizations).", "organizationId");
	КонецЕсли;
	Возврат Справочники[Организации.Имя].ПолучитьСсылку(УИД);

КонецФункции

// ids=uuid,uuid… → массив УникальныйИдентификатор без повторов (не больше ИдентификаторовМаксимум). Нет параметра — Неопределено.
Функция ПараметрИдентификаторы(Контекст)

	Значение = Параметр(Контекст, "ids");
	Если Значение = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Массив;
	Встречались = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить(Значение, ",", Ложь) Цикл
		Текст = НРег(СокрЛП(Часть));
		Если Текст = "" Тогда
			Продолжить;
		КонецЕсли;
		УИД = РазобратьУИД(Текст);
		Если УИД = Неопределено Тогда
			OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр ids: «" + Лев(Текст, 40) + "» — не UUID.", "ids");
		КонецЕсли;
		Если Встречались.Получить(Текст) = Неопределено Тогда
			Встречались.Вставить(Текст, Истина);
			Результат.Добавить(УИД);
		КонецЕсли;
	КонецЦикла;
	Максимум = OneBase_Settings.ИдентификаторовМаксимум();
	Если Результат.Количество() = 0 ИЛИ Результат.Количество() > Максимум Тогда
		OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter",
			"Параметр ids: от 1 до " + OneBase_Json.ЧислоСтрокой(Максимум) + " идентификаторов через запятую.", "ids");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция РазобратьУИД(Текст)

	Если СтрДлина(Текст) <> 36 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Новый УникальныйИдентификатор(Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ТолькоЦифры(Текст)

	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// --- Курсоры ---

Функция ПрочитатьКурсор(Контекст)

	Значение = Параметр(Контекст, "cursor");
	Если Значение = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат OneBase_Json.КурсорИзСтроки(Контекст.Метод, Значение);

КонецФункции

Функция СтрокаИзКурсора(Курсор, Имя)

	Значение = Неопределено;
	Если НЕ Курсор.Свойство(Имя, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Строка") Тогда
		ОшибкаКурсора();
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ЧислоИзКурсора(Курсор, Имя)

	Значение = Неопределено;
	Если НЕ Курсор.Свойство(Имя, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Число") ИЛИ Значение < 0 Тогда
		ОшибкаКурсора();
	КонецЕсли;
	Возврат Цел(Значение);

КонецФункции

Функция УИДИзКурсора(Курсор, Имя)

	УИД = РазобратьУИД(СтрокаИзКурсора(Курсор, Имя));
	Если УИД = Неопределено Тогда
		ОшибкаКурсора();
	КонецЕсли;
	Возврат УИД;

КонецФункции

Функция ДатаИзКурсора(Курсор, Имя)

	Текст = СтрокаИзКурсора(Курсор, Имя);
	Результат = Неопределено;
	Попытка
		Результат = XMLЗначение(Тип("Дата"), Текст);
	Исключение
		ОшибкаКурсора();
	КонецПопытки;
	Возврат Результат;

КонецФункции

Процедура ОшибкаКурсора()
	OneBase_Json.ВызватьОшибкуAPI(400, "invalid_parameter",
		"Параметр cursor: курсор не подходит к этому запросу. Начните листание без cursor.", "cursor");
КонецПроцедуры

#КонецОбласти

#Область Страницы

// Страница по ссылке (справочники, план счетов): ids= — без страниц; иначе ПЕРВЫЕ limit+1 с Ссылка > &последняя.
// Возвращает Структура(Строки — массив строк результата, ЕстьЕще, Курсор, Лимит, ПоИдентификаторам).
Функция СтраницаПоСсылке(Контекст, Мета, ПолноеИмя, ТекстПолей)

	Результат = ПустаяСтраница(Контекст);
	Менеджер = OneBase_Metadata.Менеджер(Мета);
	Идентификаторы = ПараметрИдентификаторы(Контекст);

	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Первые = "";
	Если Идентификаторы <> Неопределено Тогда
		Условия.Добавить("Т.Ссылка В (&Ссылки)");
		Запрос.УстановитьПараметр("Ссылки", СсылкиПоИдентификаторам(Менеджер, Идентификаторы));
		Результат.ПоИдентификаторам = Истина;
	Иначе
		Курсор = ПрочитатьКурсор(Контекст);
		Если Курсор <> Неопределено Тогда
			Условия.Добавить("Т.Ссылка > &КлючСсылка");
			Запрос.УстановитьПараметр("КлючСсылка", Менеджер.ПолучитьСсылку(УИДИзКурсора(Курсор, "r")));
		КонецЕсли;
		Первые = "ПЕРВЫЕ " + OneBase_Json.ЧислоСтрокой(Результат.Лимит + 1) + " ";
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ " + Первые + ТекстПолей + " ИЗ " + ПолноеИмя + " КАК Т" + ТекстГде(Условия) + " УПОРЯДОЧИТЬ ПО Т.Ссылка";
	Таблица = Запрос.Выполнить().Выгрузить();

	Количество = Таблица.Количество();
	Если НЕ Результат.ПоИдентификаторам И Количество > Результат.Лимит Тогда
		Количество = Результат.Лимит;
		Результат.ЕстьЕще = Истина;
		Результат.Курсор = OneBase_Json.КурсорВСтроку(Контекст.Метод,
			Новый Структура("r", XMLСтрока(Таблица[Количество - 1].Ссылка)));
	КонецЕсли;
	Строки = Новый Массив;
	Для Номер = 0 По Количество - 1 Цикл
		Строки.Добавить(Таблица[Номер]);
	КонецЦикла;
	Результат.Строки = Строки;
	Возврат Результат;

КонецФункции

Функция ПустаяСтраница(Контекст)
	Возврат Новый Структура("Строки, ЕстьЕще, Курсор, Лимит, ПоИдентификаторам",
		Новый Массив, Ложь, Неопределено, ЛимитСтраницы(Контекст), Ложь);
КонецФункции

Функция СсылкиПоИдентификаторам(Менеджер, Идентификаторы)

	Результат = Новый Массив;
	Для Каждого УИД Из Идентификаторы Цикл
		Результат.Добавить(Менеджер.ПолучитьСсылку(УИД));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТекстГде(Условия)
	Возврат ?(Условия.Количество() = 0, "", " ГДЕ " + СтрСоединить(Условия, " И "));
КонецФункции

// Имя виртуальной таблицы с параметрами; пустые параметры в конце отбрасываются: Таблица(, , Условие).
Функция ВиртуальнаяТаблица(Имя, ПараметрыТаблицы)

	Последний = -1;
	Для Индекс = 0 По ПараметрыТаблицы.ВГраница() Цикл
		Если ПараметрыТаблицы[Индекс] <> "" Тогда
			Последний = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если Последний < 0 Тогда
		Возврат Имя;
	КонецЕсли;
	Части = Новый Массив;
	Для Индекс = 0 По Последний Цикл
		Части.Добавить(ПараметрыТаблицы[Индекс]);
	КонецЦикла;
	Возврат Имя + "(" + СтрСоединить(Части, ", ") + ")";

КонецФункции

Функция ВыполнитьПодсчет(Запрос)

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ЧислоИлиНоль(Выборка.ЧислоЗаписей);
	КонецЕсли;
	Возврат 0;

КонецФункции

Процедура НачатьОтвет(Запись)

	Запись.ЗаписатьНачалоОбъекта();
	OneBase_Json.Свойство(Запись, "apiVersion", OneBase_Settings.ВерсияAPI());

КонецПроцедуры

Процедура ЗаписатьСтраницу(Запись, Страница)

	OneBase_Json.НачатьОбъект(Запись, "page");
	OneBase_Json.Свойство(Запись, "limit", Страница.Лимит);
	OneBase_Json.Свойство(Запись, "nextCursor", Страница.Курсор);
	OneBase_Json.Свойство(Запись, "hasMore", Страница.ЕстьЕще);
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Процедура ЗаписатьИтоги(Запись, ВсегоЗаписей, Сумма)

	OneBase_Json.НачатьОбъект(Запись, "totals");
	OneBase_Json.Свойство(Запись, "count", ВсегоЗаписей);
	OneBase_Json.СвойствоЕслиЕсть(Запись, "amount", Сумма);
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

// Пустой список с предупреждением (объект не найден в конфигурации) — вместо ошибки, чтобы OneBase не повторял запрос.
Процедура ЗаписатьПустойСписок(Контекст, Запись, Предупреждение)

	OneBase_Json.НачатьМассив(Запись, "items");
	Запись.ЗаписатьКонецМассива();
	ЗаписатьСтраницу(Запись, ПустаяСтраница(Контекст));
	OneBase_Json.НачатьМассив(Запись, "warnings");
	Запись.ЗаписатьЗначение(Предупреждение);
	Запись.ЗаписатьКонецМассива();
	Если ИтогиЗапрошены(Контекст) Тогда
		ЗаписатьИтоги(Запись, 0, Неопределено);
	КонецЕсли;

КонецПроцедуры

// Регистр бухгалтерии для /entries и /balances; не найден или не подходит — 404.
Функция ПроверенныйРегистр(Контекст)

	Регистр = OneBase_Metadata.Регистр(Контекст);
	Если НЕ Регистр.Найден Тогда
		OneBase_Json.ВызватьОшибкуAPI(404, "not_found", "Метод недоступен: регистр бухгалтерии не найден (кандидаты: "
			+ Регистр.Кандидаты + "). Настройте OneBase_Settings.РегистрБухгалтерии по GET /v1/metadata.");
	ИначеЕсли НЕ Регистр.Поддерживается Тогда
		OneBase_Json.ВызватьОшибкуAPI(404, "not_found", "Метод недоступен: регистр бухгалтерии " + Регистр.Имя
			+ " без корреспонденции или без ресурса суммы (см. /v1/metadata, mapping.warnings).");
	КонецЕсли;
	Возврат Регистр;

КонецФункции

#КонецОбласти

#Область Значения

// Общие поля объекта: id, version, deletionMark.
Процедура ЗаписатьОбщиеПоля(Запись, Данные)

	OneBase_Json.Свойство(Запись, "id", XMLСтрока(Данные.Ссылка));
	OneBase_Json.Свойство(Запись, "version", Данные.Версия);
	OneBase_Json.Свойство(Запись, "deletionMark", Данные.ПометкаУдаления = Истина);

КонецПроцедуры

// Колонки запроса для найденных полей: «, Т.<реквизит> КАК П<n>» и, если нужно, «, ПРЕДСТАВЛЕНИЕ(…) КАК П<n>П».
Функция ТекстПолейЗапроса(Контекст, Поля, Таблица)

	ИмяПланаСчетов = OneBase_Metadata.Регистр(Контекст).ПолноеИмяПланаСчетов;
	Текст = "";
	Для Каждого Поле Из Поля Цикл
		Если НЕ Поле.Найден Тогда
			Продолжить;
		КонецЕсли;
		Выражение = Таблица + "." + Поле.Реквизит;
		Если Поле.Вид = "КодСчета" И ИмяПланаСчетов <> "" Тогда
			Выражение = "ВЫРАЗИТЬ(" + Выражение + " КАК " + ИмяПланаСчетов + ").Код";
		КонецЕсли;
		Текст = Текст + ", " + Выражение + " КАК " + Поле.Псевдоним;
		Если НужноПредставление(Контекст, Поле) Тогда
			Текст = Текст + ", ПРЕДСТАВЛЕНИЕ(" + Таблица + "." + Поле.Реквизит + ") КАК " + Поле.Псевдоним + "П";
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Представление ссылки нужно для строковых полей, классификаторов, ставок и (если план счетов неизвестен) кода счёта.
Функция НужноПредставление(Контекст, Поле)

	Если НЕ Поле.ЕстьСсылки Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Поле.Вид = "КодСчета" Тогда
		Возврат OneBase_Metadata.Регистр(Контекст).ПолноеИмяПланаСчетов = "";
	КонецЕсли;
	Возврат Поле.Вид = "Строка" ИЛИ Поле.Вид = "Классификатор" ИЛИ Поле.Вид = "Ставка";

КонецФункции

// Пишет найденные поля в объект JSON. Поля «_…» и перечисленные в Пропустить не пишутся; пустые значения — тоже
// (кроме полей «Всегда»: code, name — пишутся пустой строкой).
Процедура ЗаписатьПоля(Контекст, Запись, Данные, Поля, Пропустить)

	Для Каждого Поле Из Поля Цикл
		Если НЕ Поле.Найден ИЛИ Лев(Поле.Имя, 1) = "_" Тогда
			Продолжить;
		КонецЕсли;
		Если Пропустить <> "" И СтрНайти("," + Пропустить + ",", "," + Поле.Имя + ",") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеПоля(Контекст, Данные, Поле);
		Если Значение = Неопределено И Поле.Всегда Тогда
			Значение = ?(Поле.Вид = "Булево", Ложь, "");
		КонецЕсли;
		OneBase_Json.СвойствоЕслиЕсть(Запись, Поле.Имя, Значение);
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеПоля(Контекст, Данные, Поле)

	Представление = Неопределено;
	Если НужноПредставление(Контекст, Поле) Тогда
		Представление = Данные[Поле.Псевдоним + "П"];
	КонецЕсли;
	Возврат ПривестиЗначение(Контекст, Данные[Поле.Псевдоним], Представление, Поле.Вид, Поле.Параметр);

КонецФункции

Функция ЗначениеНайденногоПоля(Контекст, Данные, Поля, Имя)

	Поле = OneBase_Metadata.НайденноеПоле(Поля, Имя);
	Если Поле = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЗначениеПоля(Контекст, Данные, Поле);

КонецФункции

// Значение 1С → значение JSON по виду поля (см. OneBase_Settings.Справочники). Пустое — Неопределено (поле не пишется).
Функция ПривестиЗначение(Контекст, Значение, Представление, Вид, ПравилаПоля)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);

	Если Вид = "Ид" Тогда
		Возврат ИдСсылки(Значение);
	ИначеЕсли Вид = "Строка" ИЛИ Вид = "КодСчета" Тогда
		Если ЭтоПримитив(Значение) Тогда
			Возврат ЗначениеСтрокой(Контекст, Значение);
		ИначеЕсли ЭтоПустаяСсылка(Значение) Тогда
			Возврат Неопределено;
		ИначеЕсли Представление <> Неопределено И Представление <> Null Тогда
			Возврат ЗначениеСтрокой(Контекст, Строка(Представление));
		КонецЕсли;
		Возврат ЗначениеСтрокой(Контекст, Строка(Значение));
	ИначеЕсли Вид = "Сумма" Тогда
		Возврат OneBase_Json.Округлить(Значение, 2);
	ИначеЕсли Вид = "Количество" Тогда
		Возврат OneBase_Json.Округлить(Значение, 3);
	ИначеЕсли Вид = "Курс" Тогда
		Возврат OneBase_Json.Округлить(Значение, 4);
	ИначеЕсли Вид = "Целое" Тогда
		Возврат ?(ТипЗначения = Тип("Число"), Цел(Значение), Неопределено);
	ИначеЕсли Вид = "Булево" Тогда
		Возврат ?(ТипЗначения = Тип("Булево"), Значение, Неопределено);
	ИначеЕсли Вид = "Дата" Тогда
		Возврат OneBase_Json.ДатаБезВремени(Значение);
	ИначеЕсли Вид = "ДатаВремя" Тогда
		Возврат OneBase_Json.ДатаВремя(Значение, Контекст.Смещение);
	ИначеЕсли Вид = "Валюта" Тогда
		Возврат КодВалюты(Контекст, Значение);
	ИначеЕсли Вид = "Ставка" Тогда
		Если ТипЗначения = Тип("Число") Тогда
			Возврат Окр(Значение, 2);
		ИначеЕсли ЭтоПримитив(Значение) Тогда
			Возврат ЧислоИзТекста(ЗначениеСтрокой(Контекст, Значение));
		ИначеЕсли ЭтоПустаяСсылка(Значение) ИЛИ Представление = Неопределено ИЛИ Представление = Null Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЧислоИзТекста(Строка(Представление));
	ИначеЕсли Вид = "Классификатор" Тогда
		Возврат Классифицировать(Контекст, Значение, Представление, ПравилаПоля);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Код OneBase по правилам «слово=код»: слово ищется в представлении значения (и в имени значения перечисления).
Функция Классифицировать(Контекст, Значение, Представление, Правила)

	ПоУмолчанию = ?(Правила = Неопределено ИЛИ Правила.ПоУмолчанию = "", Неопределено, Правила.ПоУмолчанию);
	Если ЭтоПримитив(Значение) Тогда
		Текст = НРег(ЗначениеСтрокой(Контекст, Значение));
	ИначеЕсли ЭтоПустаяСсылка(Значение) Тогда
		Возврат ПоУмолчанию;
	Иначе
		Текст = НРег(?(Представление = Неопределено ИЛИ Представление = Null, Строка(Значение), Строка(Представление)));
		Если ОписаниеТипа(Контекст, ТипЗнч(Значение)).Класс = "Перечисление" Тогда
			Текст = Текст + " " + НРег(XMLСтрока(Значение));
		КонецЕсли;
	КонецЕсли;
	Если Правила <> Неопределено И Текст <> Неопределено Тогда
		Для Каждого Правило Из Правила.Правила Цикл
			Если СтрНайти(Текст, Правило.Слово) > 0 Тогда
				Возврат Правило.Код;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

// Строка для JSON: строки — без хвостовых пробелов, числа и булево — в формате XML, даты — ISO (без времени, если оно 0:00),
// ссылки — UUID, перечисления — имя значения. Пусто — Неопределено.
Функция ЗначениеСтрокой(Контекст, Значение)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Результат = СокрП(Значение);
		Возврат ?(Результат = "", Неопределено, Результат);
	ИначеЕсли ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Если Значение = НачалоДня(Значение) Тогда
			Возврат OneBase_Json.ДатаБезВремени(Значение);
		КонецЕсли;
		Возврат OneBase_Json.ДатаВремя(Значение, Контекст.Смещение);
	ИначеЕсли ЭтоПримитив(Значение) Тогда
		Возврат Неопределено; // хранилище значения, двоичные данные — не выгружаются
	ИначеЕсли ЭтоПустаяСсылка(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат XMLСтрока(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// UUID ссылки; пустая ссылка, примитив, NULL — Неопределено.
Функция ИдСсылки(Значение)

	Если Значение = Неопределено ИЛИ Значение = Null ИЛИ ЭтоПримитив(Значение) ИЛИ ЭтоПустаяСсылка(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат XMLСтрока(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ЭтоПримитив(Значение)
	Возврат OneBase_Metadata.ЭтоПримитивныйТип(ТипЗнч(Значение));
КонецФункции

Функция ЭтоПустаяСсылка(Значение)

	Если Значение = Неопределено ИЛИ Значение = Null ИЛИ ЭтоПримитив(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат Значение.Пустая();
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ЧислоИлиНоль(Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);
КонецФункции

// Первое число в тексте ("12%" → 12, "Без НДС" → Неопределено).
Функция ЧислоИзТекста(Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Цифры = "";
	БылРазделитель = Ложь;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Знак) > 0 Тогда
			Цифры = Цифры + Знак;
		ИначеЕсли Цифры <> "" И (Знак = "." ИЛИ Знак = ",") И НЕ БылРазделитель Тогда
			Цифры = Цифры + ".";
			БылРазделитель = Истина;
		ИначеЕсли Цифры <> "" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Прав(Цифры, 1) = "." Тогда
		Цифры = Лев(Цифры, СтрДлина(Цифры) - 1);
	КонецЕсли;
	Если Цифры = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Число(Цифры);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Кэши

Функция КэшКонтекста(Контекст, Имя)

	Результат = Контекст.Кэш.Получить(Имя);
	Если Результат = Неопределено Тогда
		Результат = Новый Соответствие;
		Контекст.Кэш.Вставить(Имя, Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Справочник валют: Структура(ПоСсылке — ссылка → буквенный код, ПоКоду — код в верхнем регистре → ссылка).
Функция Валюты(Контекст)

	Результат = Контекст.Кэш.Получить("Валюты");
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат = Новый Структура("ПоСсылке, ПоКоду", Новый Соответствие, Новый Соответствие);
	Контекст.Кэш.Вставить("Валюты", Результат);

	Сущность = OneBase_Metadata.Сущность(Контекст, "currencies");
	Если Сущность = Неопределено ИЛИ НЕ Сущность.Найден Тогда
		Возврат Результат;
	КонецЕсли;
	ПолеКода = OneBase_Metadata.НайденноеПоле(Сущность.Поля, "code");
	Если ПолеКода = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ПоляЗапроса = Новый Массив;
	ПоляЗапроса.Добавить(ПолеКода);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка" + ТекстПолейЗапроса(Контекст, ПоляЗапроса, "Т") + " ИЗ " + Сущность.ПолноеИмя + " КАК Т";
	Для Каждого Данные Из Запрос.Выполнить().Выгрузить() Цикл
		Код = ЗначениеПоля(Контекст, Данные, ПолеКода);
		Если Код = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Код = СокрЛП(Код);
		Результат.ПоСсылке.Вставить(Данные.Ссылка, Код);
		Если Результат.ПоКоду.Получить(ВРег(Код)) = Неопределено Тогда
			Результат.ПоКоду.Вставить(ВРег(Код), Данные.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КодВалюты(Контекст, Ссылка)

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Валюты(Контекст).ПоСсылке.Получить(Ссылка);

КонецФункции

// План счетов: Структура(ПоСсылке — ссылка → код, ПоКоду — код → ссылка, Подчиненные — родитель → массив,
// Упорядоченные — массив Структура(Ссылка, Код) по коду).
Функция Счета(Контекст)

	Результат = Контекст.Кэш.Получить("Счета");
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат = Новый Структура("ПоСсылке, ПоКоду, Подчиненные, Упорядоченные",
		Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Массив);
	Контекст.Кэш.Вставить("Счета", Результат);

	Регистр = OneBase_Metadata.Регистр(Контекст);
	Если НЕ Регистр.Найден Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.Код КАК Код, Т.Родитель КАК Родитель ИЗ "
		+ Регистр.ПолноеИмяПланаСчетов + " КАК Т";
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("КодСтрокой");
	Для Каждого Данные Из Таблица Цикл
		Данные.КодСтрокой = ЗначениеСтрокой(Контекст, Данные.Код);
		Если Данные.КодСтрокой = Неопределено Тогда
			Данные.КодСтрокой = "";
		КонецЕсли;
	КонецЦикла;
	Таблица.Сортировать("КодСтрокой");
	Для Каждого Данные Из Таблица Цикл
		Результат.ПоСсылке.Вставить(Данные.Ссылка, Данные.КодСтрокой);
		Если Результат.ПоКоду.Получить(Данные.КодСтрокой) = Неопределено Тогда
			Результат.ПоКоду.Вставить(Данные.КодСтрокой, Данные.Ссылка);
		КонецЕсли;
		Результат.Упорядоченные.Добавить(Новый Структура("Ссылка, Код", Данные.Ссылка, Данные.КодСтрокой));
		Если ЗначениеЗаполнено(Данные.Родитель) Тогда
			Список = Результат.Подчиненные.Получить(Данные.Родитель);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				Результат.Подчиненные.Вставить(Данные.Родитель, Список);
			КонецЕсли;
			Список.Добавить(Данные.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КодСчета(Контекст, Ссылка)

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Счета(Контекст).ПоСсылке.Получить(Ссылка);

КонецФункции

// Виды субконто счетов: Соответствие (счёт → массив Структура(Вид, ТолькоОбороты) по порядку).
Функция ВидыСубконтоСчетов(Контекст)

	Результат = Контекст.Кэш.Получить("ВидыСубконтоСчетов");
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат = Новый Соответствие;
	Контекст.Кэш.Вставить("ВидыСубконтоСчетов", Результат);

	Регистр = OneBase_Metadata.Регистр(Контекст);
	Если НЕ Регистр.Найден ИЛИ Регистр.ВидыСубконто = Неопределено ИЛИ Регистр.МаксСубконто = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ВС.Ссылка КАК Счет, ВС.ВидСубконто КАК ВидСубконто, ВС.ТолькоОбороты КАК ТолькоОбороты ИЗ "
		+ Регистр.ПолноеИмяПланаСчетов + ".ВидыСубконто КАК ВС УПОРЯДОЧИТЬ ПО ВС.Ссылка, ВС.НомерСтроки";
	Для Каждого Данные Из Запрос.Выполнить().Выгрузить() Цикл
		Список = Результат.Получить(Данные.Счет);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Данные.Счет, Список);
		КонецЕсли;
		Список.Добавить(Новый Структура("Вид, ТолькоОбороты", Данные.ВидСубконто, Данные.ТолькоОбороты));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имя вида субконто для поля type: Структура(Имя, Наименование, Персональный).
Функция ИмяВидаСубконто(Контекст, Вид)

	Виды = Контекст.Кэш.Получить("ВидыСубконто");
	Если Виды = Неопределено Тогда
		Виды = ПрочитатьВидыСубконто(Контекст);
		Контекст.Кэш.Вставить("ВидыСубконто", Виды);
	КонецЕсли;
	Результат = Виды.Получить(Вид);
	Если Результат = Неопределено Тогда
		Имя = ЗначениеСтрокой(Контекст, Строка(Вид));
		Результат = Новый Структура("Имя, Наименование, Персональный", Имя, Имя, OneBase_Metadata.ЭтоПерсональноеИмя(Имя));
		Виды.Вставить(Вид, Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Виды субконто плана счетов. Имя — имя предопределённого элемента («Контрагенты»), если так задано в настройках
// и платформа отдаёт ИмяПредопределенныхДанных в запросе; иначе — наименование.
Функция ПрочитатьВидыСубконто(Контекст)

	Результат = Новый Соответствие;
	Регистр = OneBase_Metadata.Регистр(Контекст);
	Если НЕ Регистр.Найден ИЛИ Регистр.ВидыСубконто = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Таблица = Неопределено;
	Если OneBase_Settings.ИмяВидаСубконто() = "Предопределенное" Тогда
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.Наименование КАК Наименование, Т.Предопределенный КАК Предопределенный,"
				+ " Т.ИмяПредопределенныхДанных КАК ИмяПредопределенных ИЗ " + Регистр.ПолноеИмяВидовСубконто + " КАК Т";
			Таблица = Запрос.Выполнить().Выгрузить();
		Исключение
			Таблица = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Таблица = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.Наименование КАК Наименование, ЛОЖЬ КАК Предопределенный,"
			+ " """" КАК ИмяПредопределенных ИЗ " + Регистр.ПолноеИмяВидовСубконто + " КАК Т";
		Таблица = Запрос.Выполнить().Выгрузить();
	КонецЕсли;

	Для Каждого Данные Из Таблица Цикл
		Наименование = СокрЛП(Строка(Данные.Наименование));
		Имя = Наименование;
		Если Данные.Предопределенный = Истина И ТипЗнч(Данные.ИмяПредопределенных) = Тип("Строка")
			И Данные.ИмяПредопределенных <> "" Тогда
			Имя = Данные.ИмяПредопределенных;
		КонецЕсли;
		Персональный = OneBase_Metadata.ЭтоПерсональноеИмя(Имя) ИЛИ OneBase_Metadata.ЭтоПерсональноеИмя(Наименование);
		Результат.Вставить(Данные.Ссылка, Новый Структура("Имя, Наименование, Персональный", Имя, Наименование, Персональный));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Описание типа ссылки: Структура(Мета, Класс, ПолноеИмя, ЕстьКод, ЕстьНаименование, Персональный). Кэшируется по типу.
Функция ОписаниеТипа(Контекст, ТипЗначения)

	Кэш = КэшКонтекста(Контекст, "Типы");
	Результат = Кэш.Получить(ТипЗначения);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Мета = Метаданные.НайтиПоТипу(ТипЗначения);
	ВидОбъекта = OneBase_Metadata.Класс(Мета);
	Результат = Новый Структура("Мета, Класс, ПолноеИмя, ЕстьКод, ЕстьНаименование, Персональный",
		Мета, ВидОбъекта, "", Ложь, Ложь, Ложь);
	Если ВидОбъекта <> "" Тогда
		Результат.ПолноеИмя = ВидОбъекта + "." + Мета.Имя;
		Результат.Персональный = OneBase_Metadata.ЭтоПерсональноеИмя(Мета.Имя);
		Если ВидОбъекта = "Справочник" ИЛИ ВидОбъекта = "ПланСчетов" ИЛИ ВидОбъекта = "ПланВидовХарактеристик"
			ИЛИ ВидОбъекта = "ПланВидовРасчета" Тогда
			Попытка
				Результат.ЕстьКод = Мета.ДлинаКода > 0;
			Исключение
				Результат.ЕстьКод = Ложь;
			КонецПопытки;
			Попытка
				Результат.ЕстьНаименование = Мета.ДлинаНаименования > 0;
			Исключение
				Результат.ЕстьНаименование = Ложь;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Кэш.Вставить(ТипЗначения, Результат);
	Возврат Результат;

КонецФункции

// Читает коды и наименования ссылок (по одному запросу на вид объекта, одним пакетом) в кэш представлений.
Процедура ЗаполнитьПредставления(Контекст, Значения)

	Кэш = КэшКонтекста(Контекст, "Представления");
	Группы = Новый Соответствие;
	Для Каждого Значение Из Значения Цикл
		Если Значение = Неопределено ИЛИ Значение = Null ИЛИ ЭтоПримитив(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если Кэш.Получить(Значение) <> Неопределено ИЛИ ЭтоПустаяСсылка(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Инфо = ОписаниеТипа(Контекст, ТипЗнч(Значение));
		Если Инфо.Класс = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Инфо.Класс = "Перечисление" Тогда
			Кэш.Вставить(Значение, Новый Структура("Код, Наименование", XMLСтрока(Значение), Строка(Значение)));
			Продолжить;
		КонецЕсли;
		Группа = Группы.Получить(Инфо.ПолноеИмя);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Инфо, Ссылки, Отмеченные", Инфо, Новый Массив, Новый Соответствие);
			Группы.Вставить(Инфо.ПолноеИмя, Группа);
		КонецЕсли;
		Если Группа.Отмеченные.Получить(Значение) = Неопределено Тогда
			Группа.Отмеченные.Вставить(Значение, Истина);
			Группа.Ссылки.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Если Группы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Тексты = Новый Массив;
	Номер = 0;
	Для Каждого ЭлементГруппы Из Группы Цикл
		Группа = ЭлементГруппы.Значение;
		Номер = Номер + 1;
		ИмяПараметра = "Ссылки" + OneBase_Json.ЧислоСтрокой(Номер);
		Тексты.Добавить("ВЫБРАТЬ Т.Ссылка КАК Ссылка, "
			+ ?(Группа.Инфо.ЕстьКод, "Т.Код", "НЕОПРЕДЕЛЕНО") + " КАК Код, "
			+ ?(Группа.Инфо.ЕстьНаименование, "Т.Наименование", "ПРЕДСТАВЛЕНИЕ(Т.Ссылка)") + " КАК Наименование"
			+ " ИЗ " + Группа.Инфо.ПолноеИмя + " КАК Т ГДЕ Т.Ссылка В (&" + ИмяПараметра + ")");
		Запрос.УстановитьПараметр(ИмяПараметра, Группа.Ссылки);
	КонецЦикла;
	Запрос.Текст = СтрСоединить(Тексты, ";" + Символы.ПС);
	Для Каждого РезультатЗапроса Из Запрос.ВыполнитьПакет() Цикл
		Для Каждого Данные Из РезультатЗапроса.Выгрузить() Цикл
			Кэш.Вставить(Данные.Ссылка, Новый Структура("Код, Наименование",
				ЗначениеСтрокой(Контекст, Данные.Код), ЗначениеСтрокой(Контекст, Данные.Наименование)));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Код и наименование ссылки из кэша (после ЗаполнитьПредставления) или Неопределено.
Функция ПредставлениеСсылки(Контекст, Значение)

	Если Значение = Неопределено ИЛИ Значение = Null ИЛИ ЭтоПримитив(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КэшКонтекста(Контекст, "Представления").Получить(Значение);

КонецФункции

#КонецОбласти

#Область Права

// Пользователь сервиса не должен иметь прав на изменение выгружаемых объектов (OneBase_Settings.ЗапрещатьПользователюПраваЗаписи).
Процедура ПроверитьПраваПользователя(Контекст)

	ЕстьПрава = ЕстьПраваЗаписи(Контекст);
	Контекст.ЕстьПраваЗаписи = ЕстьПрава;
	Если ЕстьПрава И OneBase_Settings.ЗапрещатьПользователюПраваЗаписи() Тогда
		OneBase_Json.ВызватьОшибкуAPI(403, "forbidden", "У пользователя 1С «" + ИмяПользователя()
			+ "» есть права на изменение данных или администрирование. Сервису OneBase нужен пользователь только для чтения "
			+ "(README расширения OneBaseExchange, раздел «Пользователь»).");
	КонецЕсли;

КонецПроцедуры

// Есть ли у текущего пользователя права администрирования или изменения выгружаемых справочников, документов, регистров.
Функция ЕстьПраваЗаписи(Контекст)

	Если ЕстьПраво("Администрирование", Метаданные) ИЛИ ЕстьПраво("АдминистрированиеДанных", Метаданные) Тогда
		Возврат Истина;
	КонецЕсли;

	Объекты = Новый Массив;
	Для Каждого Настройка Из OneBase_Settings.СправочникиМетодов() Цикл
		Описание = OneBase_Metadata.Сущность(Контекст, Настройка.Ключ);
		Если Описание.Найден Тогда
			Объекты.Добавить(Описание.Мета);
		КонецЕсли;
	КонецЦикла;
	Регистр = OneBase_Metadata.Регистр(Контекст);
	Если Регистр.Найден Тогда
		Объекты.Добавить(Регистр.Мета);
		Объекты.Добавить(Регистр.ПланСчетов);
	КонецЕсли;
	Курсы = OneBase_Metadata.КурсыВалют(Контекст);
	Если Курсы.Найден Тогда
		Объекты.Добавить(Курсы.Мета);
	КонецЕсли;
	Для Каждого ТипДокумента Из OneBase_Settings.ТипыДокументов() Цикл
		Для Каждого Имя Из OneBase_Metadata.Кандидаты(ТипДокумента.Документы) Цикл
			МетаДокумента = Метаданные.Документы.Найти(Имя);
			Если МетаДокумента <> Неопределено Тогда
				Объекты.Добавить(МетаДокумента);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Мета Из Объекты Цикл
		Если ЕстьПраво("Изменение", Мета) ИЛИ ЕстьПраво("Добавление", Мета) ИЛИ ЕстьПраво("Проведение", Мета) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЕстьПраво(Право, Объект)

	Попытка
		Возврат ПравоДоступа(Право, Объект);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

