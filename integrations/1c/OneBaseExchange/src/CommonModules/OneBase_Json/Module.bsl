// =====================================================================================================================
// OneBase_Json — запись JSON-ответов, форматы дат и чисел, ошибки API, курсоры страниц, проверка секрета.
//
// Свойства общего модуля: Сервер = Истина; Глобальный, Клиент, Внешнее соединение, Вызов сервера,
// Привилегированный = Ложь.
//
// Модуль ничего не читает и не пишет в информационной базе: только строки, JSON и хеширование в памяти.
// Исключение — запись внутренних ошибок в журнал регистрации (отключается в OneBase_Settings); журнал
// регистрации хранится отдельно от данных базы.
// =====================================================================================================================

#Область ЗаписьJSON

// Новая ЗаписьJSON в строку: без переносов строк, кириллица без экранирования (UTF-8).
Функция НоваяЗапись() Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "", Истина));
	Возврат Запись;

КонецФункции

// Закрывает запись и возвращает текст JSON.
Функция ЗакрытьЗапись(Запись) Экспорт
	Возврат Запись.Закрыть();
КонецФункции

// Пишет свойство объекта. Значение — Строка, Число, Булево; Неопределено и Null пишутся как null.
Процедура Свойство(Запись, Имя, Значение) Экспорт

	Запись.ЗаписатьИмяСвойства(Имя);
	ЗаписатьЗначение(Запись, Значение);

КонецПроцедуры

// Пишет свойство, только если значение задано (пустое поле по спецификации можно не передавать).
Процедура СвойствоЕслиЕсть(Запись, Имя, Значение) Экспорт

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат;
	КонецЕсли;
	Свойство(Запись, Имя, Значение);

КонецПроцедуры

// Пишет значение (элемент массива или значение свойства).
Процедура ЗаписатьЗначение(Запись, Значение) Экспорт

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Запись.ЗаписатьЗначение(Неопределено);
	Иначе
		Запись.ЗаписатьЗначение(Значение);
	КонецЕсли;

КонецПроцедуры

// Начинает объект; с именем — как значение свойства.
Процедура НачатьОбъект(Запись, Имя = Неопределено) Экспорт

	Если Имя <> Неопределено Тогда
		Запись.ЗаписатьИмяСвойства(Имя);
	КонецЕсли;
	Запись.ЗаписатьНачалоОбъекта();

КонецПроцедуры

Процедура ЗакончитьОбъект(Запись) Экспорт
	Запись.ЗаписатьКонецОбъекта();
КонецПроцедуры

// Начинает массив; с именем — как значение свойства.
Процедура НачатьМассив(Запись, Имя = Неопределено) Экспорт

	Если Имя <> Неопределено Тогда
		Запись.ЗаписатьИмяСвойства(Имя);
	КонецЕсли;
	Запись.ЗаписатьНачалоМассива();

КонецПроцедуры

Процедура ЗакончитьМассив(Запись) Экспорт
	Запись.ЗаписатьКонецМассива();
КонецПроцедуры

#КонецОбласти

#Область Форматы

// Дата и время ISO 8601 с часовым поясом: "2026-10-15T14:30:00+05:00". Пустая дата — Неопределено.
Функция ДатаВремя(Значение, Смещение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Дата") ИЛИ Значение = Дата(1, 1, 1) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат XMLСтрока(Значение) + Смещение;

КонецФункции

// Дата без времени: "2026-10-15". Пустая дата — Неопределено.
Функция ДатаБезВремени(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Дата") ИЛИ Значение = Дата(1, 1, 1) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Лев(XMLСтрока(Значение), 10);

КонецФункции

// Месяц "2026-10".
Функция ГодМесяц(Значение) Экспорт
	Возврат Лев(XMLСтрока(Значение), 7);
КонецФункции

// Число, округлённое до Разрядов знаков (суммы — 2, количество — 3, курс — 4). Не число — Неопределено.
Функция Округлить(Значение, Разрядов) Экспорт

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Окр(Значение, Разрядов);

КонецФункции

// Число строкой без разделителей групп, ноль — "0".
Функция ЧислоСтрокой(Значение) Экспорт
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

#КонецОбласти

#Область Ответы

// HTTP-ответ с телом JSON в UTF-8 без BOM.
Функция HTTPОтвет(КодСостояния, ТекстJSON, ПовторитьЧерез = 0) Экспорт

	Результат = Новый HTTPСервисОтвет(КодСостояния);
	Результат.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Результат.Заголовки.Вставить("Cache-Control", "no-store");
	Если ПовторитьЧерез > 0 Тогда
		Результат.Заголовки.Вставить("Retry-After", ЧислоСтрокой(ПовторитьЧерез));
	КонецЕсли;
	Результат.УстановитьТелоИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, КодировкаТекста.UTF8, Ложь));
	Возврат Результат;

КонецФункции

// Ответ-ошибка в формате спецификации (раздел 3.4): { "error": { "code", "message", "field" } }.
// Сообщение не должно содержать паролей, секрета и персональных данных — сюда передаются только тексты этого расширения.
Функция ОтветОшибки(КодСостояния, Код, Сообщение, Поле = "", ПовторитьЧерез = 0) Экспорт

	Запись = НоваяЗапись();
	Запись.ЗаписатьНачалоОбъекта();
	НачатьОбъект(Запись, "error");
	Свойство(Запись, "code", Код);
	Свойство(Запись, "message", Сообщение);
	Если ЗначениеЗаполнено(Поле) Тогда
		Свойство(Запись, "field", Поле);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецОбъекта();
	Возврат HTTPОтвет(КодСостояния, ЗакрытьЗапись(Запись), ПовторитьЧерез);

КонецФункции

// Прерывает выполнение метода с ошибкой API: обработчик HTTP-сервиса превратит её в ответ КодСостояния.
// Пример: ВызватьОшибкуAPI(400, "invalid_parameter", "Параметр from: дата должна быть в формате ГГГГ-ММ-ДД", "from").
Процедура ВызватьОшибкуAPI(КодСостояния, Код, Сообщение, Поле = "") Экспорт
	ВызватьИсключение МаркерОшибки() + ЧислоСтрокой(КодСостояния) + "|" + Код + "|" + Поле + "]" + Сообщение;
КонецПроцедуры

// Ответ по исключению: ошибка API — её код и текст; блокировка/регламент — 503; нет прав — 403;
// остальное — 500 без текста исключения (в нём могут быть данные), с кодом для поиска в журнале регистрации.
Функция ОтветПоИсключению(Информация, Метод) Экспорт

	ОшибкаAPI = ОшибкаAPIИзИсключения(Информация);
	Если ОшибкаAPI <> Неопределено Тогда
		ПовторитьЧерез = ?(ОшибкаAPI.КодСостояния = 503, OneBase_Settings.ПовторитьЧерезСекунд(), 0);
		Возврат ОтветОшибки(ОшибкаAPI.КодСостояния, ОшибкаAPI.Код, ОшибкаAPI.Сообщение, ОшибкаAPI.Поле, ПовторитьЧерез);
	КонецЕсли;

	ТекстОшибки = НРег(ПолныйТекстОшибки(Информация));
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	ЗаписатьОшибкуВЖурнал(Идентификатор, Метод, Информация);

	Если ЭтоОшибкаБлокировки(ТекстОшибки) Тогда
		Возврат ОтветОшибки(503, "unavailable",
			"База 1С заблокирована или идёт регламентная операция. Повторите позже. Код: " + Идентификатор,
			, OneBase_Settings.ПовторитьЧерезСекунд());
	ИначеЕсли ЭтоОшибкаПрав(ТекстОшибки) Тогда
		Возврат ОтветОшибки(403, "forbidden",
			"У пользователя 1С нет прав на чтение данных метода /" + Метод + ". Код для журнала регистрации: " + Идентификатор);
	КонецЕсли;

	Возврат ОтветОшибки(500, "internal_error",
		"Внутренняя ошибка 1С при выполнении /" + Метод
		+ ". Подробности — в журнале регистрации 1С (событие OneBase.Ошибка), код " + Идентификатор);

КонецФункции

#КонецОбласти

#Область Курсоры

// Курсор страницы: JSON {x: метод, ...ключ} в Base64 без «+», «/» и «=» (безопасно для адреса).
Функция КурсорВСтроку(Метод, Данные) Экспорт

	Данные.Вставить("x", Метод);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Base64UrlИзСтроки(Запись.Закрыть());

КонецФункции

// Разбирает курсор. Неверный или чужой (от другого метода) курсор — ошибка 400 по полю cursor.
Функция КурсорИзСтроки(Метод, СтрокаКурсора) Экспорт

	ТекстКурсора = СтрокаИзBase64Url(СтрокаКурсора);
	Данные = Неопределено;
	Если ЗначениеЗаполнено(ТекстКурсора) Тогда
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ТекстКурсора);
			Данные = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
		Исключение
			Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если ТипЗнч(Данные) <> Тип("Структура") ИЛИ НЕ Данные.Свойство("x") ИЛИ Данные.x <> Метод Тогда
		ВызватьОшибкуAPI(400, "invalid_parameter",
			"Параметр cursor: курсор не распознан или выдан другим методом. Начните листание без cursor.", "cursor");
	КонецЕсли;
	Возврат Данные;

КонецФункции

#КонецОбласти

#Область Секрет

// SHA-256 строки в UTF-8 (без BOM), шестнадцатеричный, в нижнем регистре.
// Совпадает с `printf %s "$SECRET" | shasum -a 256`.
Функция ХешSHA256(Исходная) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Исходная, КодировкаТекста.UTF8, Ложь));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Сравнение строк без раннего выхода: время не зависит от того, где первое различие.
Функция СтрокиСовпадают(Первая, Вторая) Экспорт

	ДлинаПервой = СтрДлина(Первая);
	ДлинаВторой = СтрДлина(Вторая);
	Различий = ?(ДлинаПервой = ДлинаВторой, 0, 1);
	Для Позиция = 1 По Макс(ДлинаПервой, ДлинаВторой) Цикл
		Если Сред(Первая, Позиция, 1) <> Сред(Вторая, Позиция, 1) Тогда
			Различий = Различий + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Различий = 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МаркерОшибки()
	Возврат "[OneBase|";
КонецФункции

// Ошибка API из исключения (по маркеру в тексте) или Неопределено. Ищет по всей цепочке причин.
Функция ОшибкаAPIИзИсключения(Информация)

	Текущая = Информация;
	Пока Текущая <> Неопределено Цикл
		Описание = Текущая.Описание;
		Позиция = СтрНайти(Описание, МаркерОшибки());
		Если Позиция > 0 Тогда
			Остаток = Сред(Описание, Позиция + СтрДлина(МаркерОшибки()));
			Конец = СтрНайти(Остаток, "]");
			Если Конец > 0 Тогда
				Части = СтрРазделить(Лев(Остаток, Конец - 1), "|", Истина);
				Если Части.Количество() = 3 Тогда
					Результат = Новый Структура;
					Результат.Вставить("КодСостояния", Число(Части[0]));
					Результат.Вставить("Код", Части[1]);
					Результат.Вставить("Поле", Части[2]);
					Результат.Вставить("Сообщение", СокрЛП(Сред(Остаток, Конец + 1)));
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Текущая = Текущая.Причина;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ПолныйТекстОшибки(Информация)

	Части = Новый Массив;
	Текущая = Информация;
	Пока Текущая <> Неопределено Цикл
		Части.Добавить(Текущая.Описание);
		Текущая = Текущая.Причина;
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");

КонецФункции

// Конфликт блокировок, монопольный режим, блокировка базы — повторить позже (503).
Функция ЭтоОшибкаБлокировки(ТекстОшибки)

	Признаки = СтрРазделить("блокиров,монопольн,lock conflict,deadlock,locked,exclusive mode", ",", Ложь);
	Для Каждого Признак Из Признаки Цикл
		Если СтрНайти(ТекстОшибки, Признак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Нарушение прав доступа — у пользователя нет права «Чтение» на объект (403).
Функция ЭтоОшибкаПрав(ТекстОшибки)

	Признаки = СтрРазделить("нарушение прав доступа,недостаточно прав,access right violation", ",", Ложь);
	Для Каждого Признак Из Признаки Цикл
		Если СтрНайти(ТекстОшибки, Признак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Подробности внутренней ошибки — только в журнал регистрации (доступен администраторам 1С), не в ответ.
Процедура ЗаписатьОшибкуВЖурнал(Идентификатор, Метод, Информация)

	Если НЕ OneBase_Settings.ЗаписыватьОшибкиВЖурналРегистрации() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ЗаписьЖурналаРегистрации("OneBase.Ошибка", УровеньЖурналаРегистрации.Ошибка, , ,
			"Код " + Идентификатор + ", метод /" + Метод + ": " + ПодробноеПредставлениеОшибки(Информация));
	Исключение
		// Журнал недоступен — ответ всё равно уходит.
	КонецПопытки;

КонецПроцедуры

// Base64 без переносов строк, с заменой «+» → «-», «/» → «_» и без «=» в конце.
Функция Base64UrlИзСтроки(Исходная)

	Результат = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Исходная, КодировкаТекста.UTF8, Ложь));
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, "+", "-");
	Результат = СтрЗаменить(Результат, "/", "_");
	Результат = СтрЗаменить(Результат, "=", "");
	Возврат Результат;

КонецФункции

// Обратное преобразование; неверная строка — Неопределено.
Функция СтрокаИзBase64Url(Исходная)

	Если ТипЗнч(Исходная) <> Тип("Строка") ИЛИ Исходная = "" ИЛИ СтрДлина(Исходная) > 4000 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Строка64 = СтрЗаменить(СтрЗаменить(СокрЛП(Исходная), "-", "+"), "_", "/");
	Пока СтрДлина(Строка64) % 4 <> 0 Цикл
		Строка64 = Строка64 + "=";
	КонецЦикла;
	Попытка
		Данные = Base64Значение(Строка64);
		Если Данные = Неопределено ИЛИ Данные.Размер() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
