#Область Справочники

// Справочники методов /organizations, /counterparties, /contracts, /currencies, /warehouses, /departments, /items.
// Ключ — имя метода; значение — описание: кандидаты справочника, поля OneBase ← кандидаты реквизитов.
// Виды полей: Ид (ссылка → UUID), Строка (строка или представление ссылки), Сумма/Количество/Курс (числа с 2/3/4
// знаками), Целое, Булево, Дата, ДатаВремя, Валюта (ссылка на валюту → буквенный код), КодСчета, Ставка (ставка НДС
// → число), Классификатор (представление → код OneBase по ключевым словам).
// Поля, имя которых начинается с «_», в ответ не пишутся — они нужны для вычисления других полей.
Функция СправочникиМетодов() Экспорт

	Результат = Новый Соответствие;

	// GET /organizations — спецификация 4.2. accountingCurrency — валюта регламентированного учёта базы.
	Поля = Новый Массив;
	Поля.Добавить(Поле("code", "Код", "Строка", , Истина));
	Поля.Добавить(Поле("name", "Наименование", "Строка", , Истина));
	Поля.Добавить(Поле("fullName", "НаименованиеПолное", "Строка"));                                       // проверить
	Поля.Добавить(Поле("inn", "ИНН", "Строка"));                                                            // проверить
	Поля.Добавить(Поле("vatCode", "РегистрационныйКодПлательщикаНДС,КодПлательщикаНДС", "Строка"));       // проверить
	Поля.Добавить(Поле("isActive", "", "Булево"));  // кандидатов нет: впишите реквизит-признак, если он есть
	Результат.Вставить("organizations", Сущность("Организации", Поля, Ложь));                              // проверить

	// GET /counterparties — спецификация 4.4. kind: реквизит «вид контрагента» (если указан) или признаки
	// _customer/_supplier; pinfl — только при ВыгружатьПИНФЛ() = Истина.
	Поля = Новый Массив;
	Поля.Добавить(Поле("code", "Код", "Строка", , Истина));
	Поля.Добавить(Поле("name", "Наименование", "Строка", , Истина));
	Поля.Добавить(Поле("fullName", "НаименованиеПолное", "Строка"));                                       // проверить
	Поля.Добавить(Поле("inn", "ИНН", "Строка"));                                                            // проверить
	Поля.Добавить(Поле("pinfl", "ПИНФЛ", "Строка"));                                                        // проверить
	Поля.Добавить(Поле("kind", "", "Классификатор",
		Классификатор("покупатель и поставщик=both; поставщик и покупатель=both; покупател=customer; "
			+ "поставщик=supplier", "other")));
	Поля.Добавить(Поле("_customer", "Покупатель", "Булево"));                                               // проверить
	Поля.Добавить(Поле("_supplier", "Поставщик", "Булево"));                                                // проверить
	Поля.Добавить(Поле("legalForm", "ЮрФизЛицо,ЮридическоеФизическоеЛицо", "Классификатор",                // проверить
		Классификатор("предпринимател=entrepreneur; физ=individual; юр=legal", "")));
	Поля.Добавить(Поле("address", "ЮридическийАдрес,Адрес", "Строка"));                                    // проверить
	Поля.Добавить(Поле("phone", "Телефон", "Строка"));                                                      // проверить
	Результат.Вставить("counterparties", Сущность("Контрагенты", Поля, Истина));                           // проверить

	// GET /contracts — спецификация 4.5. counterpartyId — владелец справочника или реквизит «Контрагент».
	Поля = Новый Массив;
	Поля.Добавить(Поле("code", "Код", "Строка", , Истина));
	Поля.Добавить(Поле("name", "Наименование", "Строка", , Истина));
	Поля.Добавить(Поле("counterpartyId", "Владелец,Контрагент", "Ид"));                                    // проверить
	Поля.Добавить(Поле("organizationId", "Организация", "Ид"));                                             // проверить
	Поля.Добавить(Поле("number", "НомерДоговора,Номер", "Строка"));                                        // проверить
	Поля.Добавить(Поле("date", "ДатаДоговора,Дата", "Дата"));                                              // проверить
	Поля.Добавить(Поле("kind", "ВидДоговора", "Классификатор",                                              // проверить
		Классификатор("покупател=with_customer; поставщик=with_supplier", "other")));
	Поля.Добавить(Поле("currency", "ВалютаВзаиморасчетов,Валюта", "Валюта"));                               // проверить
	Поля.Добавить(Поле("paymentTermDays", "СрокОплаты,ОтсрочкаПлатежа,КоличествоДнейОтсрочки", "Целое"));  // проверить
	Поля.Добавить(Поле("validTo", "СрокДействия,ДатаОкончания", "Дата"));                                  // проверить
	Результат.Вставить("contracts", Сущность("ДоговорыКонтрагентов,Договоры", Поля, Ложь));                 // проверить

	// GET /currencies — спецификация 4.6. В типовых справочниках валют буквенный код (UZS, USD) хранится
	// в наименовании, а цифровой (860, 840) — в коде. Проверить по данным: GET /v1/currencies.
	Поля = Новый Массив;
	Поля.Добавить(Поле("code", "Наименование", "Строка", , Истина));                                       // проверить
	Поля.Добавить(Поле("numericCode", "Код", "Строка"));                                                    // проверить
	Поля.Добавить(Поле("name", "НаименованиеПолное,Наименование", "Строка", , Истина));                    // проверить
	Результат.Вставить("currencies", Сущность("Валюты", Поля, Ложь));                                       // проверить

	// GET /warehouses — спецификация 4.7.
	Поля = Новый Массив;
	Поля.Добавить(Поле("code", "Код", "Строка", , Истина));
	Поля.Добавить(Поле("name", "Наименование", "Строка", , Истина));
	Поля.Добавить(Поле("organizationId", "Организация", "Ид"));                                             // проверить
	Поля.Добавить(Поле("kind", "ТипСклада,ВидСклада", "Классификатор",                                      // проверить
		Классификатор("оптов=wholesale; розни=retail; производ=production", "other")));
	Результат.Вставить("warehouses", Сущность("Склады,МестаХранения", Поля, Истина));                       // проверить

	// GET /departments — спецификация 4.7.
	Поля = Новый Массив;
	Поля.Добавить(Поле("code", "Код", "Строка", , Истина));
	Поля.Добавить(Поле("name", "Наименование", "Строка", , Истина));
	Поля.Добавить(Поле("organizationId", "Владелец,Организация", "Ид"));                                    // проверить
	Результат.Вставить("departments", Сущность("ПодразделенияОрганизаций,Подразделения", Поля, Истина));    // проверить

	// GET /items — спецификация 4.8. kind: «услуга» по признаку _service, иначе по виду номенклатуры.
	Поля = Новый Массив;
	Поля.Добавить(Поле("code", "Код", "Строка", , Истина));
	Поля.Добавить(Поле("name", "Наименование", "Строка", , Истина));
	Поля.Добавить(Поле("fullName", "НаименованиеПолное", "Строка"));                                       // проверить
	Поля.Добавить(Поле("article", "Артикул", "Строка"));                                                    // проверить
	Поля.Добавить(Поле("kind", "ВидНоменклатуры,ТипНоменклатуры", "Классификатор",                          // проверить
		Классификатор("полуфабрикат=semi_finished; продукц=product; материал=material; сырь=material; "
			+ "услуг=service; товар=goods", "other")));
	Поля.Добавить(Поле("_service", "Услуга", "Булево"));                                                    // проверить
	Поля.Добавить(Поле("unit", "ЕдиницаИзмерения,БазоваяЕдиницаИзмерения,ЕдиницаХраненияОстатков", "Строка")); // проверить
	Поля.Добавить(Поле("vatRate", "СтавкаНДС", "Ставка"));                                                  // проверить
	Поля.Добавить(Поле("ikpu", "ИКПУ,КодИКПУ", "Строка"));                                                  // проверить
	Поля.Добавить(Поле("barcode", "Штрихкод,ШтрихКод", "Строка"));                                         // проверить
	Результат.Вставить("items", Сущность("Номенклатура", Поля, Истина));                                    // проверить

	Возврат Результат;

КонецФункции

// GET /references?kind=<вид> — прочие справочники из субконто (спецификация 4.7).
// Реквизиты: "*" — все реквизиты справочника простых и ссылочных типов попадают в attributes (значения — строки);
// "" — attributes не выгружается; список через запятую — только эти реквизиты.
// Вид в адресе можно писать и через дефис: cash-flow-items = cash_flow_items.
Функция ПрочиеСправочники() Экспорт

	Результат = Новый Соответствие;
	Результат.Вставить("cash_flow_items", ПрочийСправочник("СтатьиДвиженияДенежныхСредств", "*"));   // проверить по /metadata
	Результат.Вставить("cost_items", ПрочийСправочник("СтатьиЗатрат", "*"));                           // проверить по /metadata
	Результат.Вставить("bank_accounts", ПрочийСправочник("БанковскиеСчета", "*"));                     // проверить по /metadata
	Результат.Вставить("cash_desks", ПрочийСправочник("Кассы", "*"));                                   // проверить по /metadata
	Результат.Вставить("batches", ПрочийСправочник("Партии,ПартииНоменклатуры", "*"));                  // проверить по /metadata
	Результат.Вставить("fixed_assets", ПрочийСправочник("ОсновныеСредства", "*"));                     // проверить по /metadata
	Результат.Вставить("other_income_expense", ПрочийСправочник("ПрочиеДоходыИРасходы", "*"));         // проверить по /metadata
	Возврат Результат;

КонецФункции

