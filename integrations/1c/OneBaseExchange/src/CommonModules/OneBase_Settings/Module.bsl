#Область Бухгалтерия

// Регистр бухгалтерии и его поля. План счетов и виды субконто берутся из свойств регистра.
// Каждое имя проверяется по метаданным: нет измерения/ресурса — соответствующее поле не выгружается.
Функция РегистрБухгалтерии() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Регистр", "Хозрасчетный");                                     // проверить по /metadata
	Настройки.Вставить("Организация", "Организация");                                  // измерение; проверить по /metadata
	Настройки.Вставить("Валюта", "Валюта");                                            // измерение; проверить по /metadata
	Настройки.Вставить("Подразделение", "Подразделение,ПодразделениеОрганизации");    // измерение; проверить по /metadata
	Настройки.Вставить("Сумма", "Сумма");                                              // ресурс; проверить по /metadata
	Настройки.Вставить("ВалютнаяСумма", "ВалютнаяСумма");                              // ресурс; проверить по /metadata
	Настройки.Вставить("Количество", "Количество");                                    // ресурс; проверить по /metadata
	Настройки.Вставить("Содержание", "Содержание");                                    // реквизит; проверить по /metadata
	Настройки.Вставить("ПризнакВалютный", "Валютный");                                 // признак учёта плана счетов; проверить
	Настройки.Вставить("ПризнакКоличественный", "Количественный");                     // признак учёта плана счетов; проверить
	Возврат Настройки;

КонецФункции

// Истина — /entries отдаёт пустой набор (entries: []) для непроведённых документов периода (спецификация, 4.10:
// «если проведение отменено — набор приходит пустым»). Ложь — только документы с проводками.
Функция ПустыеНаборыНепроведенных() Экспорт
	Возврат Истина;
КонецФункции

#КонецОбласти

#Область КурсыВалют

// Регистр сведений курсов валют (периодический). Источник — необязательное поле (ресурс или реквизит).
Функция КурсыВалют() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Регистр", "КурсыВалют");          // проверить по /metadata
	Настройки.Вставить("Валюта", "Валюта");               // измерение; проверить по /metadata
	Настройки.Вставить("Курс", "Курс");                   // ресурс; проверить по /metadata
	Настройки.Вставить("Кратность", "Кратность");         // ресурс; проверить по /metadata (нет ресурса — multiplier = 1)
	Настройки.Вставить("Источник", "");                   // ресурс или реквизит со способом установки курса, если есть
	Возврат Настройки;

КонецФункции

