КонецФункции

// Правила классификатора из строки «слово=код; слово=код». Значение относится к первому коду, чьё слово входит
// в представление значения (без учёта регистра). Не подошло ни одно — ПоУмолчанию (пусто — поле не пишется).
Функция Классификатор(Правила, ПоУмолчанию)

	Список = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Правила, ";", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Слово = НРег(СокрЛП(Лев(Часть, Позиция - 1)));
		Код = СокрЛП(Сред(Часть, Позиция + 1));
		Если Слово <> "" И Код <> "" Тогда
			Список.Добавить(Новый Структура("Слово, Код", Слово, Код));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Правила, ПоУмолчанию", Список, ПоУмолчанию);

КонецФункции

#КонецОбласти
