// =====================================================================================================================
// Модуль HTTP-сервиса OneBase_API расширения OneBaseExchange.
//
// Корневой URL: onebase. Шаблон URL «Все» = /* ; метод «Получить» (HTTP-метод GET), обработчик — ВсеПолучить.
// Полный адрес метода: https://<сервер>/<публикация>/hs/onebase/v1/<метод>, например .../hs/onebase/v1/ping.
//
// Модуль тонкий: проверка секрета API → роль → режим обслуживания → имя метода → OneBase_Export.ВыполнитьМетод → JSON.
// Сервис ТОЛЬКО ЧИТАЕТ данные (README, раздел «Гарантии только чтения»).
//
// Авторизация двухступенчатая:
//   1) HTTP Basic пользователя информационной базы (OneBase_ReadOnly) — проверяет сама платформа до вызова модуля;
//   2) секрет API — заголовок X-OneBase-Secret: <секрет> (или Authorization: Bearer <секрет>, если Basic не используется);
//      сравнивается SHA-256 секрета с OneBase_Settings.ХешСекретаSHA256(). Секрет нигде не хранится и не выводится.
// =====================================================================================================================

#Область ОбработчикиСобытий

// Обработчик метода «Получить» (GET) шаблона «Все» (/*).
Функция ВсеПолучить(Запрос)

	Метод = "";
	Попытка

		Отказ = ПроверитьСекрет(Запрос);
		Если Отказ <> Неопределено Тогда
			Возврат Отказ;
		КонецЕсли;

		Если НЕ РольДоступнаБезопасно(OneBase_Settings.ИмяРолиДоступа()) Тогда
			Возврат OneBase_Json.ОтветОшибки(403, "forbidden",
				"У пользователя 1С нет роли " + OneBase_Settings.ИмяРолиДоступа() + " (расширение OneBaseExchange).");
		КонецЕсли;

		Если OneBase_Settings.РежимОбслуживания() Тогда
			Возврат OneBase_Json.ОтветОшибки(503, "unavailable",
				"Сервис OneBase в 1С временно выключен (режим обслуживания). Повторите позже.", ,
				OneBase_Settings.ПовторитьЧерезСекунд());
		КонецЕсли;

		Метод = ИмяМетода(Запрос);
		Если Метод = "" Тогда
			Возврат OneBase_Json.ОтветОшибки(404, "not_found",
				"Адрес должен иметь вид /hs/onebase/v1/<метод>, например /hs/onebase/v1/ping.");
		КонецЕсли;

		Возврат OneBase_Export.ВыполнитьМетод(Метод, Запрос.ПараметрыЗапроса);

	Исключение
		// Текст исключения в ответ не попадает (в нём могут быть данные) — только код для журнала регистрации.
		Возврат OneBase_Json.ОтветПоИсключению(ИнформацияОбОшибке(), Метод);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя метода из адреса: "/v1/ping" → "ping". Неверный адрес — "".
Функция ИмяМетода(Запрос)

	Путь = Запрос.ОтносительныйURL;
	Позиция = СтрНайти(Путь, "?");
	Если Позиция > 0 Тогда
		Путь = Лев(Путь, Позиция - 1);
	КонецЕсли;
	Части = СтрРазделить(Путь, "/", Ложь);
	Если Части.Количество() <> 2 ИЛИ НРег(Части[0]) <> "v1" Тогда
		Возврат "";
	КонецЕсли;
	Возврат НРег(СокрЛП(Части[1]));

КонецФункции

// Неопределено — секрет верный; иначе ответ 401. Секрет и его хеш в ответ и журнал не попадают.
Функция ПроверитьСекрет(Запрос)

	ОжидаемыйХеш = НРег(СокрЛП(OneBase_Settings.ХешСекретаSHA256()));
	Если СтрДлина(ОжидаемыйХеш) <> 64 Тогда
		Возврат OneBase_Json.ОтветОшибки(401, "unauthorized",
			"Секрет API не настроен в 1С (OneBase_Settings.ХешСекретаSHA256). Обратитесь к администратору 1С.");
	КонецЕсли;

	Секрет = СекретИзЗаголовков(Запрос.Заголовки);
	Если Секрет = "" Тогда
		Возврат OneBase_Json.ОтветОшибки(401, "unauthorized",
			"Нет секрета API: передайте заголовок X-OneBase-Secret (или Authorization: Bearer).");
	КонецЕсли;
	Если СтрДлина(Секрет) > 512 ИЛИ НЕ OneBase_Json.СтрокиСовпадают(OneBase_Json.ХешSHA256(Секрет), ОжидаемыйХеш) Тогда
		Возврат OneBase_Json.ОтветОшибки(401, "unauthorized", "Неверный секрет API.");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Секрет из X-OneBase-Secret, иначе из Authorization: Bearer. Имена заголовков — без учёта регистра.
Функция СекретИзЗаголовков(Заголовки)

	Секрет = "";
	Носитель = "";
	Для Каждого Заголовок Из Заголовки Цикл
		Имя = НРег(СокрЛП(Заголовок.Ключ));
		Если Имя = "x-onebase-secret" Тогда
			Секрет = СокрЛП(Заголовок.Значение);
		ИначеЕсли Имя = "authorization" Тогда
			Значение = СокрЛП(Заголовок.Значение);
			Если НРег(Лев(Значение, 7)) = "bearer " Тогда
				Носитель = СокрЛП(Сред(Значение, 8));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Секрет <> "", Секрет, Носитель);

КонецФункции

Функция РольДоступнаБезопасно(ИмяРоли)

	Попытка
		Возврат РольДоступна(ИмяРоли);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти
