# Скопируйте в .env и замените значения. .env не коммитится.

# PostgreSQL
POSTGRES_DB=onebase
POSTGRES_USER=onebase
POSTGRES_PASSWORD=change_me

# Redis
REDIS_PASSWORD=change_me

# MinIO
MINIO_ROOT_USER=onebase
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=onebase-files

# JWT (ключ подписи — минимум 32 символа)
JWT_ISSUER=onebase
JWT_AUDIENCE=onebase
JWT_SIGNING_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Первый администратор (создаётся при старте, если его ещё нет)
SEED_ADMIN_EMAIL=admin@onebase.local
SEED_ADMIN_PASSWORD=change_me_admin

# AI. Ключи и модели обычно задаются в интерфейсе: «Настройки → AI» (ключ хранится зашифрованным).
# Переменные ниже — запасной вариант, пока в OneBase ничего не сохранено.
# LLM_PROVIDER: openai | anthropic; LLM_API_KEY — ключ этого провайдера; LLM_MODEL — идентификатор модели у провайдера.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Модель эмбеддингов для семантического поиска по базе знаний (только OpenAI).
EMBEDDING_MODEL=
# Ключи каждого провайдера отдельно (если нужны оба — основной и резервный).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Linko SFA (источник данных раздела «Продажи»). Токен выдаёт техподдержка Linko.
# Для разработки — демо-сервер https://sfademo.linko.uz (демо-токен есть в документации Linko).
LINKO_BASE_URL=https://sfademo.linko.uz
LINKO_TOKEN=
# Токен API планов (staff_balance) — отдельный от External API. Обычно задаётся в интерфейсе.
LINKO_PLAN_TOKEN=

# Cloudflare Tunnel (профиль "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=
