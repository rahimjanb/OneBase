# Скопируйте в .env и замените значения. .env не коммитится.

# PostgreSQL
POSTGRES_DB=onebase
POSTGRES_USER=onebase
POSTGRES_PASSWORD=change_me

# Redis
REDIS_PASSWORD=change_me

# MinIO
MINIO_ROOT_USER=onebase
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=onebase-files

# JWT (ключ подписи — минимум 32 символа)
JWT_ISSUER=onebase
JWT_AUDIENCE=onebase
JWT_SIGNING_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Первый администратор (создаётся при старте, если его ещё нет)
SEED_ADMIN_EMAIL=admin@onebase.local
SEED_ADMIN_PASSWORD=change_me_admin

# AI. Ключи и модели обычно задаются в интерфейсе: «Настройки → AI» (ключ хранится зашифрованным).
# Переменные ниже — запасной вариант, пока в OneBase ничего не сохранено.
# LLM_PROVIDER: openai | anthropic; LLM_API_KEY — ключ этого провайдера; LLM_MODEL — идентификатор модели у провайдера.
# Оба пусто — основная модель Claude (anthropic/claude-opus-5-5), нужен ключ Anthropic.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Модель эмбеддингов для семантического поиска по базе знаний (только OpenAI).
EMBEDDING_MODEL=
# Ключи каждого провайдера отдельно (если нужны оба — основной и резервный).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI Data Manager («Настройки → AI Data Manager»): работает только с Claude через официальный SDK Anthropic.
# Ключ — тот же ключ Anthropic: «Настройки → AI → Провайдеры» или ANTHROPIC_API_KEY выше; браузер его не получает.
# Модель Claude; пусто — claude-opus-5-5.
DATA_MANAGER_MODEL=

# Linko SFA (источник данных раздела «Продажи»). Токен выдаёт техподдержка Linko.
# Для разработки — демо-сервер https://sfademo.linko.uz (демо-токен есть в документации Linko).
LINKO_BASE_URL=https://sfademo.linko.uz
LINKO_TOKEN=
# Токен API планов (staff_balance) — отдельный от External API. Обычно задаётся в интерфейсе.
LINKO_PLAN_TOKEN=

# --- 1С:Бухгалтерия → OneBase (служба onec-worker, профиль «onec»; включается: COMPOSE_PROFILES=onec или docker compose --profile onec up -d onec-worker) ---
# Ключ службы: создаётся в «Настройки → Интеграции → Финансы → 1С» и показывается один раз.
ONEC_INTEGRATION_TOKEN=
# false — служба на связи и проверяет подключение, но данные не загружает. Включайте после проверки подключения.
ONEC_ENABLED=false
# http — настоящая 1С (API VENKON GROUP), mock — тестовый источник с демо-данными (в production только с ONEC_ALLOW_MOCK=true — не для рабочей базы).
ONEC_PROVIDER=http
# Адрес HTTP-сервиса 1С — сообщает VENKON GROUP после публикации (пример: https://192.168.9.141/buh/hs/onebase/v1). Только https.
ONEC_BASE_URL=
# Пользователь 1С только для чтения (или ONEC_TOKEN, если VENKON выберет токен).
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_TOKEN=
ONEC_TIMEOUT_SECONDS=60
# Сертификат внутреннего ЦС или самоподписанный сертификат 1С: положить файл в deploy/onec/ и указать путь в контейнере.
ONEC_CA_CERT_PATH=
ONEC_INTERVAL_MINUTES=30
ONEC_BATCH_SIZE=500

# Домен Sales Base (полевые продажи). В Cloudflare Tunnel: этот домен → http://nginx:81. По умолчанию sales.1base.uz.
# Один домен, без https:// и запятых.
# FIELD_HOST=sales.1base.uz

# Cloudflare Tunnel (профиль "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=
